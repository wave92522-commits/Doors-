-- Item notifications: tells you when a selected item appears near you
SeenItems = setmetatable({}, { __mode = "k" })
Loop(1, function()
    if not S.NotifyItems or not next(S.ItemNotifyList) then return end
    local r = Rooms()
    if not r then return end
    local _, n = CurrentRoom()
    for i = n, n + 1 do
        local room = r:FindFirstChild(tostring(i))
        if room then
            for _, d in ipairs(room:GetDescendants()) do
                if d:IsA("Model") and not SeenItems[d] then
                    local label = ITEM_LABEL[d.Name]
                    if label and S.ItemNotifyList[label] then
                        SeenItems[d] = true
                        local text = string.format(T("%s found in room %d"), label, i)
                        if S.NotifyItemDistance then
                            local hrp, p = HRP(), PartPos(d)
                            if hrp and p then text = text .. string.format(" (%dm)", math.floor((p - hrp.Position).Magnitude)) end
                        end
                        Notify(HUB_NAME, text, 5)
                    end
                end
            end
        end
    end
end)

-- Bypass Alma: Alma is removed as soon as it appears (Workspace.Alma)
Loop(1, function()
    if not S.AntiAlma then return end
    local alma = Workspace:FindFirstChild("Alma")
    if alma then pcall(function() alma:Destroy() end) end
end)

-- Bypass Electric Water (Archives) -------------------------------------------
-- A thin solid, untouchable platform is placed on top of each room's "Water",
-- so you walk over it instead of touching it. Tall water is skipped (softlock).
WaterPlatforms = setmetatable({}, { __mode = "k" }) -- water -> platform
function ClearWaterPlatforms()
    for water, plat in pairs(WaterPlatforms) do
        pcall(function() plat:Destroy() end)
        WaterPlatforms[water] = nil
    end
end
Loop(1, function()
    if not S.BypassWater then
        if next(WaterPlatforms) then ClearWaterPlatforms() end
        return
    end
    local r = Rooms()
    if not r then return end
    local _, n = CurrentRoom()
    for i = math.max(0, n - 4), n + 1 do
        local room = r:FindFirstChild(tostring(i))
        local water = room and room:FindFirstChild("Water")
        if water and not WaterPlatforms[water] then
            local cf, size
            if water:IsA("BasePart") then
                cf, size = water.CFrame, water.Size
            elseif water:IsA("Model") then
                cf, size = water:GetBoundingBox()
            end
            if cf and size and size.Y + 0.5 <= 3 then
                local plat = Instance.new("Part")
                plat.Name = "Sm1lerHub_WaterBypass"
                plat.Anchored = true
                plat.CanCollide = true
                plat.CanTouch = false
                plat.CanQuery = false
                plat.Material = Enum.Material.ForceField
                plat.Color = Color3.fromRGB(0, 150, 255)
                plat.Transparency = 0.25
                plat.Size = size + Vector3.new(0, 0.5, 0)
                plat.CFrame = cf * CFrame.new(0, 0.25, 0)
                plat.Parent = room
                WaterPlatforms[water] = plat
            else
                WaterPlatforms[water] = Instance.new("Folder") -- mark as skipped
            end
        end
    end
end)

-- Bypass Drones (Archives): their "WalkedInto" trigger is parked outside the
-- model while this is on, and put back when it is turned off
ParkedDroneTriggers = {} -- trigger -> original parent
function RestoreDroneTriggers()
    for trig, parent in pairs(ParkedDroneTriggers) do
        if trig.Parent and parent.Parent then pcall(function() trig.Parent = parent end) end
        ParkedDroneTriggers[trig] = nil
    end
end
Loop(0.5, function()
    if not S.BypassDronesArchive then
        if next(ParkedDroneTriggers) then RestoreDroneTriggers() end
        return
    end
    for _, c in ipairs(Workspace:GetChildren()) do
        if c.Name == "Drones" then
            local trig = c:FindFirstChild("WalkedInto")
            if trig then
                ParkedDroneTriggers[trig] = c
                trig.Parent = ReplicatedStorage
            end
        end
    end
end)

-- Bring dropped items -----------------------------------------------------
function BringDrops()
    local drops, hrp = Workspace:FindFirstChild("Drops"), HRP()
    if not drops or not hrp then
        Notify(HUB_NAME, T("No dropped items."), 3)
        return
    end
    local count = 0
    for _, item in ipairs(drops:GetChildren()) do
        pcall(function()
            if item:IsA("Model") then item:PivotTo(hrp.CFrame)
            elseif item:IsA("BasePart") then item.CFrame = hrp.CFrame end
            count += 1
        end)
    end
    Notify(HUB_NAME, string.format(T("Brought %d items."), count), 3)
end

-- Anti Noise: move the character by setting its position every frame
-- instead of walking, so there are no footsteps for Noise / Figure to hear
NoiseConn = nil
function ApplyAntiNoise()
    if NoiseConn then NoiseConn:Disconnect(); NoiseConn = nil end
    local h = Hum()
    if h then h.AutoRotate = true end
    if not S.AntiNoise then return end
    NoiseConn = RunService.PreSimulation:Connect(function(dt)
        if not HubAlive or not S.AntiNoise or S.Fly then return end
        local hum, root, cam = Hum(), HRP(), Workspace.CurrentCamera
        if not hum or not root or not cam or hum.Health <= 0 or root.Anchored then return end
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.Swimming
            or st == Enum.HumanoidStateType.Dead or st == Enum.HumanoidStateType.Ragdoll then
            return
        end
        local move = hum.MoveDirection
        hum.AutoRotate = false
        hum:Move(Vector3.zero, false)
        if move.Magnitude < 0.01 then
            root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
            return
        end
        local dir = Vector3.new(move.X, 0, move.Z).Unit
        local step = hum.WalkSpeed * math.clamp(move.Magnitude, 0, 1) * math.clamp(dt, 0, 1 / 30)
        root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
        local pos = root.Position + dir * step
        root.CFrame = CFrame.new(pos, pos + dir)
    end)
end

-- Archives clock: Time Shower + Stop time (anti Drones Stampede) -----------
-- The clock lives in Room > Assets > ArchivesClock > Time > TextLabel.
-- Telling the server you looked at the clock (LookedAtRemote) stops the time.
ClockLabel = nil
function FindArchivesClock()
    if ClockLabel and ClockLabel.Parent and ClockLabel:IsDescendantOf(Workspace) then return ClockLabel end
    ClockLabel = nil
    local r = Rooms()
    if not r then return nil end
    local list = {}
    for _, room in ipairs(r:GetChildren()) do
        local n = tonumber(room.Name)
        if n then table.insert(list, { Room = room, N = n }) end
    end
    table.sort(list, function(a, b) return a.N > b.N end)
    for i = 1, math.min(6, #list) do
        local clock = list[i].Room:FindFirstChild("ArchivesClock", true)
        local time = clock and clock:FindFirstChild("Time", true)
        local lbl = time and (time:FindFirstChild("TextLabel") or time:FindFirstChildWhichIsA("TextLabel", true))
        if lbl then
            ClockLabel = lbl
            return lbl
        end
    end
    return nil
end

ClockGui = nil
Loop(0.25, function()
    if not S.TimeShower then
        if ClockGui then ClockGui.Enabled = false end
        return
    end
    if not ClockGui or not ClockGui.Parent then
        ClockGui = Instance.new("ScreenGui")
        ClockGui.Name = "Sm1lerHub_Clock"
        ClockGui.ResetOnSpawn = false
        ClockGui.Parent = GuiParent()
        local lbl = Instance.new("TextLabel")
        lbl.Name = "Label"
        lbl.AnchorPoint = Vector2.new(0, 1)
        lbl.Position = UDim2.new(0, 12, 1, -12)
        lbl.Size = UDim2.fromOffset(190, 32)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextStrokeTransparency = 0.35
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 18
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = ClockGui
    end
    ClockGui.Enabled = true
    local src = FindArchivesClock()
    ClockGui.Label.Text = "Time: " .. (src and src.Text or "--:--")
end)

Loop(0.5, function()
    if not S.BypassDrones then return end
    local lbl = FindArchivesClock()
    local clock = lbl and lbl:FindFirstAncestor("ArchivesClock")
    local remote = clock and clock:FindFirstChild("LookedAtRemote", true)
    if remote and remote:IsA("RemoteEvent") then pcall(function() remote:FireServer() end) end
end)

-- Anti Ransom / Anti Closet Trash (Archives) -------------------------------
function IsClosetTrash(name)
    return string.sub(name, 1, 6) == "Binder" or string.sub(name, 1, 4) == "Shoe" or string.sub(name, 1, 5) == "Shelf"
end
Connect(Workspace.ChildAdded, function(child)
    local name = child.Name
    if (S.AntiRansom and name == "Ransom") or (S.AntiClosetTrash and IsClosetTrash(name)) then
        task.defer(function() pcall(function() child:Destroy() end) end)
    end
end)

--=========================================================--
--  WORLD VISUALS
--=========================================================--



FogBackup = nil
function RestoreFog()
    if not FogBackup then return end
    pcall(function()
        Lighting.FogEnd = FogBackup.End
        Lighting.FogStart = FogBackup.Start
        for atmo, density in pairs(FogBackup.Atmo) do
            if atmo.Parent then atmo.Density = density end
        end
    end)
    FogBackup = nil
end

LightBackup = nil
function RestoreLighting()
    if not LightBackup then return end
    pcall(function()
        Lighting.Brightness = LightBackup.B
        Lighting.Ambient = LightBackup.A
        Lighting.OutdoorAmbient = LightBackup.O
        Lighting.GlobalShadows = LightBackup.G
    end)
    LightBackup = nil
end

AMBIENT_COLORS = {
    White = Color3.fromRGB(255, 255, 255), Purple = Color3.fromRGB(170, 120, 255),
    Blue = Color3.fromRGB(110, 170, 255), Green = Color3.fromRGB(120, 255, 150),
    Red = Color3.fromRGB(255, 110, 110), Gold = Color3.fromRGB(255, 210, 110),
}
AmbientBackup = nil

Loop(0.5, function()
    if S.Fullbright then
        if not LightBackup then
            LightBackup = { B = Lighting.Brightness, A = Lighting.Ambient, O = Lighting.OutdoorAmbient, G = Lighting.GlobalShadows }
        end
        Lighting.Brightness = 3
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.GlobalShadows = false
    elseif LightBackup then
        RestoreLighting()
    end
    -- Ambient: tint the lighting with the chosen colour (overrides Fullbright's white)
    if S.Ambient then
        if not AmbientBackup then AmbientBackup = { A = Lighting.Ambient, O = Lighting.OutdoorAmbient } end
        local color = AMBIENT_COLORS[S.AmbientColor] or AMBIENT_COLORS.White
        Lighting.Ambient = color
        Lighting.OutdoorAmbient = color
    elseif AmbientBackup then
        if not S.Fullbright then
            pcall(function()
                Lighting.Ambient = AmbientBackup.A
                Lighting.OutdoorAmbient = AmbientBackup.O
            end)
        end
        AmbientBackup = nil
    end
    if S.NoFog then
        if not FogBackup then
            FogBackup = { End = Lighting.FogEnd, Start = Lighting.FogStart, Atmo = {} }
            for _, a in ipairs(Lighting:GetChildren()) do
                if a:IsA("Atmosphere") then FogBackup.Atmo[a] = a.Density end
            end
        end
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e5
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                if FogBackup.Atmo[a] == nil then FogBackup.Atmo[a] = a.Density end
                a.Density = 0
            end
        end
    elseif FogBackup then
        RestoreFog()
    end
    if S.NoEffects then
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("BlurEffect") or e:IsA("ColorCorrectionEffect") then e.Enabled = false end
        end
        local cam = Workspace.CurrentCamera
        if cam then
            for _, e in ipairs(cam:GetChildren()) do
                if e:IsA("BlurEffect") or e:IsA("ColorCorrectionEffect") then e.Enabled = false end
            end
        end
    end
end)

--=========================================================--
--  PLAYER
--=========================================================--

-- noclip with proper restore (respects God Mode / Position Spoof collision clones)
NoclipSaved = {}
function RestoreNoclip()
    local spoofOn = S.PositionSpoof or S.GodMode
    for part, value in pairs(NoclipSaved) do
        if part and part.Parent then
            if not (spoofOn and (part.Name == "Collision" or part.Name == "CollisionCrouch" or part.Name == "HumanoidRootPart")) then
                pcall(function() part.CanCollide = value end)
            end
        end
    end
    NoclipSaved = {}
end

Connect(RunService.Stepped, function()
    local c = Char()
    local active = S.Noclip or (Farm.Running and S.FarmNoclip)
    if active and c then
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                if NoclipSaved[p] == nil and p.Name ~= "CollisionClone" and p.Name ~= "CollisionPartClone" then
                    NoclipSaved[p] = p.CanCollide
                end
                p.CanCollide = false
            end
        end
    elseif next(NoclipSaved) then
        RestoreNoclip()
    end
    if S.AntiFling then
        local h = HRP()
        if h and h.AssemblyLinearVelocity.Magnitude > 120 and not S.Fly then
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

-- No touch damage: DOORS contact damage (Giggle ceiling, Snare wrap, Lava,
-- Banana, water) is server-side touch damage. Changing CanTouch on the map
-- parts does NOT replicate to the server (you don't own them), which is why
-- map-part bypasses don't hold. The one thing the server DOES respect is your
-- OWN parts' CanTouch, so this disables touch on your own character parts.
-- Off by default: test it in game, and turn it off if it ever breaks a
-- mechanic you need (hiding in DOORS is prompt-based, so it normally is fine).
TouchBackup = setmetatable({}, { __mode = "k" })
function RestoreTouchDamage()
    for part, old in pairs(TouchBackup) do
        if part and part.Parent then pcall(function() part.CanTouch = old end) end
        TouchBackup[part] = nil
    end
end
Loop(0.25, function()
    local c = Char()
    if not c then return end
    local active = S.NoTouchDamage or S.GodMode or S.PositionSpoof
        or S.BypassGiggle or S.BypassGloombat or S.BypassLava
        or S.BypassBanana or S.AntiSnare or S.BypassWater
        or S.BypassVacuum or S.BypassSeek or S.BypassWall
    local parts = {}
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then table.insert(parts, p) end
    end
    for _, p in ipairs(parts) do
        if active then
            if TouchBackup[p] == nil then TouchBackup[p] = p.CanTouch end
            if p.CanTouch then p.CanTouch = false end
        elseif TouchBackup[p] ~= nil then
            p.CanTouch = TouchBackup[p]
            TouchBackup[p] = nil
        end
    end
end)

-- fly (PC keys + mobile joystick)
FlyBV, FlyBG, FlyConn = nil
function StopFly()
    if FlyConn then FlyConn:Disconnect(); FlyConn = nil end
    if FlyBV then pcall(function() FlyBV:Destroy() end); FlyBV = nil end
    if FlyBG then pcall(function() FlyBG:Destroy() end); FlyBG = nil end
end

function StartFly()
    StopFly()
    local hrp = HRP()
    if not hrp then return end
    FlyBV = Instance.new("BodyVelocity")
    FlyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    FlyBV.Velocity = Vector3.zero
    FlyBV.Parent = hrp
    FlyBG = Instance.new("BodyGyro")
    FlyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    FlyBG.P = 9e4
    FlyBG.Parent = hrp
    FlyConn = RunService.RenderStepped:Connect(function()
        if not S.Fly or not HubAlive then StopFly() return end
        local h, hum, cam = HRP(), Hum(), Workspace.CurrentCamera
        if not h or not hum or not cam or not FlyBV then return end
        if FlyBV.Parent ~= h then FlyBV.Parent = h; FlyBG.Parent = h end
        FlyBG.CFrame = cam.CFrame
        local dir = Vector3.zero
        local md = hum.MoveDirection
        if md.Magnitude > 0 then
            local look = cam.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local forward = flatLook.Magnitude > 0 and md:Dot(flatLook.Unit) or 0
            dir = md + Vector3.new(0, look.Y * forward, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
            dir += Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
            dir -= Vector3.new(0, 1, 0)
        end
        FlyBV.Velocity = (dir.Magnitude > 0) and dir.Unit * (S.FlySpeed or 45) or Vector3.zero
    end)
end

-- speed / jump / position offset
OrigHip, OrigSpeed = nil, nil
SpeedAttrChar, SpeedAttrOld = nil, nil

-- the speed the game itself would give you right now (base 15 + boosts +
-- modifiers - injuries - crouch). Speed boost adds on top of this, so crouching,
-- injuries and modifiers keep working like normal.
function GameSpeed()
    local c, h = Char(), Hum()
    if not c or not h then return 15 end
    local mods = ReplicatedStorage:FindFirstChild("LiveModifiers")
    local function has(n) return mods and mods:FindFirstChild(n) ~= nil end
    local speed = 15
    speed += (c:GetAttribute("SpeedBoost") or 0) + (c:GetAttribute("SpeedBoostBehind") or 0) + (c:GetAttribute("SpeedBoostExtra") or 0)
    if CurrentFloor() == "Party" then speed += 10 end
    if has("PlayerFast") then speed += 3 end
    if has("PlayerFaster") then speed += 6 end
    if has("PlayerFastest") then speed += 20 end
    if has("PlayerSlow") then speed -= 3 end
    if has("PlayerSlowHealth") then speed -= 0.075 * (h.MaxHealth - h.Health) end
    if IsCrouching() then
        speed -= (has("PlayerCrouchSlow") or has("PlayerSlow")) and 8 or 5
    end
    return speed
end

function ApplySpeedBoost()
    local c, h = Char(), Hum()
    if not c or not h then return end
    if not S.SpeedBoost then
        if SpeedAttrChar == c and SpeedAttrOld ~= nil then
            c:SetAttribute("SpeedBoostExtra", SpeedAttrOld)
        end
        SpeedAttrChar, SpeedAttrOld = nil, nil
        return
    end
    if SpeedAttrChar ~= c then
        SpeedAttrChar = c
        SpeedAttrOld = c:GetAttribute("SpeedBoostExtra") or 0
    end
    OrigSpeed = true
    -- DOORS recalculates WalkSpeed from these attributes. Setting only
    -- Humanoid.WalkSpeed was overwritten every frame, so the bypass appeared
    -- dead. Feed the desired boost into the game's own SpeedBoostExtra too.
    local extra = math.max(0, (tonumber(S.Speed) or 20) - 15)
    if c:GetAttribute("SpeedBoostExtra") ~= extra then
        c:SetAttribute("SpeedBoostExtra", extra)
    end
    local want = GameSpeed()
    if h.WalkSpeed ~= want then h.WalkSpeed = want end
end
-- applied on Stepped (runs right before physics reads WalkSpeed), not only on
-- RenderStepped: the game resets the speed during the frame, so RenderStepped
-- alone got overwritten and the boost "did nothing"
Connect(RunService.Stepped, ApplySpeedBoost)
Connect(RunService.Heartbeat, ApplySpeedBoost)
Loop(0.15, function()
    local h = Hum()
    if not h then return end
    if not S.SpeedBoost and OrigSpeed ~= nil then
        if SpeedAttrChar and SpeedAttrOld ~= nil then
            SpeedAttrChar:SetAttribute("SpeedBoostExtra", SpeedAttrOld)
        end
        SpeedAttrChar, SpeedAttrOld = nil, nil
        h.WalkSpeed = GameSpeed()
        OrigSpeed = nil
    end
    if S.EnableJump then
        h.UseJumpPower = true
        h.JumpPower = S.JumpPower
        h:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        pcall(function() Char():SetAttribute("CanJump", true) end)
    end
end)

-- instant interact
Connect(ProximityPromptService.PromptShown, function(prompt)
    if S.InstantInteract then prompt.HoldDuration = 0 end
end)
Connect(ProximityPromptService.PromptButtonHoldBegan, function(prompt)
    if S.InstantInteract and fireproximityprompt then pcall(fireproximityprompt, prompt) end
end)

-- auto interact (with an ignore list)
INTERACT_LIST = { "Glitch Fragments", "Jeff Items", "Dropped Items", "Currency", "Minecarts", "Locks" }
-- prompts auto interact never touches (closets, rifts, dialogue, climbing)
-- IMPORTANT FIX: previously InteractPrompt, Prompt and PropPrompt were here,
-- which completely broke auto looting on drawers, desks, tables and item spawns!
INTERACT_NEVER = {
    HidePrompt = true, HidingPrompt = true, RiftPrompt = true, StarRiftPrompt = true,
    ClimbPrompt = true, DonatePrompt = true, DialoguePrompt = true, RevivePrompt = true,
    EnterPrompt = true, AnimatePrompt = true, ToolEventPrompt = true,
    SinkPrompt = true, ManualOpenPrompt = true, EntryPrompt = true, TrashcanPrompt = true,
    CartPrompt = true, VendorPrompt = true, SeatPrompt = true,
}
-- objects auto interact never touches (props, terminals, fake keys ...)
INTERACT_NEVER_PARENT = {
    TrackLever = true, KeyObtainFake = true, TithingPlate = true, ArchivesStorageBox = true, Briefcase = true,
    Faucet = true, PaperPlanePickup = true, PaperPlane = true, Keyboard = true, ArchivesTerminal = true,
    SeatPart = true, CobblerFriendly = true, StairwellTerminal = true, ElevatorBreaker = true,
    Padlock = true, MinesAnchor = true,
}
INTERACT_NEVER_GRANDPARENT = {
    DoorFake = true, FakeDoor = true, IndustrialGate = true, ArchivesLargePrinter = true,
    ArchivesOfficeChair = true, MeldChord = true,
}

function Durable(tool)
    -- true while the item still has uses left (Durability below its max)
    if not tool then return false end
    local d, m = tool:GetAttribute("Durability"), tool:GetAttribute("DurabilityMax")
    return not (d and m and d >= m)
end

function InteractIgnored(p)
    local ig = S.InteractIgnore
    local parent = p.Parent
    if not parent then return true end
    local c = Char()
    if c and c:GetAttribute("Hiding") == true then return true end
    local pName, parName = p.Name, parent.Name
    local grand = parent.Parent and parent.Parent.Name or ""
    if INTERACT_NEVER[pName] or INTERACT_NEVER_PARENT[parName] or INTERACT_NEVER_GRANDPARENT[grand] then return true end
    if pName == "ActivateEventPrompt" and p.ActionText == "Close" then return true end
    if p:GetAttribute("AutoInteractIgnore") then return true end
    if parName == "LeverForGate" and p:GetAttribute("Interactions") then return true end

    -- ignore list from the menu
    local path = string.lower(p:GetFullName())
    if ig["Glitch Fragments"] and parName == "GlitchCube" then return true end
    if ig["Jeff Items"] and (parent:GetAttribute("JeffShop") or string.find(path, "jeff", 1, true)) then return true end
    if ig["Dropped Items"] then
        local drops = Workspace:FindFirstChild("Drops")
        if drops and p:IsDescendantOf(drops) then return true end
    end
    if ig["Currency"] and (parName == "GoldPile" or parName == "StardustPickup") then return true end
    if ig["Minecarts"] and (pName == "PushPrompt" or string.find(path, "minecart", 1, true)) then return true end
    if ig["Locks"] and (IsLockPrompt(p) or string.find(path, "padlock", 1, true)) then return true end

    -- never waste time on a lock / vine / skull you have no item for
    if not CanUsePrompt(p) then return true end

    -- do not pick up things you already have / cannot use
    if parName == "KeyObtain" and (HasItem("Key") or HasItem("KeyBackdoor")) then return true end
    if parName == "ElectricalKeyObtain" and HasItem("KeyElectrical") then return true end
    if (parName == "LibraryHintPaper" or parName == "PickupItem")
        and (HasItem("LibraryHintPaper") or HasItem("LibraryHintPaperHard")) then return true end
    if parName == "AlarmClock" and HasItem("AlarmClock") then return true end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local owned = (c and c:FindFirstChild(parName)) or (bp and bp:FindFirstChild(parName))
    if owned and not Durable(owned) then return true end
    if parName == "Bandage" then
        local h = Hum()
        local pack = (c and c:FindFirstChild("BandagePack")) or (bp and bp:FindFirstChild("BandagePack"))
        if h and h.Health >= h.MaxHealth and not pack then return true end
        if pack and not Durable(pack) then return true end
    end
    if parName == "Battery" then
        local tool = c and c:FindFirstChildOfClass("Tool")
        local pack = (c and c:FindFirstChild("BatteryPack")) or (bp and bp:FindFirstChild("BatteryPack"))
        if not (tool and tool:GetAttribute("LightSource")) and not pack then return true end
        if tool and tool:GetAttribute("LightSource") and not Durable(tool) and not pack then return true end
        if pack and not Durable(pack) then return true end
    end
    if pName == "HerbPrompt" then
        local main = MainUI()
        local fx = main and main:FindFirstChild("MainFrame") and main.MainFrame:FindFirstChild("Healthbar")
        fx = fx and fx:FindFirstChild("Effects")
        local green = fx and fx:FindFirstChild("HerbGreenEffect")
        if green and green.Visible then return true end
    end
    return false
end

AuraCooldown = setmetatable({}, { __mode = "k" })
Loop(0.35, function()
    if not S.InteractAura then return end
    local hrp = HRP()
    local r = Rooms()
    if not hrp or not r then return end
    local _, n = CurrentRoom()
    local reach = (tonumber(S.PromptReach) or 100) / 100
    local c = Char()
    if c and c:GetAttribute("Hiding") == true then return end
    -- each prompt is checked on its own: one odd prompt used to throw an error
    -- and stop the whole scan, which is why auto loot only worked sometimes
    local function tryPrompt(p)
        if not p.Parent then return end
        if not (p.Enabled or p.Name == "LongPushPrompt" or p.Name == "BigPropPrompt") then return end
        if not IsSafePrompt(p) or InteractIgnored(p) then return end
        local pos = PartPos(p.Parent)
        if not pos then return end
        local reachDist = math.max(p.MaxActivationDistance, 7) * reach + 2
        if (pos - hrp.Position).Magnitude > reachDist then return end
        local last = AuraCooldown[p]
        if last and tick() - last < 0.4 then return end
        AuraCooldown[p] = tick()
        -- disabled push prompts are switched on for the moment they are used
        if not p.Enabled then pcall(function() p.Enabled = true end) end
        FirePrompt(p)
    end
    local function scan(container)
        if not container then return end
        for _, p in ipairs(container:GetDescendants()) do
            if p:IsA("ProximityPrompt") then pcall(tryPrompt, p) end
        end
    end
    scan(r:FindFirstChild(tostring(n)))
    scan(r:FindFirstChild(tostring(n - 1)))
    scan(r:FindFirstChild(tostring(n + 1)))
    scan(Workspace:FindFirstChild("Drops"))
end)

-- prompt reach multiplier + prompt clip (through walls), restored when off
PromptBackup = setmetatable({}, { __mode = "k" })
Loop(0.5, function()
    local reach = (tonumber(S.PromptReach) or 100) / 100
    local active = reach ~= 1 or S.PromptClip
    local r = Rooms()
    if active and r then
        local _, n = CurrentRoom()
        for i = n - 1, n + 1 do
            local room = r:FindFirstChild(tostring(i))
            if room then
                for _, p in ipairs(room:GetDescendants()) do
                    if p:IsA("ProximityPrompt") then
                        local b = PromptBackup[p]
                        if not b then
                            b = { Dist = p.MaxActivationDistance, LOS = p.RequiresLineOfSight }
                            PromptBackup[p] = b
                        end
                        p.MaxActivationDistance = b.Dist * reach
                        p.RequiresLineOfSight = (not S.PromptClip) and b.LOS or false
                    end
                end
            end
        end
    elseif not active then
        for p, b in pairs(PromptBackup) do
            if p.Parent then
                pcall(function()
                    p.MaxActivationDistance = b.Dist
                    p.RequiresLineOfSight = b.LOS
                end)
            end
            PromptBackup[p] = nil
        end
    end
end)

-- remove acceleration: the character's parts get density 100 (the rest of the
-- root part's physics is kept), so it stops sliding after you let go
PhysBackup = setmetatable({}, { __mode = "k" })
Loop(0.5, function()
    local c = Char()
    if S.NoAccel and c then
        local root = c:FindFirstChild("HumanoidRootPart")
        local base = (root and root.CustomPhysicalProperties) or PhysicalProperties.new(Enum.Material.Plastic)
        local heavy = PhysicalProperties.new(100, base.Friction, base.Elasticity, base.FrictionWeight, base.ElasticityWeight)
        for _, part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then
                if PhysBackup[part] == nil then PhysBackup[part] = part.CustomPhysicalProperties or false end
                part.CustomPhysicalProperties = heavy
            end
        end
    elseif next(PhysBackup) then
        for part, old in pairs(PhysBackup) do
            if part.Parent then pcall(function() part.CustomPhysicalProperties = old or nil end) end
            PhysBackup[part] = nil
        end
    end
end)

-- enable sliding (game attribute)
Loop(0.5, function()
    local c = Char()
    if c and S.EnableSlide and c:GetAttribute("CanSlide") ~= true then
        c:SetAttribute("CanSlide", true)
    end
end)

-- infinite jumps (space bar on PC, jump button on mobile - JumpRequest covers both)
Typing = false
Connect(UserInputService.TextBoxFocused, function() Typing = true end)
Connect(UserInputService.TextBoxFocusReleased, function() Typing = false end)
Connect(UserInputService.JumpRequest, function()
    if not S.InfJump or Typing then return end
    local h = Hum()
    if h and h.Health > 0 then h:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

-- Anticheat bypass: climbing a ladder while this is on makes the game switch
-- its anticheat off (the Climbing flag is cleared). It comes back after a
-- cutscene, Void or Glitch - you get a notification and just use a ladder again.
AnticheatOff = false
ClimbConn = nil
Loop(0.5, function()
    local c = Char()
    if not c then return end
    if not ClimbConn or ClimbConn.Char ~= c then
        if ClimbConn then ClimbConn.Conn:Disconnect() end
        ClimbConn = { Char = c, Conn = c:GetAttributeChangedSignal("Climbing"):Connect(function()
            if c:GetAttribute("Climbing") == true and S.DisableAnticheat and not AnticheatOff then
                task.wait(0.25)
                c:SetAttribute("Climbing", false)
                AnticheatOff = true
                Notify(HUB_NAME, T("Anticheat disabled. It comes back after a cutscene or a Halt room."), 6)
            end
        end) }
    end
end)
function AnticheatBack()
    if AnticheatOff then
        AnticheatOff = false
        Notify(HUB_NAME, T("The anticheat is back on. Use a ladder to disable it again."), 6)
    end
end
task.spawn(function()
    local rf = RemoteFolder()
    if not rf then return end
    local cut = rf:WaitForChild("Cutscene", 30)
    if cut and HubAlive then
        Connect(cut.OnClientEvent, function(name)
            if not tostring(name):find("SewerSeek") then AnticheatBack() end
        end)
    end
    local enemy = rf:WaitForChild("UseEnemyModule", 30)
    if enemy and HubAlive then
        Connect(enemy.OnClientEvent, function(name)
            if name == "Void" or name == "Glitch" then AnticheatBack() end
        end)
    end
end)
function ApplyAnticheat()
    if not S.DisableAnticheat and AnticheatOff then
        local rf = RemoteFolder()
        local ladder = rf and rf:FindFirstChild("ClimbLadder")
        if ladder then pcall(function() ladder:FireServer() end) end
        AnticheatOff = false
    end
end

-- Infinite revives (Fools / OldHotel only): keeps asking to revive after death
Connect(LocalPlayer:GetAttributeChangedSignal("Alive"), function()
    if LocalPlayer:GetAttribute("Alive") ~= false or not S.InfiniteRevives then return end
    local floor = CurrentFloor()
    if floor ~= "Fools" and floor ~= "OldHotel" then return end
    task.spawn(function()
        local t0 = tick()
        while HubAlive and S.InfiniteRevives and LocalPlayer:GetAttribute("Alive") ~= true and tick() - t0 < 30 do
            local rf = RemoteFolder()
            local revive = rf and rf:FindFirstChild("Revive")
            if revive then pcall(function() revive:FireServer() end) end
            task.wait(0.5)
        end
    end)
end)

-- Fools floor: the game sometimes leaves you frozen (Anchored) outside a closet
Loop(0.5, function()
    if CurrentFloor() ~= "Fools" then return end
    local c, root = Char(), HRP()
    if root and root.Anchored and c and c:GetAttribute("Hiding") ~= true then
        task.wait()
        if root.Anchored and c:GetAttribute("Hiding") ~= true then root.Anchored = false end
    end
end)

-- Auto solve anchors (Mines): when you are next to an anchor, the code from the
-- anchor hint on your screen is entered for you
AnchorSending = false
Loop(0.1, function()
    if not S.AutoAnchors or AnchorSending then return end
    local main = MainUI()
    local hint = main and main:FindFirstChild("AnchorHintFrame")
    local codeLabel = hint and hint:FindFirstChild("Code")
    if not codeLabel then return end
    local hrp = HRP()
    local r = Rooms()
    if not hrp or not r then return end
    local _, n = CurrentRoom()
    for i = n - 1, n + 1 do
        local room = r:FindFirstChild(tostring(i))
        if room then
            for _, a in ipairs(room:GetDescendants()) do
                if a.Name == "MinesAnchor" and a:IsA("Model") and not a:GetAttribute("Activated") and a.PrimaryPart then
                    local prompt = a:FindFirstChild("ActivateEventPrompt", true)
                    local reach = prompt and prompt.MaxActivationDistance or 8
                    if (a.PrimaryPart.Position - hrp.Position).Magnitude < reach then
                        local remote = a:FindFirstChild("AnchorRemote")
                        if remote and remote:IsA("RemoteFunction") then
                            AnchorSending = true
                            local code = codeLabel.Text
                            task.spawn(function()
                                pcall(function() remote:InvokeServer(code) end)
                                AnchorSending = false
                            end)
                            return
                        end
                    end
                end
            end
        end
    end
end)

-- auto breaker box: every time the code on the breaker screen changes, the
-- solve remote (EBF) is sent; the elevator gets a touch trigger once it is done
BreakerHinted, BreakerDone = false, false
BreakerWatched = setmetatable({}, { __mode = "k" })
Loop(1, function()
    if not S.AutoBreaker then return end
    local r = Rooms()
    local breaker = r and r:FindFirstChild("ElevatorBreaker", true)
    if breaker and not BreakerHinted then
        BreakerHinted = true
        Notify(HUB_NAME, T("Interact with the breaker box - it will be solved automatically."), 6)
    end
    if breaker and not BreakerWatched[breaker] then
        local gui = breaker:FindFirstChild("SurfaceGui", true)
        local code = gui and gui:FindFirstChild("Frame") and gui.Frame:FindFirstChild("Code")
        if code then
            BreakerWatched[breaker] = true
            Connect(code:GetPropertyChangedSignal("Text"), function()
                if not S.AutoBreaker then return end
                local rf = RemoteFolder()
                local ebf = rf and rf:FindFirstChild("EBF")
                if ebf then pcall(function() ebf:FireServer() end) end
            end)
        end
    end
    local car = r and r:FindFirstChild("ElevatorCar", true)
    if car and not BreakerDone and car:FindFirstChild("TouchInterest", true) then
        BreakerDone = true
        Notify(HUB_NAME, T("Breaker box solved - go to the elevator!"), 6)
    end
end)

-- auto tp next door (paused while the auto farm is running)
Loop(0.15, function()
    if S.AutoTpDoor and not Farm.Running then TpNextDoor() end
end)

--=========================================================--
--  BYPASS  (every change is remembered and undone when off)
--=========================================================--

BypassSaved = setmetatable({}, { __mode = "k" }) -- part -> { key, CanTouch, CanCollide, Transparency }

function BypassPart(part, key, props)
    if not part:IsA("BasePart") then return end
    local saved = BypassSaved[part]
    if not saved then
        saved = { Key = key, CanTouch = part.CanTouch, CanCollide = part.CanCollide, Transparency = part.Transparency }
        BypassSaved[part] = saved
    end
    for prop, value in pairs(props) do
        if part[prop] ~= value then part[prop] = value end
    end
end

function BypassModel(model, key, props)
    if model:IsA("BasePart") then BypassPart(model, key, props) end
    for _, p in ipairs(model:GetDescendants()) do
        if p:IsA("BasePart") then BypassPart(p, key, props) end
    end
end

function RestoreBypass(onlyKey)
    for part, saved in pairs(BypassSaved) do
        if not onlyKey or saved.Key == onlyKey then
            if part.Parent then
                pcall(function()
                    part.CanTouch = saved.CanTouch
                    part.CanCollide = saved.CanCollide
                    part.Transparency = saved.Transparency
                end)
            end
            BypassSaved[part] = nil
        end
    end
end

-- name -> { flag, props } for everything that is just "stop touching me"
NO_TOUCH = { CanTouch = false }
NO_HIT = { CanTouch = false, CanCollide = false }
BYPASS_RULES = {
    GiggleCeiling = { "BypassGiggle",   NO_TOUCH },
    GloomPile     = { "BypassGloombat", NO_TOUCH }, -- the Gloombat egg piles
    GloombatEgg   = { "BypassGloombat", NO_TOUCH },
    Lava          = { "BypassLava",     NO_TOUCH },
    ScaryWall     = { "BypassWall",     NO_HIT },
    BananaPeel    = { "BypassBanana",   NO_TOUCH },
    JeffTheKiller = { "BypassJeff",     NO_HIT },
}
BYPASS_KEYS = { "BypassGiggle", "BypassDupe", "BypassGloombat", "BypassSeek", "BypassVacuum",
                      "BypassLava", "BypassWall", "BypassBanana", "BypassJeff", "RemoveSeekTrigger" }
LastBypass = {}
SeekWalkways = setmetatable({}, { __mode = "k" }) -- bridge -> walkway parts
SeekTriggers = setmetatable({}, { __mode = "k" })
DupePromptSaved = setmetatable({}, { __mode = "k" })

function ApplyBypassTo(obj)
    local name = obj.Name
    local rule = BYPASS_RULES[name]
    if not rule and string.find(name, "GloombatEgg", 1, true) then rule = BYPASS_RULES.GloombatEgg end
    if rule and S[rule[1]] then
        BypassModel(obj, rule[1], rule[2])
    end
    if S.BypassDupe and (name == "DoorFake" or name == "FakeDoor") then
        local hidden = obj:FindFirstChild("Hidden")
        if hidden then BypassPart(hidden, "BypassDupe", NO_TOUCH) end
        local lock = obj:FindFirstChild("Lock")
        local prompt = lock and lock:FindFirstChild("UnlockPrompt")
        if prompt then
            if DupePromptSaved[prompt] == nil then DupePromptSaved[prompt] = prompt.Enabled end
            prompt.Enabled = false
        end
    end
    if S.BypassVacuum and name == "SideroomSpace" then
        local col = obj:FindFirstChild("Collision")
        if col then BypassPart(col, "BypassVacuum", { CanTouch = false, CanCollide = true }) end
    end
    if S.BypassSeek and obj:IsA("BasePart") then
        local ln = string.lower(name)
        if name == "SeekFloodline" then
            BypassPart(obj, "BypassSeek", { CanTouch = false, CanCollide = true })
        elseif string.find(ln, "seek_arm", 1, true) or string.find(ln, "seekarm", 1, true)
            or string.find(ln, "chandelierobstruction", 1, true) or string.find(ln, "seek_fire", 1, true) then
            BypassPart(obj, "BypassSeek", NO_TOUCH)
        end
    end
    -- Seek chase bridges: each broken bridge gets a solid cyan walkway,
    -- built from its low PlayerBarrier (removed again when the bypass is off)
    if S.BypassSeek and name == "Bridge" and obj:IsA("Model") and not SeekWalkways[obj] then
        SeekWalkways[obj] = {}
        for _, barrier in ipairs(obj:GetChildren()) do
            if barrier.Name == "PlayerBarrier" and barrier:IsA("BasePart") and math.abs(barrier.Size.Y - 2.75) < 0.01
                and (math.abs(barrier.Orientation.X) < 1 or math.abs(math.abs(barrier.Orientation.X) - 180) < 1) then
                local walk = barrier:Clone()
                walk.Name = "Sm1lerHub_SeekBridge"
                walk.CFrame = barrier.CFrame * CFrame.new(0, 0, -5)
                walk.Size = Vector3.new(barrier.Size.X, barrier.Size.Y, 11)
                walk.Anchored, walk.CanCollide, walk.CanTouch = true, true, false
                walk.Color = Color3.fromRGB(0, 255, 255)
                walk.Material = Enum.Material.ForceField
                walk.Transparency = 0
                walk:ClearAllChildren()
                walk.Parent = obj
                table.insert(SeekWalkways[obj], walk)
            end
        end
    end
    -- Delete Seek trigger (Fools / OldHotel): the chase trigger is touched and
    -- released over and over, so it is used up without starting the chase
    if S.RemoveSeekTrigger and name == "TriggerEventCollision" and firetouchinterest and not SeekTriggers[obj] then
        local floor = CurrentFloor()
        if floor == "Fools" or floor == "OldHotel" then
            SeekTriggers[obj] = true
            task.spawn(function()
                while HubAlive and S.RemoveSeekTrigger and obj:IsDescendantOf(game) do
                    local root = HRP()
                    if root then
                        for _, part in ipairs(obj:GetChildren()) do
                            if part:IsA("BasePart") then
                                pcall(firetouchinterest, root, part, 0)
                                task.wait()
                                pcall(firetouchinterest, root, part, 1)
                            end
                        end
                    end
                    task.wait()
                end
                SeekTriggers[obj] = nil
            end)
        end
    end
end

function RemoveSeekWalkways()
    for bridge, list in pairs(SeekWalkways) do
        for _, walk in ipairs(list) do pcall(function() walk:Destroy() end) end
        SeekWalkways[bridge] = nil
    end
end

Loop(0.4, function()
    -- undo the bypasses that were just switched off
    for _, key in ipairs(BYPASS_KEYS) do
        if LastBypass[key] and not S[key] then
            RestoreBypass(key)
            if key == "BypassSeek" then RemoveSeekWalkways() end
            if key == "BypassDupe" then
                for prompt, enabled in pairs(DupePromptSaved) do
                    if prompt.Parent then pcall(function() prompt.Enabled = enabled end) end
                    DupePromptSaved[prompt] = nil
                end
            end
        end
        LastBypass[key] = S[key]
    end
    -- the game turns the Seeking Wall back on and resets the Seek flood, so
    -- both are forced back every scan
    for part, saved in pairs(BypassSaved) do
        if part.Parent then
            if saved.Key == "BypassWall" and S.BypassWall and (part.CanTouch or part.CanCollide) then
                part.CanTouch, part.CanCollide = false, false
            elseif saved.Key == "BypassSeek" and S.BypassSeek and part.Name == "SeekFloodline" and not part.CanCollide then
                part.CanCollide = true
            end
        end
    end
    local any = false
    for _, key in ipairs(BYPASS_KEYS) do if S[key] then any = true break end end
    if not any then return end

    local r = Rooms()
    if r then
        local _, n = CurrentRoom()
        for i = n - 1, n + 2 do
            local room = r:FindFirstChild(tostring(i))
            if room then
                for _, d in ipairs(room:GetDescendants()) do ApplyBypassTo(d) end
            end
        end
    end
    for _, c in ipairs(Workspace:GetChildren()) do ApplyBypassTo(c) end
end)

-- Bypass Eyes / Lookman: tell the server you are looking down while they exist
Loop(0.3, function()
    if not S.BypassEyes then return end
    local eyes = Workspace:FindFirstChild("Eyes") or Workspace:FindFirstChild("BackdoorLookman")
    if not eyes then return end
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    local motor = rf and rf:FindFirstChild("MotorReplication")
    if not motor then return end
    local floor = CurrentFloor()
    pcall(function()
        if floor == "Fools" or floor == "OldHotel" then
            -- old-style remote: (x, pitch, z, crouching) - pitch down
            motor:FireServer(0, SpoofHigh and 65 or -65, 0, false)
        else
            motor:FireServer(-650)
        end
    end)
end)

-- run control remotes
function FireRunRemote(name, ...)
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    local remote = rf and rf:FindFirstChild(name)
    if remote then
        local args = { ... }
        pcall(function() remote:FireServer(table.unpack(args)) end)
        return true
    end
    Notify(HUB_NAME, T("This action is not available here."), 4)
    return false
end

function ResetCharacter()
    if replicatesignal then
        local ok = pcall(replicatesignal, LocalPlayer.Kill)
        if ok then return end
    end
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    if rf and rf:FindFirstChild("Underwater") then
        pcall(function() rf.Underwater:FireServer(true) end)
        Notify(HUB_NAME, T("Resetting - this takes about 20 seconds."), 5)
    else
        local h = Hum()
        if h then h.Health = 0 end
    end
end

-- dangerous buttons need a second click within 3 seconds
PendingConfirm = {}
function Confirm(id, fn)
    if PendingConfirm[id] and tick() - PendingConfirm[id] < 3 then
        PendingConfirm[id] = nil
        fn()
    else
        PendingConfirm[id] = tick()
        Notify(HUB_NAME, T("Click again to confirm."), 3)
    end
end

-- feature keybinds: N noclip, R auto interact, Q auto closet, B position spoof, V velocity (hold)
FEATURE_KEYS = {
    [Enum.KeyCode.N] = "Noclip",
    [Enum.KeyCode.R] = "InteractAura",
    [Enum.KeyCode.Q] = "AutoHide",
    [Enum.KeyCode.B] = "PositionSpoof",
    [Enum.KeyCode.T] = "ThirdPerson",
    [Enum.KeyCode.O] = "CustomFOV",
}
TogRefs = {}
Connect(UserInputService.InputEnded, function(input)
    if input.KeyCode == Enum.KeyCode.V then VelocityHeld = false end
end)
Connect(UserInputService.InputBegan, function(input, gp)
    if gp or not S.FeatureKeybinds then return end
    if input.KeyCode == Enum.KeyCode.V then VelocityHeld = true return end
    local key = FEATURE_KEYS[input.KeyCode]
    if not key then return end
    S[key] = not S[key]
    if key == "Noclip" and not S[key] then RestoreNoclip() end
    if key == "PositionSpoof" then
        S.GodMode = S.PositionSpoof
        ApplyGodMode()
    end
    Persist()
    if TogRefs[key] then pcall(function() TogRefs[key]:Set(S[key]) end) end
    if key == "PositionSpoof" and TogRefs.GodMode then pcall(function() TogRefs.GodMode:Set(S.GodMode) end) end
    Notify(HUB_NAME, (key == "PositionSpoof" and "God Mode (Position Spoof)" or key) .. ": " .. (S[key] and "ON" or "OFF"), 2)
end)

-- door reach: every door within 75 studs is asked to open (ClientOpen),
-- also while you ride a minecart; stops for a door once it is open
function InMinecart()
    local cam = Workspace.CurrentCamera
    return cam and cam:FindFirstChild("MinecartRig") ~= nil
end
Loop(0.1, function()
    if not S.DoorReach and not InMinecart() then return end
    local hrp, r = HRP(), Rooms()
    if not hrp or not r then return end
    local _, n = CurrentRoom()
    for i = n - 1, n + 2 do
        local room = r:FindFirstChild(tostring(i))
        local door = room and room:FindFirstChild("Door")
        local part = door and door:FindFirstChild("Door")
        local co = door and door:FindFirstChild("ClientOpen")
        if part and part:IsA("BasePart") and co and co:IsA("RemoteEvent")
            and door:GetAttribute("Opened") ~= true and door:GetAttribute("Open") ~= true
            and (part.Position - hrp.Position).Magnitude < 75 then
            pcall(function() co:FireServer() end)
        end
    end
end)

-- anti afk / disable idle kick
Connect(LocalPlayer.Idled, function()
    if S.AntiAFK and VirtualUser then
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)
function ApplyIdleKick()
    if not getconnections then return end
    pcall(function()
        for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do
            if S.AntiAFK then conn:Disable() else conn:Enable() end
        end
    end)
end
task.defer(ApplyIdleKick)

--=========================================================--
--  AUTO FARM FLOOR 1
--=========================================================--

StatusLabel, ProgressLabel, TimeLabel, FarmToggleRef = nil
FarmFigureSpoof = false

function SetStatus(text)
    if StatusLabel then pcall(function() StatusLabel:Set(T("Status") .. ": " .. text) end) end
end
function SetProgress(text)
    if ProgressLabel then pcall(function() ProgressLabel:Set(T("Progress") .. ": " .. text) end) end
end

Loop(1, function()
    if Farm.Running and TimeLabel then
        local s = math.floor(tick() - Farm.Start)
        pcall(function() TimeLabel:Set(string.format("%s: %02d:%02d", T("Time"), s // 60, s % 60)) end)
    end
end)

function StopFarm(reason, silent)
    if not Farm.Running then return end
    Farm.Running = false
    S.AutoFarm = false
    if FarmFigureSpoof then
        FarmFigureSpoof = false
        if not S.GodMode then S.PositionSpoof = false end
        pcall(ApplyPositionSpoof)
    end
    if ClearFarmPath then ClearFarmPath() end
    SetStatus(T("Idle"))
    if FarmToggleRef then pcall(function() FarmToggleRef:Set(false) end) end
    if not silent then Notify(HUB_NAME, reason or T("Auto farm stopped."), 5) end
end

-- Hotel Auto Farm path walker ------------------------------------------------
-- This is intentionally independent from Auto Rooms. It owns Humanoid:MoveTo
-- while Auto Farm + Walk are enabled, draws large green route dots, interrupts
-- immediately for entities, and rebuilds when progress stops.
WaitOutDanger = nil -- forward declaration, used by the path walker
do
    local PathService = game:GetService("PathfindingService")
    local PathFolder = Instance.new("Folder")
    PathFolder.Name = "Sm1lerHub_FarmPath"
    PathFolder.Parent = Workspace
    local StuckSerial = 0

    ClearFarmPath = function(onlyDots)
        if not PathFolder or not PathFolder.Parent then return end
        for _, node in ipairs(PathFolder:GetChildren()) do
            if not onlyDots or node.Name == "PathNode" then node:Destroy() end
        end
    end

    local function DrawPath(points)
        ClearFarmPath(true)
        if not S.FarmShowPath then return end
        for index, waypoint in ipairs(points) do
            local dot = Instance.new("Part")
            dot.Name = "PathNode"
            dot.Shape = Enum.PartType.Ball
            dot.Size = Vector3.new(1.45, 1.45, 1.45)
            dot.Anchored = true
            dot.CanCollide = false
            dot.CanTouch = false
            dot.CanQuery = false
            dot.Material = Enum.Material.Neon
            dot.Color = (index == #points) and Color3.fromRGB(60, 220, 255) or Color3.fromRGB(0, 255, 90)
            dot.Transparency = 0.2
            dot.Position = waypoint.Position + Vector3.new(0, 0.18, 0)
            dot.Parent = PathFolder
        end
    end

    local function MarkStuck(pos)
        StuckSerial += 1
        local block = Instance.new("Part")
        block.Name = "StuckPart"
        block.Size = Vector3.new(5, 6, 5)
        block.CFrame = CFrame.new(pos)
        block.Anchored = true
        block.CanCollide = false
        block.CanTouch = false
        block.CanQuery = false
        block.Transparency = 1
        block.Parent = PathFolder
        local modifier = Instance.new("PathfindingModifier")
        modifier.Label = "FarmStuck"
        modifier.PassThrough = false
        modifier.Parent = block
        task.delay(20, function()
            if block.Parent then block:Destroy() end
        end)
    end

    local function FollowPath(points, goal)
        local hum = Hum()
        if not hum then return false, "character" end
        local timeout = math.clamp((tonumber(S.FarmPathTimeout) or 12) / 10, 0.5, 3)
        for _, waypoint in ipairs(points) do
            if not (Farm.Running and S.AutoFarm and HubAlive) then return false, "off" end
            if DangerNow() then return false, "danger" end
            local root = HRP()
            if not root then return false, "character" end
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                hum.Jump = true
            end
            local lastDist = math.huge
            local lastProgress = tick()
            while Farm.Running and S.AutoFarm and HubAlive do
                if DangerNow() then return false, "danger" end
                root, hum = HRP(), Hum()
                if not root or not hum then return false, "character" end
                local flat = Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z)
                local dist = (flat - root.Position).Magnitude
                if dist <= 3.2 then break end
                -- Humanoid:MoveTo is called continuously, so player input is
                -- overridden while the farm owns navigation.
                hum:MoveTo(waypoint.Position)
                if dist < lastDist - 0.25 then
                    lastDist = dist
                    lastProgress = tick()
                else
                    -- Walk used to freeze / snap back here: MoveTo alone is not
                    -- enough when the engine (or God Mode / anti-cheat) fights the
                    -- controller. As soon as progress stalls, push the character
                    -- toward the waypoint with CFrame so it keeps gliding along
                    -- the computed route instead of standing still.
                    if tick() - lastProgress > 0.35 then
                        local delta = flat - root.Position
                        if delta.Magnitude > 0.05 then
                            local step = math.min(delta.Magnitude, 1.6)
                            pcall(function()
                                root.CFrame = CFrame.new(root.Position + delta.Unit * step)
                                root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                            end)
                        end
                    end
                    if tick() - lastProgress > timeout then
                        MarkStuck(root.Position)
                        return false, "stuck"
                    end
                end
                task.wait(0.05)
            end
        end
        local root = HRP()
        return root ~= nil and (root.Position - goal).Magnitude < 8, "done"
    end

    FarmPathMove = function(goal)
        if not goal then return false end
        local attempts = 0
        while Farm.Running and S.AutoFarm and HubAlive and attempts < 12 do
            if DangerNow() then
                WaitOutDanger()
                attempts += 1
                continue
            end
            local root = HRP()
            if not root then
                task.wait(0.25)
                attempts += 1
                continue
            end
            if (root.Position - goal).Magnitude < 7 then
                ClearFarmPath(true)
                return true
            end
            local path = PathService:CreatePath({
                AgentRadius = 1.5,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = false,
                WaypointSpacing = 3,
                Costs = { FarmStuck = math.huge },
            })
            -- Position Spoof keeps the real root below the navmesh. Compute
            -- from its visible/floor position, otherwise Pathfinding returns
            -- NoPath while God Mode is enabled.
            local pathStart = root.Position + ((S.PositionSpoof or S.GodMode) and Vector3.new(0, 2.346, 0) or Vector3.zero)
            local ok = pcall(function() path:ComputeAsync(pathStart, goal) end)
            local points = ok and path.Status == Enum.PathStatus.Success and path:GetWaypoints() or {}
            if #points == 0 then
                MarkStuck(root.Position)
                attempts += 1
                task.wait(0.15)
                continue
            end
            DrawPath(points)
            local reached, reason = FollowPath(points, goal)
            if reached then
                ClearFarmPath(true)
                return true
            end
            if reason == "danger" then WaitOutDanger() end
            if not S.FarmRepath and reason == "stuck" then return false end
            attempts += 1
            SetStatus(T("Rebuilding path...") .. " [" .. attempts .. "]")
            task.wait(0.12)
        end
        return false
    end
end

-- Hides for the whole time a Rush-like entity is in the run.
--  * Ambush comes back several times: the model stays in Workspace between
--    passes, so the hub stays hidden until it is really gone (+ 2 s)
--  * if the game throws you out of the closet, you are hidden again
--  * no free closet nearby -> Position spoof is switched on for the danger
--    (the server sees you underground, so Rush / Ambush miss) and off again
SpoofByFarm = false
WaitOutDanger = function()
    if not S.FarmPause then return end
    local initDanger = DangerNow()
    if not initDanger then return end
    local isAmbush = (initDanger.Name == "AmbushMoving" or Workspace:FindFirstChild("AmbushMoving") ~= nil)
    SetStatus(T("Entity nearby - hiding") .. (isAmbush and " (Ambush!)" or ""))
    -- for extra safety against Ambush and fast rushers, enable position spoof while hiding
    if not S.PositionSpoof and not S.GodMode then
        S.PositionSpoof = true
        SpoofByFarm = true
        pcall(ApplyPositionSpoof)
    end
    local hid = HideInCloset()
    local t0 = tick()
    local clearSince = nil
    local sawAmbush = isAmbush
    -- Ambush rebounds 2-4 times with short pauses at the ends of the hall. The
    -- model can vanish between passes, so we only leave once nothing dangerous
    -- is in Workspace AND we have been clear for a long, safe window.
    while Farm.Running and HubAlive and Alive() and tick() - t0 < 180 do
        local amb = Workspace:FindFirstChild("AmbushMoving") or Workspace:FindFirstChild("FrozenAmbush")
        if amb then sawAmbush = true end
        local currentDanger = DangerNow() or amb
        if currentDanger then
            clearSince = nil
            if not IsHiding() then
                HideInCloset()
            end
        else
            clearSince = clearSince or tick()
            -- Ambush needs a much longer clear window than Rush (it comes back)
            local waitClear = sawAmbush and 6 or 2.5
            if tick() - clearSince > waitClear then break end
        end
        task.wait(0.2)
    end
    if IsHiding() or HidingIn then ExitHiding() end
    if SpoofByFarm then
        S.PositionSpoof = false
        SpoofByFarm = false
        pcall(ApplyPositionSpoof)
    end
    SetStatus(T("Idle"))
end

-- long teleports stop as soon as danger shows up (not while getting into a closet)
SteppedAbort = function()
    return Farm.Running and S.FarmPause and not HidingNow and not IsHiding() and DangerNow() ~= nil
end

-- GOD MODE = position spoof, exactly like in Abysall. It is not a health
-- change: the server keeps seeing your root 2.346 studs underground, so every
-- entity that measures the distance to your character (Rush, Ambush, A-60,
-- A-120, Blitz, Glitched variants, ...) misses you.
--
-- Nothing here needs to be tuned by hand. Turning it on:
--   1. enables position spoof (the actual protection),
--   2. adds whatever extra bypasses make sense on the floor you are in,
--   3. re-checks that floor every 2 s, so walking into another floor adapts it.
-- Turning it off restores only what it switched on itself.
GOD_KEYS_ALL = {
    "NoScreechDamage", "NoHaltDamage", "NoA90Damage", "NoSurgeDamage",
    "BypassEyes", "BypassSeek", "BypassLava", "BypassWall", "BypassGiggle",
    "BypassGloombat", "BypassVacuum", "BypassDupe", "AntiSnare", "SeekHelper",
    "NoTouchDamage",
}
GOD_KEYS_FIGURE = { "FigureGodmode" }
GOD_KEYS_ARCHIVE = { "AntiScribbles", "AntiDrones", "BypassDronesArchive", "AntiAlma" }

GodTurnedOn = {}
NextGodCheck = 0

function GodKeysForFloor()
    local f = CurrentFloor()
    local keys = {}
    for _, k in ipairs(GOD_KEYS_ALL) do table.insert(keys, k) end
    if f == "Hotel" or f == "OldHotel" or f == "Fools" or f == "Mines" then
        for _, k in ipairs(GOD_KEYS_FIGURE) do table.insert(keys, k) end
    end
    if f == "Archives" then
        for _, k in ipairs(GOD_KEYS_ARCHIVE) do table.insert(keys, k) end
    end
    return keys
end

function ApplyGodMode()
    if S.GodMode then
        local wanted = { PositionSpoof = true }
        for _, k in ipairs(GodKeysForFloor()) do wanted[k] = true end
        -- remove protections that God Mode enabled for the previous floor but
        -- are not part of the new floor's automatic setup
        for k in pairs(GodTurnedOn) do
            if not wanted[k] then
                S[k] = false
                GodTurnedOn[k] = nil
            end
        end
        S.PositionSpoof = true          -- the protection itself
        GodTurnedOn.PositionSpoof = true
        for _, k in ipairs(GodKeysForFloor()) do
            if S[k] == false then
                S[k] = true
                GodTurnedOn[k] = true
            end
        end
    else
        for k in pairs(GodTurnedOn) do S[k] = false end
        GodTurnedOn = {}
    end
    pcall(ApplyPositionSpoof)
    pcall(ApplyFakeRemotes)
    pcall(SyncExtra)
    if TogRefs then
        for k in pairs(GodTurnedOn) do
            local ref = TogRefs[k]
            if ref then pcall(function() ref:Set(S[k]) end) end
        end
        if TogRefs.GodMode then pcall(function() TogRefs.GodMode:Set(S.GodMode) end) end
        if TogRefs.PositionSpoof then pcall(function() TogRefs.PositionSpoof:Set(S.PositionSpoof) end) end
    end
    Persist()
end

-- adapts god mode when you walk into another floor.
-- BUG IT FIXED: this used to call ApplyGodMode every 2 s, which called Persist()
-- every 2 s, which wrote config.json to disk twice a second for as long as god
-- mode was on. Now it only re-applies when the floor actually changes.
GodLastFloor = nil
Loop(2, function()
    if not S.GodMode then
        GodLastFloor = nil
        return
    end
    local f = CurrentFloor()
    if f ~= GodLastFloor then
        GodLastFloor = f
        pcall(ApplyGodMode)
        if f and f ~= "Unknown" then
            Notify(HUB_NAME, "God mode: " .. f, 3)
        end
    end
end)

NotifiedRoom = {}
function NotifyOnce(tag, room, text)
    local key = tag .. tostring(room)
    if NotifiedRoom[key] then return end
    NotifiedRoom[key] = true
    Notify(HUB_NAME, text, 4)
end

function HandleKey(room)
    local key = FindKey(room)
    if not key or HasKey() then return end
    NotifyOnce("key", room.Name, T("Key found - grabbing it first"))
    SetStatus(T("Key found - grabbing it first"))
    local t0 = tick()
    while Farm.Running and Alive() and key:IsDescendantOf(Workspace) and not HasKey() do
        WaitOutDanger()
        MoveTo(PartPos(key:FindFirstChild("Hitbox") or key))
        FirePrompt(key:FindFirstChild("ModulePrompt", true) or key:FindFirstChildWhichIsA("ProximityPrompt", true))
        task.wait(0.3)
        if tick() - t0 > 40 then break end
    end
end

function HandleLever(room)
    local lever = FindLever(room)
    if not lever then return end
    local prompt = lever:IsA("ProximityPrompt") and lever or lever:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt or not prompt.Enabled then return end
    NotifyOnce("lever", room.Name, T("Lever found - pulling it first"))
    SetStatus(T("Lever found - pulling it first"))
    local _, startN = CurrentRoom()
    local t0 = tick()
    while Farm.Running and Alive() and prompt:IsDescendantOf(Workspace) and prompt.Enabled do
        WaitOutDanger()
        MoveTo(PartPos(lever))
        FirePrompt(prompt)
        task.wait(0.35)
        local _, n = CurrentRoom()
        if n > startN or tick() - t0 > 30 then break end
    end
end

function CollectGold(room)
    -- iterate a snapshot: picking gold destroys instances mid-loop, and the
    -- old strict prompt.Enabled check skipped gold piles whose prompt the game
    -- had not enabled yet - that is why auto-gold "did nothing at all"
    for _, d in ipairs(room:GetDescendants()) do
        if not Farm.Running then return end
        if not d.Parent then continue end
        if (d.Name == "GoldPile" or d.Name == "StardustPickup") and (d:IsA("Model") or d:IsA("BasePart")) then
            local prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Parent then
                -- go right to the prompt position so the server counts us in range
                MoveTo(PartPos(prompt.Parent) or PartPos(d))
                FirePrompt(prompt)
                task.wait(0.15)
            end
        end
    end
end

function SolvePuzzle(room)
    for _, d in ipairs(room:GetDescendants()) do
        if not Farm.Running then return end
        if d:IsA("ProximityPrompt") and d.Enabled and IsSafePrompt(d) then
            FirePrompt(d)
            task.wait(0.05)
        end
    end
end

function SolveLibrary(room)
    for _, d in ipairs(room:GetDescendants()) do
        if not Farm.Running then return end
        if d.Name == "LiveHintBook" then
            local prompt = d:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled then
                WaitOutDanger()
                MoveTo(PartPos(d))
                FirePrompt(prompt)
                task.wait(0.2)
            end
        end
    end
    -- if every hint is known, walk to the padlock and enter the code
    local code = LibraryCodeRef and LibraryCodeRef()
    local rf = RemoteFolder()
    local pl = rf and rf:FindFirstChild("PL")
    local padlock = room:FindFirstChild("Padlock", true)
    if code and not string.find(code, "_", 1, true) and tonumber(code) and pl and padlock then
        MoveTo(PartPos(padlock))
        pcall(function() pl:FireServer(code) end)
        NotifyOnce("librarycode", room.Name, string.format(T("The code is: %s"), code))
        return
    end
    NotifyOnce("library", room.Name, T("Library: books collected - enter the padlock code"))
end

--=========================================================--
--  LIBRARY PADLOCK  (room 50)
--  The code is built from the hints the game shows you: the hint paper
--  (PermUI.Hints) has a row of shapes, each book you picked up shows a shape
--  with a digit. Every shape on the paper is replaced by its digit; shapes you
--  have not found yet stay "_". Written by Sm1ler - the original's own
--  GetLibraryCode was not in the parts that were shared.
--=========================================================--

function ImageOf(gui)
    local img = gui:IsA("ImageLabel") and gui or gui:FindFirstChildWhichIsA("ImageLabel", true)
    return img and img.Image or nil
end

function LibraryCodeRef()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local hints = pg and pg:FindFirstChild("PermUI") and pg.PermUI:FindFirstChild("Hints")
    if not hints then return nil end
    -- digits: every book hint = a shape image + a digit label
    local digitFor = {}
    for _, h in ipairs(hints:GetChildren()) do
        local lbl = h:FindFirstChildWhichIsA("TextLabel", true)
        local img = ImageOf(h)
        if lbl and img and tonumber(lbl.Text) then digitFor[img] = lbl.Text end
    end
    -- order: the hint paper shows the shapes left to right
    local c = Char()
    local paper = c and (c:FindFirstChild("LibraryHintPaper") or c:FindFirstChild("LibraryHintPaperHard"))
    local ui = paper and paper:FindFirstChild("UI", true)
    if not ui then return nil end
    local slots = {}
    for _, d in ipairs(ui:GetDescendants()) do
        if d:IsA("ImageLabel") and d.Image ~= "" and tonumber(d.Name) then
            table.insert(slots, d)
        end
    end
    table.sort(slots, function(a, b) return tonumber(a.Name) < tonumber(b.Name) end)
    if #slots == 0 then return nil end
    local code = ""
    for _, slot in ipairs(slots) do
        code = code .. (digitFor[slot.Image] or "_")
    end
    return code
end

-- a guess: fills unknown digits randomly (the original's "Guess code" also
-- needs some books collected to have any chance)
function GuessCode()
    local code = LibraryCodeRef()
    if not code then return nil end
    return (string.gsub(code, "_", function() return tostring(math.random(0, 9)) end))
end

CodeShown, LastPadlockSend = nil, 0
Loop(0.5, function()
    if not (S.NotifyLibraryCode or S.AutoPadlock or S.GuessLibraryCode) then return end
    local code = LibraryCodeRef()
    local complete = code and not string.find(code, "_", 1, true) and tonumber(code) ~= nil
    if S.NotifyLibraryCode and complete and code ~= CodeShown then
        CodeShown = code
        Notify(T("Padlock code found!"), string.format(T("The code is: %s"), code), 15)
    end
    local r = Rooms()
    local padlock = r and r:FindFirstChild("Padlock", true)
    local rf = RemoteFolder()
    local pl = rf and rf:FindFirstChild("PL")
    if not padlock or not pl or tick() - LastPadlockSend < 0.5 then return end
    local hrp = HRP()
    local pos = PartPos(padlock)
    if S.AutoPadlock and complete and hrp and pos and (pos - hrp.Position).Magnitude < (tonumber(S.PadlockDistance) or 10) then
        LastPadlockSend = tick()
        pcall(function() pl:FireServer(code) end)
    elseif S.GuessLibraryCode then
        local _, n = CurrentRoom()
        local guess = n == 50 and GuessCode()
        if guess then
            LastPadlockSend = tick()
            pcall(function() pl:FireServer(guess) end)
        end
    end
end)

function FinishFarm()
    SetStatus(T("All done!"))
    SetProgress(string.format("%d / %d (100%%)", FINAL_DOOR, FINAL_DOOR))
    Notify(T("All done!"), T("Floor 1 complete - 100 doors passed. Sm1ler Hub finished the run."), 12)
    SendCaption("Floor 1 complete - all done!")
    StopFarm(nil, true)
end

function FigureInRoom(room)
    if not room then return false end
    for _, name in ipairs({ "Figure", "FigureRig", "FigureRagdoll" }) do
        local figure = room:FindFirstChild(name, true)
        if figure and figure:IsDescendantOf(Workspace) then return true end
    end
    return false
end

function UpdateFarmFigureProtection(room)
    local present = FigureInRoom(room)
    if present and not (S.GodMode or S.PositionSpoof) then
        S.PositionSpoof = true
        FarmFigureSpoof = true
        pcall(ApplyPositionSpoof)
        SetStatus(T("Figure room - temporary God Mode"))
    elseif not present and FarmFigureSpoof then
        S.PositionSpoof = false
        FarmFigureSpoof = false
        pcall(ApplyPositionSpoof)
    end
end

-- Loot every container (chests, drawers, toolboxes, locked item lockers)
LOOT_BOX = {
    ChestBox = true, ChestBoxLocked = true, Toolbox = true, Toolbox_Locked = true,
    Chest_Vine = true, Toolshed_Small = true, Locker_Small_Locked = true,
    DrawerContainer = true, RolltopContainer = true, MouseHole = true, Chest = true,
}
function LootContainers(room)
    if not S.AutoLootBoxes or not room then return end
    for _, d in ipairs(room:GetDescendants()) do
        if not Farm.Running then return end
        if not d.Parent then continue end
        if LOOT_BOX[d.Name] and (d:IsA("Model") or d:IsA("BasePart")) then
            for _, p in ipairs(d:GetDescendants()) do
                if p:IsA("ProximityPrompt") and IsSafePrompt(p) then
                    if not p.Enabled then pcall(function() p.Enabled = true end) end
                    local pos = PartPos(d) or PartPos(p.Parent)
                    if pos then
                        MoveTo(pos)
                        FirePrompt(p)
                        task.wait(0.12)
                    end
                end
            end
        end
    end
end

-- Lockpick-first: padlock-style doors (Lock1/Lock2/LockPrompt) can be picked
-- without the key. When a Lockpick (or Multitool) is in the inventory, open the
-- lock directly and only fall back to the key if picking fails.
function TryLockpickDoor(room)
    if not S.LockpickFirst then return false end
    if not (HasItem("Lockpick", true) or HasItem("Multitool", true)) then return false end
    local door = FindDoor(room)
    if not door then return false end
    local prompt
    for _, nm in ipairs({ "Lock1", "Lock2", "LockPrompt", "Padlock", "SkullPrompt" }) do
        local p = door:FindFirstChild(nm, true)
        if p and p:IsA("ProximityPrompt") then prompt = p break end
    end
    if not prompt then return false end
    SetStatus(T("Opening lock with Lockpick (infinite items)"))
    local t0 = tick()
    while Farm.Running and Alive() and tick() - t0 < 12 do
        WaitOutDanger()
        local dp = DoorPosition(room)
        if dp then MoveTo(dp) end
        if not prompt.Enabled then pcall(function() prompt.Enabled = true end) end
        FirePrompt(prompt)
        task.wait(0.3)
        if not prompt.Parent then break end
    end
    return true
end

-- Figure rooms (library 50 / electrical 100): stay safe and just progress
function HandleFigureRoom(room, n)
    if not S.AutoFigure then return false end
    if not FigureInRoom(room) then return false end
    SetStatus(T("Auto Figure room"))
    if n == 50 then
        SolveLibrary(room)
        return true
    end
    return false
end

function WorkRoom(room, n)
    UpdateFarmFigureProtection(room)
    if S.SeekHelper and InSeekChase() then
        SetStatus(T("Seek chase - following the path"))
        ClearSeekObstacles(room)
    elseif HandleFigureRoom(room, n) then
        -- Figure room already handled (books + code + door)
    elseif n == 50 then
        SolveLibrary(room)
    else
        if S.AutoKeyLever then
            HandleLever(room)
            -- if a padlock-style door can be picked, do that instead of the key
            if not TryLockpickDoor(room) then
                HandleKey(room)
                TryLockpickDoor(room)
            end
        end
        if S.AutoGold then CollectGold(room) end
        LootContainers(room)
    end
    if not Farm.Running then return end
    local dp = DoorPosition(room)
    if dp then
        -- exactly like Auto Rooms: the closed door must not block the local
        -- pathfinder / MoveTo while we are walking to its prompt
        local door = FindDoor(room)
        local inner = door and door:FindFirstChild("Door")
        if inner and inner:IsA("BasePart") then inner.CanCollide = false end
        MoveTo(dp)
        OpenDoor(room)
    end
end

-- one farm "step". Runs inside a pcall from FarmLoop: a single error (a glitch
-- teleport mid-loop, a destroyed part, a ragdoll frame, a glitching entity
-- model) used to kill the whole task, which is why the farm used to "die /
-- reset" after one glitch touched it - now it recovers and keeps running
function FarmStep()
    if FarmPlayerDead() then
        -- Do not switch the feature off. Wait for respawn / revive and continue
        -- because the user asked the farm to remain alive until the toggle is
        -- manually switched off (door 100 is the only automatic stop).
        SetStatus(T("Waiting for respawn..."))
        task.wait(0.6)
        return
    end
    if not CharacterReady() then
        SetStatus(T("Recovering after Glitch / teleport..."))
        task.wait(0.6)
        return
    end
    WaitOutDanger()
    if not Farm.Running then return end

    local room, n = CurrentRoom()
    UpdateFarmFigureProtection(room)
    if n >= FINAL_DOOR then
        FinishFarm()
        return
    end

    if not room then
        SetStatus(T("Waiting for the run to start..."))
        SkipIntro()
        task.wait(0.6)
        return
    end

    SetStatus(string.format(T("Door %d / %d"), n + 1, FINAL_DOOR))
    SetProgress(string.format("%d / %d (%d%%)", n, FINAL_DOOR, math.floor(n / FINAL_DOOR * 100)))
    if n == 0 then SkipIntro() end

    WorkRoom(room, n)

    -- keep teleporting to the correct door until the counter goes up
    local t0 = tick()
    local roomStart = tick()
    local warned = false
    while Farm.Running and Alive() do
        local _, now = CurrentRoom()
        if now > n then break end
        WaitOutDanger()
        if not room.Parent then break end -- the room was unloaded: start over
        if tick() - t0 > 6 then
            t0 = tick()
            if S.AutoPuzzle and DoorIsLocked(room) and n ~= 50 and not FindKey(room) then
                SolvePuzzle(room)
            end
            if n ~= 50 or not DoorIsLocked(room) then
                WorkRoom(room, n)
            end
        end
        -- watchdog: stuck on one door for 45 s -> try the next closed
        -- door in the run (a skipped / dupe room) and tell the player
        if tick() - roomStart > 45 and n ~= 50 then
            if not warned then
                warned = true
                Notify(HUB_NAME, string.format(T("Stuck at door %d - trying the next door"), n + 1), 5)
            end
            roomStart = tick()
            if TpNextDoor() then
                local nextRoom = CurrentRoom()
                if nextRoom then OpenDoor(nextRoom) end
            end
        end
        task.wait(0.2)
    end
end

function FarmLoop()
    Farm.Start = tick()
    local errCount = 0
    while Farm.Running and HubAlive do
        local ok, err = pcall(FarmStep)
        if not ok then
            errCount += 1
            warn("[Sm1ler Hub] farm error (farm keeps running): " .. tostring(err))
            if errCount == 1 then
                Notify(HUB_NAME, T("Farm glitch - recovering, farm keeps running"), 3)
            end
            if errCount >= 15 then
                StopFarm(T("Auto farm stopped (too many errors)"))
                break
            end
            task.wait(1)
        else
            -- only consecutive failures matter; one old Glitch must not count
            -- against the farm for the rest of the entire run
            errCount = 0
        end
    end
    Farm.Running = false
end

function StartFarm()
    if Farm.Running then return end
    local floor = CurrentFloor()
    if game.PlaceId ~= DOORS_HOTEL or (floor ~= "Hotel" and floor ~= "Unknown") then
        Notify(HUB_NAME, T("Auto Farm Floor 1 only works inside the DOORS Hotel run.") .. " (" .. floor .. ")", 7)
    end
    Farm.Running = true
    NotifiedRoom = {}
    Notify(HUB_NAME, T("Auto farm started - good luck on Floor 1!"), 5)
    task.spawn(FarmLoop)
end

-- watchdog: no exception, Glitch teleport, respawn or character replacement is
-- allowed to leave the toggle ON while the worker is dead. It restarts itself
-- until the user switches it off (or door 100 calls StopFarm).
Loop(1, function()
    if S.AutoFarm and not Farm.Running and HubAlive then
        StartFarm()
    end
end)

function BindCharacter(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    OrigHip, OrigSpeed = nil, nil
    NoclipSaved = {}
    hum.Died:Connect(function()
        if not HubAlive then return end
        -- Glitch / Void can replace the Character and kill the OLD humanoid.
        -- That is not a player death and must not stop Auto Farm.
        task.wait(0.35)
        if char ~= LocalPlayer.Character and CharacterReady() then return end
        if LocalPlayer:GetAttribute("Alive") ~= false and CharacterReady() then return end
        if Farm.Running and S.AutoFarm then
            SetStatus(T("Waiting for respawn..."))
        elseif Farm.Running then
            StopFarm(T("You died - auto farm stopped."))
        end
        StopFly()
        if S.RejoinOnDeath then
            task.wait(2)
            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        end
    end)
end
if Char() then task.spawn(BindCharacter, Char()) end

--=========================================================--
--  AUTO ROOMS  (The Rooms floor, A-000 to A-1000)
--  Walks to RoomExit with PathfindingService. When a dangerous entity is
--  in the rooms it goes to the nearest free hiding spot instead.
--  Stuck spots are marked so the next path avoids them.
--=========================================================--

PathfindingService = game:GetService("PathfindingService")
ROOMS_DANGER = { "RushMoving", "AmbushMoving", "BackdoorRush", "A60", "A120", "CustomEntity", "GlitchRush", "GlitchAmbush" }
RoomsNodes = Instance.new("Folder")
RoomsNodes.Name = "Sm1lerHub_RoomsPath"
RoomsNodes.Parent = Workspace
RoomsBusy = false

function ClearRoomsNodes(name)
    for _, n in ipairs(RoomsNodes:GetChildren()) do
        if not name or n.Name == name then n:Destroy() end
    end
end

function RoomsHidingSpot()
    local hrp = HRP()
    local r = Rooms()
    if not hrp or not r then return nil end
    local best, bestD = nil, math.huge
    local _, n = CurrentRoom()
    for i = n - 1, n + 1 do
        local room = r:FindFirstChild(tostring(i))
        if room then
            for _, d in ipairs(room:GetDescendants()) do
                if d:IsA("Model") and d.PrimaryPart and d:FindFirstChild("HidePrompt") then
                    local occupied = d:FindFirstChild("HiddenPlayer", true)
                    local p = d.PrimaryPart.Position
                    if p.Y > -10 and not (occupied and occupied.Value) then
                        local dist = (p - hrp.Position).Magnitude
                        if dist < bestD then best, bestD = d, dist end
                    end
                end
            end
        end
    end
    return best
end

function RoomsTarget()
    local room = CurrentRoom()
    local exit = room and room:FindFirstChild("RoomExit")
    for _, name in ipairs(ROOMS_DANGER) do
        local e = Workspace:FindFirstChild(name)
        local pp = e and e.PrimaryPart
        if pp and pp.Position.Y > -10 and pp.Position.Y < 150 then
            if not (name == "A60" and S.RoomsIgnoreA60) then
                return RoomsHidingSpot() or exit
            end
        end
    end
    return exit
end

function WalkRooms()
    if RoomsBusy then return end
    RoomsBusy = true
    pcall(function()
        local hum, root = Hum(), HRP()
        local room, n = CurrentRoom()
        if not hum or not root or not room or n >= 1000 then return end

        if S.RoomsIgnoreA60 and not S.PositionSpoof then
            S.PositionSpoof = true
            ApplyPositionSpoof()
        end

        local target = RoomsTarget()
        if not target then return end
        local hiding = target:FindFirstChild("HidePrompt") ~= nil
        local goal = hiding and target.PrimaryPart.Position or target.Position
        if (goal - root.Position).Magnitude >= 750 then return end

        if hiding then
            for _, p in ipairs(target:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        elseif HidingIn then
            ExitHiding()
        end
        local door = room:FindFirstChild("Door")
        local doorPart = door and door:FindFirstChild("Door")
        if doorPart and doorPart:IsA("BasePart") then doorPart.CanCollide = false end

        local path = PathfindingService:CreatePath({
            AgentRadius = 1.5, AgentHeight = 1.5, AgentCanJump = true, AgentCanClimb = false,
            WaypointSpacing = 4, Costs = { StuckPart = 8 },
        })
        local ok = pcall(function() path:ComputeAsync(root.Position, goal) end)
        local points = ok and path:GetWaypoints() or {}
        if #points == 0 then
            hum:MoveTo(goal)
            return
        end

        ClearRoomsNodes("PathNode")
        for _, wp in ipairs(points) do
            local dot = Instance.new("Part")
            dot.Name = "PathNode"
            dot.Shape = Enum.PartType.Ball
            dot.Size = Vector3.one
            dot.Anchored, dot.CanCollide, dot.CanQuery, dot.CanTouch = true, false, false, false
            dot.Material = Enum.Material.Neon
            dot.Color = Color3.fromRGB(0, 255, 110)
            dot.Transparency = S.RoomsShowPath and 0.5 or 1
            dot.Position = wp.Position
            dot.Parent = RoomsNodes
        end

        local timeout = math.clamp((tonumber(S.RoomsTimeout) or 10) / 10, 0.5, 3)
        for _, wp in ipairs(points) do
            if not S.AutoRooms or not HubAlive or not Alive() then break end
            local newTarget = RoomsTarget()
            if newTarget and newTarget ~= target and newTarget:FindFirstChild("HidePrompt") and not hiding then break end
            local t0 = tick()
            while S.AutoRooms and HubAlive do
                local r2 = HRP()
                if not r2 then break end
                if hiding then
                    local prompt = target:FindFirstChild("HidePrompt")
                    if prompt and (goal - r2.Position).Magnitude < prompt.MaxActivationDistance and Char():GetAttribute("Hiding") ~= true then
                        FirePrompt(prompt)
                        HidingIn = target
                    end
                end
                if (Vector3.new(wp.Position.X, r2.Position.Y, wp.Position.Z) - r2.Position).Magnitude < 5 then break end
                hum:MoveTo(wp.Position)
                if tick() - t0 > timeout then
                    -- remember where we got stuck so the next path avoids it
                    local stuck = Instance.new("Part")
                    stuck.Name = "StuckPart"
                    stuck.Shape = Enum.PartType.Ball
                    stuck.Size = Vector3.new(3, 3, 3)
                    stuck.Anchored, stuck.CanCollide, stuck.CanQuery, stuck.CanTouch = true, false, false, false
                    stuck.Transparency = 1
                    stuck.Position = r2.Position
                    stuck.Parent = RoomsNodes
                    local mod = Instance.new("PathfindingModifier")
                    mod.Label = "StuckPart"
                    mod.Parent = stuck
                    return
                end
                task.wait()
            end
        end
    end)
    RoomsBusy = false
end

Loop(0.1, function()
    if not S.AutoRooms then return end
    if CurrentFloor() ~= "Rooms" then return end
    task.spawn(WalkRooms)
end)

Loop(0.5, function()
    for _, n in ipairs(RoomsNodes:GetChildren()) do
        if n.Name == "PathNode" then n.Transparency = S.RoomsShowPath and 0.5 or 1 end
    end
end)

-- a new room means the old stuck marks are useless
task.spawn(function()
    local r = Workspace:WaitForChild("CurrentRooms", 60)
    if r and HubAlive then Connect(r.ChildAdded, function() ClearRoomsNodes("StuckPart") end) end
end)

--=========================================================--
