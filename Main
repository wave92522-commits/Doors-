    TimerLever = "Time Lever", MinesAnchor = "Anchor", WaterPump = "Water Pump", VineGuillotine = "Vine Lever",
}
-- how to tell that an objective has been done (then it leaves the ESP):
-- a sound that plays once, an attribute that changes, or a part that hides
function FindPath(root, ...)
    local cur = root
    for _, name in ipairs({ ... }) do
        cur = cur and cur:FindFirstChild(name)
    end
    return cur
end
DONE_WHEN = {
    TimerLever      = function(o) return FindPath(o, "Main", "SoundToPlay"), "Played" end,
    LeverForGate    = function(o) return FindPath(o, "Main", "SoundToPlay"), "Played" end,
    WaterPump       = function(o) return FindPath(o, "Wheel", "Sound"), "Played" end,
    MinesGenerator  = function(o) return FindPath(o, "Lever", "Sound"), "Played" end,
    MinesGateButton = function(o) return FindPath(o.Parent, "MinesGate", "Main", "SoundOpen"), "Played" end,
    GardenGateButton = function(o) return FindPath(o.Parent, "GardenGate", "Collision", "Sound"), "Played" end,
    MinesAnchor     = function(o) return o, "attr:Activated" end,
    VineGuillotine  = function(o) return FindPath(o, "Lever", "ActivateEventPrompt"), "attr:Interactions" end,
    FuseObtain      = function(o) return FindPath(o, "Hitbox", "FuseModel"), "prop:LocalTransparencyModifier" end,
}
function WatchObjective(obj)
    local rule = DONE_WHEN[obj.Name]
    if not rule or obj:GetAttribute("Sm1lerWatched") then return end
    local target, how = rule(obj)
    if not target then return end -- not loaded yet, try again next scan
    obj:SetAttribute("Sm1lerWatched", true)
    local function done() pcall(function() obj:SetAttribute("Sm1lerUsed", true) end) end
    if how == "Played" and target:IsA("Sound") then
        target.Played:Once(done)
    elseif string.sub(how, 1, 5) == "attr:" then
        target:GetAttributeChangedSignal(string.sub(how, 6)):Once(done)
    elseif string.sub(how, 1, 5) == "prop:" then
        target:GetPropertyChangedSignal(string.sub(how, 6)):Once(done)
    end
end

function ObjectiveLabel(obj)
    local label = OBJECTIVE_LABEL[obj.Name]
    if not label then return nil end
    WatchObjective(obj)
    if obj:GetAttribute("Sm1lerUsed") then return nil end
    if obj.Name == "TimerLever" then
        -- the lever shows "01:00" when it adds a minute, otherwise it adds 30 s
        local timer = obj:FindFirstChild("TakeTimer")
        local lbl = timer and timer:FindFirstChildWhichIsA("TextLabel", true)
        if lbl then label = label .. (lbl.Text == "01:00" and " [+60s]" or " [+30s]") end
    elseif obj.Name == "MinesAnchor" then
        local sign = obj:FindFirstChild("Sign")
        local lbl = sign and sign:FindFirstChildWhichIsA("TextLabel", true)
        if lbl then label = label .. " [" .. lbl.Text .. "]" end
    end
    return label
end
function ObjectiveTarget(obj)
    if obj.Name == "WaterPump" then return obj:FindFirstChild("Wheel") or obj end
    if obj.Name == "VineGuillotine" then return obj:FindFirstChild("Lever") or obj end
    return obj
end

