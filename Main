    ------------------------------------------------------------ TELEPORTS
    local tpTab = UI:Tab(T("Teleports"), "map-pin")
    if tpTab then
        local g = tpTab:Section(T("Teleports"))
        g:Button({ Text = T("Teleport to next door"), Callback = function()
            task.spawn(function()
                local room = CurrentRoom()
                local p = DoorPosition(room)
                if p then MoveTo(p); OpenDoor(room) else Notify(HUB_NAME, T("No door found."), 4) end
            end)
        end })
        g:Button({ Text = T("Teleport to key"), Callback = function()
            task.spawn(function()
                local k = FindKey(CurrentRoom())
                if k then
                    MoveTo(PartPos(k:FindFirstChild("Hitbox") or k))
                    FirePrompt(k:FindFirstChild("ModulePrompt", true))
                else
                    Notify(HUB_NAME, T("No key in this room."), 4)
                end
            end)
        end })
        g:Button({ Text = T("Teleport to lever"), Callback = function()
            task.spawn(function()
                local l = FindLever(CurrentRoom())
                if l then
                    MoveTo(PartPos(l))
                    FirePrompt(l:FindFirstChildWhichIsA("ProximityPrompt", true))
                else
                    Notify(HUB_NAME, T("No lever in this room."), 4)
                end
            end)
        end })
        g:Button({ Text = T("Teleport to gold"), Callback = function()
            task.spawn(function()
                local room = CurrentRoom()
                local gold = room and room:FindFirstChild("GoldPile", true)
                if gold then
                    MoveTo(PartPos(gold))
                    FirePrompt(gold:FindFirstChildWhichIsA("ProximityPrompt", true))
                else
                    Notify(HUB_NAME, T("No gold in this room."), 4)
                end
            end)
        end })
        g:Button({ Text = T("Hide in nearest closet"), Callback = function()
            task.spawn(function()
                if not HideInCloset() then Notify(HUB_NAME, T("No closet nearby."), 4) end
            end)
        end })

        local s = tpTab:Section(T("Server"))
        s:Button({ Text = T("Rejoin server"), Callback = function()
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
        end })
        s:Button({ Text = T("Copy Job ID"), Callback = function()
            local clip = setclipboard or toclipboard
            if clip then clip(tostring(game.JobId)); Notify(HUB_NAME, T("Copied!"), 3) end
        end })
    end

    ------------------------------------------------------------ SETTINGS
    local setTab = UI:Tab(T("Settings"), "settings")
    if setTab then
        local g = setTab:Section(T("Interface"))
        g:Dropdown({
            Text = T("UI Library"), Desc = T("The hub rebuilds instantly"),
            Values = LIB_ORDER, Default = Config.UILibrary,
            Callback = function(v)
                if type(v) ~= "string" or v == Config.UILibrary or not LIBS[v] then return end
                Config.UILibrary = v
                SaveConfig()
                ReloadInterface(T("UI library changed") .. ": " .. v)
            end,
        })
        local langNames, current = {}, "English"
        for _, l in ipairs(LANGUAGES) do
            table.insert(langNames, l.Name)
            if l.Code == Config.Language then current = l.Name end
        end
        g:Dropdown({
            Text = T("Language"), Values = langNames, Default = current,
            Callback = function(v)
                for _, l in ipairs(LANGUAGES) do
                    if l.Name == v and l.Code ~= Config.Language then
                        Config.Language = l.Code
                        SaveConfig()
                        ReloadInterface(T("Language changed") .. ": " .. v)
                        return
                    end
                end
            end,
        })
        if libName == "WindUI" then
            g:Dropdown({
                Text = T("Theme"), Desc = T("Wind UI themes"),
                Values = UI:Themes(), Default = Config.Theme,
                Callback = function(v)
                    if type(v) ~= "string" or v == Config.Theme then return end
                    Config.Theme = v
                    SaveConfig()
                    UI:SetTheme(v)
                end,
            })
        end
        g:Dropdown({
            Text = T("UI scale"), Values = { "75%", "90%", "100%", "110%", "125%" },
            Default = tostring(Config.UIScale) .. "%",
            Callback = function(v)
                local n = tonumber((tostring(v):gsub("%%", "")))
                if not n or n == Config.UIScale then return end
                Config.UIScale = n
                SaveConfig()
                UI:SetScale(n / 100)
            end,
        })
        g:Dropdown({
            Text = T("Toggle key"), Values = { "RightShift", "RightControl", "LeftAlt", "Insert", "K", "M" },
            Default = Config.ToggleKey,
            Callback = function(v)
                if type(v) ~= "string" or v == Config.ToggleKey then return end
                Config.ToggleKey = v
                SaveConfig()
                UI:SetKey(KeyFromName(v))
            end,
        })
        g:Label(T("Device profile") .. ": " .. Device.Name .. " (" .. math.floor(Viewport.X) .. "x" .. math.floor(Viewport.Y) .. ")")

        local n = setTab:Section(T("Notifications"))
        n:Dropdown({
            Text = T("Notification style"), Desc = T("Doors = in-game achievement popup"),
            Values = { "Sm1ler Hub", "Doors", "Caption" }, Default = S.NotifyStyle,
            Callback = function(v)
                if type(v) == "string" and v ~= S.NotifyStyle then
                    S.NotifyStyle = v
                    Persist()
                    Notify(HUB_NAME, T("Notification style") .. ": " .. v, 3)
                end
            end,
        })
        Tog(n, "Notification sound", "NotifySound")
        Tog(n, "Send entity alerts to chat", "ChatAlerts", "Everyone in the server sees the warning")
        n:Input({
            Text = T("Chat message"), Default = S.ChatMessage, Placeholder = "spawned!",
            Callback = function(v) if type(v) == "string" then S.ChatMessage = v; Persist() end end,
        })
        Sld(n, "Sound volume", "NotifyVolume", 0, 10, 1)
        n:Button({ Text = T("Test notification"), Callback = function()
            Notify(HUB_NAME, T("This is how notifications look."), 4)
        end })

        local c = setTab:Section(T("Configs"))
        c:Toggle({
            Text = T("Auto save settings"), Default = Config.AutoSave,
            Callback = function(v) Config.AutoSave = v; SaveConfig() end,
        })

        -- ready-made presets. Each one is a full set of settings for a floor,
        -- so you do not have to hunt through the tabs after a floor change.
        local PRESETS = {
            {
                Name = "Universal",
                Desc = "Works on every floor. God mode, ESP, full protection.",
                Keys = {
                    GodMode = true, EntityNotify = true, SeekHelper = true,
                    EntityESP = true, DoorESP = true, ItemESP = true, GoldESP = true,
                    ESPLabels = true, HUD = true, FarmPause = true,
                    InstantPrompts = true, AntiAFK = true, NoTouchDamage = true,
                },
            },
            {
                Name = "Floor 1 - Hotel",
                Desc = "Full auto farm of the Hotel (doors 1-100) plus god mode.",
                Keys = {
                    GodMode = true, AutoFarm = false, AutoKeyLever = true, AutoGold = true,
                    AutoPuzzle = true, FarmPause = true, FarmNoclip = true,
                    MoveMode = "Walk", TPSpeed = 90, FarmShowPath = true, FarmRepath = true,
                    LockpickFirst = true, AutoLootBoxes = true, AutoFigure = true,
                    EntityNotify = true, SeekHelper = true,
                    EntityESP = true, DoorESP = true, ItemESP = true, GoldESP = true,
                    ESPLabels = true, HUD = true, InteractAura = true, DoorReach = true,
                },
            },
            {
                Name = "Rooms (A-doors)",
                Desc = "Auto walk through The Rooms, hides from A-60 / A-120.",
                Keys = {
                    GodMode = true, AutoRooms = true, RoomsIgnoreA60 = false,
                    RoomsShowPath = true, EntityNotify = true,
                    EntityESP = true, DoorESP = true, HUD = true, FarmPause = true,
                },
            },
            {
                Name = "Mines",
                Desc = "Figure god mode, Seek helper and the breaker / anchor solvers.",
                Keys = {
                    GodMode = true, FigureGodmode = true, SeekHelper = true,
                    AutoBreaker = true, AutoAnchors = true,
                    EntityNotify = true, EntityESP = true, HUD = true,
                },
            },
            {
                Name = "Archives",
                Desc = "Honcho correct-box ESP, water platform, anti drones.",
                Keys = {
                    -- Position spoof and the electric-water platform conflict;
                    -- God Mode is the position spoof, so the platform stays off.
                    GodMode = true, Honcho = true, BypassWater = false,
                    AntiScribbles = true, AntiDrones = true, BypassDronesArchive = true,
                    AntiAlma = true, TimeShower = true, EntityESP = true, HUD = true,
                },
            },
            {
                Name = "Visuals only",
                Desc = "Only ESP and visuals, nothing that touches the game.",
                Keys = {
                    GodMode = false, PositionSpoof = false,
                    EntityESP = true, DoorESP = true, ItemESP = true, GoldESP = true,
                    ClosetESP = true, ESPLabels = true, Fullbright = true, NoFog = true,
                    HUD = true, EntityNotify = true,
                },
            },
        }
        local presetNames = {}
        for _, p in ipairs(PRESETS) do table.insert(presetNames, p.Name) end
        local configList = {}
        for _, name in ipairs(presetNames) do table.insert(configList, name) end
        for _, name in ipairs(ListConfigs()) do
            table.insert(configList, "Saved: " .. name)
        end
        local presetReady = false
        task.defer(function() presetReady = true end)
        local function ApplyPreset(name)
            for _, p in ipairs(PRESETS) do
                if p.Name == name then
                    for k, v in pairs(p.Keys) do
                        if S[k] ~= nil and type(S[k]) == type(v) then S[k] = v end
                    end
                    Persist()
                    pcall(ApplyGodMode)
                    pcall(ApplyPositionSpoof)
                    pcall(ApplyFeatureState)
                    ReloadInterface(p.Name .. " preset loaded")
                    return
                end
            end
        end
        c:Dropdown({
            Text = T("Config list"), Desc = T("Ready-made setting sets for each floor and your saved configs"),
            Values = configList, Default = "Universal",
            Callback = function(v)
                -- Several UI libraries call Dropdown.Callback while creating
                -- the element. Without this guard, Universal auto-loaded on
                -- every UI rebuild and overwrote the user's settings.
                if not presetReady or type(v) ~= "string" then return end
                local savedName = string.match(v, "^Saved:%s*(.+)$")
                if savedName then
                    local path = CFG_DIR .. "/" .. savedName .. ".json"
                    if CanFS and isfile(path) then
                        local okd, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
                        if okd and type(data) == "table" then
                            for k, value in pairs(data) do
                                if not NOT_SAVED[k] and S[k] ~= nil and type(value) == type(S[k]) then S[k] = value end
                            end
                            Persist()
                            ApplyFeatureState()
                            ReloadInterface(T("Config loaded") .. ": " .. savedName)
                        end
                    end
                else
                    ApplyPreset(v)
                end
            end,
        })
        for _, p in ipairs(PRESETS) do
            c:Button({ Text = T("Apply") .. ": " .. p.Name, Desc = p.Desc, Callback = function()
                ApplyPreset(p.Name)
            end })
        end
        local cfgName = "default"
        c:Input({ Text = T("Config name"), Default = cfgName, Placeholder = "default",
            Callback = function(v) if type(v) == "string" and #v > 0 then cfgName = v end end })
        local list = c:Dropdown({
            Text = T("Configs"), Values = ListConfigs(), Default = "default",
            Callback = function(v) if type(v) == "string" then cfgName = v end end,
        })
        c:Button({ Text = T("Save config"), Callback = function()
            if not CanFS then return end
            EnsureFolders()
            pcall(function() writefile(CFG_DIR .. "/" .. cfgName .. ".json", HttpService:JSONEncode(FeatureSnapshot())) end)
            if list and list.Refresh then list:Refresh(ListConfigs()) end
            Notify(HUB_NAME, T("Config saved") .. ": " .. cfgName, 3)
        end })
        c:Button({ Text = T("Load config"), Callback = function()
            local path = CFG_DIR .. "/" .. cfgName .. ".json"
            if not CanFS or not isfile(path) then Notify(HUB_NAME, T("Config not found"), 3) return end
            local okd, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
            if okd and type(data) == "table" then
                for k, v in pairs(data) do
                    if not NOT_SAVED[k] and S[k] ~= nil and type(v) == type(S[k]) then S[k] = v end
                end
                Persist()
                ApplyFeatureState()
                ReloadInterface(T("Config loaded") .. ": " .. cfgName)
            end
        end })
        c:Button({ Text = T("Delete config"), Callback = function()
            local path = CFG_DIR .. "/" .. cfgName .. ".json"
            if CanFS and delfile and isfile(path) then
                pcall(delfile, path)
                if list and list.Refresh then list:Refresh(ListConfigs()) end
                Notify(HUB_NAME, T("Config deleted"), 3)
            end
        end })

        local o = setTab:Section(T("Other"))
        o:Toggle({
            Text = T("Queue on teleport"), Desc = T("Re-runs Sm1ler Hub after teleport (set SCRIPT_URL)"),
            Default = false,
            Callback = function(v)
                if not v then return end
                local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport)
                if SCRIPT_URL == "" or not q then
                    Notify(HUB_NAME, T("Set SCRIPT_URL at the top of the script first."), 6)
                    return
                end
                pcall(q, 'loadstring(game:HttpGet("' .. SCRIPT_URL .. '"))()')
            end,
        })
        o:Button({ Text = T("Unload script"), Callback = function()
            getgenv().Sm1lerHubUnload()
        end })
    end

    ------------------------------------------------------------ INFO
    local infoTab = UI:Tab(T("Info"), "info")
    if infoTab then
        local u = infoTab:Section(T("User"))
        u:Label(T("User") .. ": " .. LocalPlayer.Name .. (IsOwner and "  👑" or ""))
        u:Label(T("Executions") .. ": " .. tostring(Config.Executions))
        u:Label(T("Device profile") .. ": " .. Device.Name .. "  |  UI: " .. libName)
        local okE, exName, exVer = pcall(function() return identifyexecutor() end)
        u:Label(T("Executor") .. ": " .. (okE and tostring(exName) or "Unknown") .. ((okE and exVer) and (" " .. tostring(exVer)) or ""))
        u:Label(T("Floor") .. ": " .. CurrentFloor())

        local c = infoTab:Section(T("Credits"))
        c:Label(HUB_NAME .. " " .. HUB_AUTHOR .. "  |  " .. T("Version") .. " " .. HUB_VERSION)
        c:Label(T("Sm1ler - owner of Sm1ler Hub"))
        c:Label(T("Written from scratch for DOORS"))

        local ch = infoTab:Section(T("Changelog"))
        ch:Label("+ Auto Farm Floor 1 (keys, levers, hiding, library), Auto Rooms A-1000")
        ch:Label("+ Floors: Seek / Eyestalk path, auto minecart, Dam Seek, Cringle, knob farm")
        ch:Label("+ Full ESP (objectives, players, tracers, arrows, rainbow) + ESP settings")
        ch:Label("+ Exploits: bypasses, position / crouch spoof, anticheat bypass, infinite items")
        ch:Label("+ Archives: Honcho, Forget Me Not, Time Shower, stop time, water, drones")
        ch:Label("+ 6 UI libraries, 4 languages, 3 notification styles, configs, keybinds")

        local s = infoTab:Section(T("Scripts"))
        s:Button({ Text = "Infinite Yield", Callback = function()
            task.spawn(function()
                pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))() end)
            end)
        end })
        s:Button({
            Text = T("Launch official Abysall Hub Continued"),
            Desc = T("By TheRealCookieMonsterOf1966 - loaded unmodified"),
            Callback = function()
                task.spawn(function()
                    local okA, err = pcall(function() loadstring(game:HttpGet(ABYSALL_OFFICIAL_URL))() end)
                    if not okA then Notify("Abysall Hub Continued", tostring(err), 6) end
                end)
            end,
        })
    end

    ------------------------------------------------------------ OWNER
    if IsOwner then
        UI:Tag("OWNER")
        local ownTab = UI:Tab("👑 " .. T("Owner Panel"), "crown")
        if ownTab then
            local g = ownTab:Section(T("Owner status"))
            g:Label("👑 " .. OWNER_NAME .. " - OWNER of " .. HUB_NAME)
            Tog(g, "Golden aura", "Aura", nil, function() ApplyAura() end)
            Tog(g, "Rainbow aura", "Rainbow", nil, function() ApplyAura() end)
            g:Button({ Text = T("Send server caption"), Callback = function()
                SendCaption("Owner " .. OWNER_NAME .. " is here - " .. HUB_NAME .. " " .. HUB_AUTHOR)
            end })
            g:Button({ Text = T("Unlock everything"), Callback = function()
                for _, k in ipairs({ "EntityESP", "DoorESP", "ItemESP", "GoldESP", "ClosetESP", "Fullbright",
                    "NoFog", "NoEffects", "NoEntityScares", "EntityNotify", "AntiEyes", "AntiScreech",
                    "AntiSnare", "SeekHelper", "InstantInteract", "InteractAura", "DoorReach", "AntiFling" }) do
                    S[k] = true
                end
                Persist()
                Notify("👑 " .. OWNER_NAME, T("Everything unlocked. Enjoy your hub, boss!"), 6)
                ReloadInterface()
            end })
        end
    end

    pcall(function() UI:Finish() end)
end

-- menu key for libraries without their own key handling
Connect(UserInputService.InputBegan, function(input, gp)
    if gp or not UI or UI.HasOwnKey then return end
    if input.KeyCode == KeyFromName(Config.ToggleKey) then UI:Toggle() end
end)

--=========================================================--
--  UNLOAD
--=========================================================--

getgenv().Sm1lerHubUnload = function()
    -- save the settings first, so unloading does not wipe them
    Config.Features = FeatureSnapshot()
    SaveConfig()
    Farm.Running = false
    S.Fly = false
    StopFly()
    HubAlive = false
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    Conns = {}
    ClearESP()
    if ESPFolder then pcall(function() ESPFolder:Destroy() end) end
    RestoreLighting()
    RestoreFog()
    RestoreNoclip()
    pcall(function()
        local h, c = Hum(), Char()
        if h and OrigHip ~= nil then h.HipHeight = OrigHip end
        if c and OrigSpeed ~= nil then c:SetAttribute("SpeedBoostExtra", OrigSpeed) end
    end)
    S.SilentSteps = false
    pcall(ApplySilentSteps)
    pcall(StopSpectate)
    pcall(RestoreBypass)
    for box in pairs(HonchoMarks) do pcall(UnmarkHoncho, box) end
    pcall(ClearWaterPlatforms)
    pcall(RestoreDroneTriggers)
    S.AntiNoise = false
    pcall(ApplyAntiNoise)
    for _, k in ipairs({ "GodMode", "PositionSpoof", "CrouchSpoof", "VelocityManip", "InfCrucifix", "NoTouchDamage",
        "RemoveScreech", "RemoveHalt", "RemoveA90", "RemoveDread", "RemoveSurge",
        "NoScreechDamage", "NoHaltDamage", "NoA90Damage", "NoSurgeDamage", "MuteJammin", "MutePrompts" }) do
        S[k] = false
    end
    VelocityHeld = false
    S.DisableAnticheat = false
    pcall(ApplyAnticheat)
    pcall(RestoreSpoofVisual)
    pcall(RestoreThirdParts)
    if VelBody then pcall(function() VelBody:Destroy() end) end
    local mg = MainGameModule
    if mg and ToolOffsetSet then pcall(function() mg.tooloffset = Vector3.zero end) end
    pcall(function() local h = Hum(); if h and OrigSpeed ~= nil then h.WalkSpeed = GameSpeed() end end)
    pcall(ApplyPositionSpoof)
    pcall(RestoreTouchDamage)
    pcall(ApplyFakeRemotes)
    pcall(ApplyRemovals)
    pcall(ApplyAudio)
    for s, vol in pairs(StepMuted) do
        if s.Parent then pcall(function() s.Volume = vol end) end
    end
    for _, k in ipairs({ "SkipCutscenes", "NoGlitchScare", "NoTimothyScare", "NoVoidScare", "NoEntityScares",
        "NoHideVignette", "NoFiredamp", "SeeThroughHiding", "ThirdPerson", "NoBobbing" }) do
        S[k] = false
    end
    pcall(ApplyModuleToggles)
    pcall(RestoreFiredamp)
    if OxygenGui then pcall(function() OxygenGui:Destroy() end) end
    if OverlayGui then pcall(function() OverlayGui:Destroy() end) end
    S.AutoRooms = false
    pcall(function() RoomsNodes:Destroy() end)
    pcall(function() PathFolder:Destroy() end)
    S.AutoMinecart, S.RemoveSeekTrigger, S.InfiniteItems = false, false, false
    pcall(RestoreInfFakes)
    pcall(function() PromptPark:Destroy() end)
    pcall(UnhookMinecart)
    pcall(RemoveSeekWalkways)
    S.KnobFarm = false
    for model, pivot in pairs(MovedAway) do
        if model.Parent then pcall(function() model:PivotTo(pivot) end) end
    end
    for part, old in pairs(HideTransparency) do
        if part.Parent then pcall(function() part.Transparency = old end) end
    end
    local mg = MainGameModule
    if mg and BobBackup ~= nil then pcall(function() mg.spring.Speed = BobBackup end) end
    if AmbientBackup then
        pcall(function()
            Lighting.Ambient = AmbientBackup.A
            Lighting.OutdoorAmbient = AmbientBackup.O
        end)
    end
    if ClockGui then pcall(function() ClockGui:Destroy() end) end
    for part, old in pairs(PhysBackup) do
        if part.Parent then pcall(function() part.CustomPhysicalProperties = old or nil end) end
    end
    for p, b in pairs(PromptBackup) do
        if p.Parent then pcall(function() p.MaxActivationDistance = b.Dist; p.RequiresLineOfSight = b.LOS end) end
    end
    S.AntiAFK = false
    pcall(ApplyIdleKick)
    if HasteGui then pcall(function() HasteGui:Destroy() end) end
    S.Aura, S.Rainbow = false, false
    ApplyAura()
    pcall(SetCursor, false)
    DestroyInterface()
    getgenv().Sm1lerHubLoaded = nil
    getgenv().Sm1lerHubUnload = nil
end

--=========================================================--
--  START
--=========================================================--

BuildInterface()
ApplyFeatureState()
if S.SilentSteps then pcall(ApplySilentSteps) end
if S.AntiNoise then pcall(ApplyAntiNoise) end
if S.PositionSpoof then task.delay(1, function() pcall(ApplyPositionSpoof) end) end

task.spawn(function()
    task.wait(0.8)
    Notify(HUB_NAME .. " v" .. HUB_VERSION, string.format(T("Loaded with %s"), Config.UILibrary) .. " | " .. Device.Name, 6)
end)

if IsOwner then
    task.spawn(function()
        task.wait(2)
        Notify("👑 Welcome back, boss!", HUB_NAME .. " recognized its owner: " .. OWNER_NAME, 9)
        task.wait(2.4)
        Notify("⭐ Owner privileges unlocked", "The private Owner Panel tab is now available only for you.", 9)
        task.wait(2.4)
        Notify("💜 Enjoy your own hub", "Sm1ler Hub v" .. HUB_VERSION .. " - have a legendary run!", 9)
        task.wait(1)
        SendCaption("Owner " .. OWNER_NAME .. " has joined the run")
    end)
end

print("========================================")
print("  " .. HUB_NAME .. " v" .. HUB_VERSION .. " " .. HUB_AUTHOR)
print("  UI: " .. Config.UILibrary .. " | Lang: " .. Config.Language .. " | Device: " .. Device.Name)
if IsOwner then print("  OWNER MODE: " .. OWNER_NAME) end
print("========================================")

end, function(e)
    local trace = ""
    pcall(function()
        if debug and debug.traceback then trace = debug.traceback() end
    end)
    return tostring(e) .. (trace ~= "" and ("\n" .. trace) or "")
end)

if not Sm1lerOk then
    warn("[Sm1ler Hub] failed to start:\n" .. tostring(Sm1lerErr))
    getgenv().Sm1lerHubLoaded = nil
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Sm1ler Hub - error",
            Text = string.sub(tostring(Sm1lerErr), 1, 180) .. " (full text in F9 console)",
            Duration = 20,
        })
    end)
end
