-- Path beams (Seek chase / Eyestalk chase) ---------------------------------
PathFolder = Instance.new("Folder")
PathFolder.Name = "Sm1lerHub_Paths"
PathFolder.Parent = Workspace
PathBeams = { Seek = {}, Eyestalk = {} }

function AddPathBeam(kind, fromPos, toPos)
    local a = Instance.new("Part")
    a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch = true, false, false, false
    a.Transparency = 1
    a.Size = Vector3.one
    a.Position = fromPos
    a.Parent = PathFolder
    local b = a:Clone()
    b.Position = toPos
    b.Parent = PathFolder
    local beam = Instance.new("Beam")
    beam.Attachment0 = Instance.new("Attachment", a)
    beam.Attachment1 = Instance.new("Attachment", b)
    beam.FaceCamera = true
    beam.Width0, beam.Width1 = 0.25, 0.25
    beam.Brightness = 10
    beam.LightInfluence, beam.LightEmission = 0, 0
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 110))
    beam.Parent = PathFolder
    table.insert(PathBeams[kind], beam)
    return beam
end

function UpdatePathBeams()
    for kind, list in pairs(PathBeams) do
        local on = (kind == "Seek" and S.ShowSeekPath) or (kind == "Eyestalk" and S.ShowEyestalkPath)
        local alpha = on and 0 or 1
        for _, beam in ipairs(list) do
            if beam.Parent then beam.Transparency = NumberSequence.new(alpha) end
        end
    end
end
Loop(0.5, UpdatePathBeams)

-- Auto steer minecart (Mines Seek chase) ------------------------------------
-- The track is a folder "RunnerNodes" of parts named MinecartNode1, 2, 3 ...
-- Nodes marked "ForceConnect" are junctions: the next safe node (no DeathType
-- in the next 20 nodes) decides whether to steer Left / Right / Straight.
-- "DuckBoard" parts are low beams: you crouch while one is close.
TurnNodes, DuckBoards = {}, {}
function NodeId(node)
    return tonumber((string.gsub(node.Name, "^MinecartNode", "")))
end
function IsBehind(a, b)
    local front = (a.CFrame + a.CFrame.LookVector).Position
    local back = (a.CFrame - a.CFrame.LookVector).Position
    return (front - b.Position).Magnitude > (back - b.Position).Magnitude
end
function TurnDirection(a, b)
    local side = a.CFrame.RightVector:Dot(a.Position - b.Position)
    if side > 0.5 then return IsBehind(a, b) and "Right" or "Left" end
    if side < -0.5 then return IsBehind(a, b) and "Left" or "Right" end
    return "Straight"
end
function ScanRunnerNodes(folder)
    task.spawn(function()
        local unsafe = {}
        for _, node in ipairs(folder:GetChildren()) do
            local id = NodeId(node)
            if id then
                if node:GetAttribute("DeathType") then unsafe[node] = true end
                for i = 1, 20 do
                    local ahead = folder:FindFirstChild("MinecartNode" .. (id + i))
                    if ahead and ahead:GetAttribute("DeathType") ~= nil then unsafe[node] = true break end
                end
                local prev = folder:FindFirstChild("MinecartNode" .. (id - 1))
                if prev and prev:GetAttribute("ForceConnect") then unsafe[node] = nil end
            end
        end
        for _, node in ipairs(folder:GetChildren()) do
            local id = NodeId(node)
            if id and node:GetAttribute("ForceConnect") and node:IsA("BasePart") then
                local best, bestD
                for _, other in ipairs(folder:GetChildren()) do
                    local oid = NodeId(other)
                    if other ~= node and oid and oid > id and not unsafe[other] and other:IsA("BasePart") then
                        local d = (node.Position - other.Position).Magnitude
                        if not bestD or d < bestD then best, bestD = other, d end
                    end
                end
                if best then
                    node:SetAttribute("Sm1lerTurn", TurnDirection(node, best))
                    table.insert(TurnNodes, node)
                end
            end
        end
    end)
end
task.spawn(function()
    local r = Workspace:WaitForChild("CurrentRooms", 60)
    if not r or not HubAlive then return end
    local function check(d)
        if d.Name == "RunnerNodes" then ScanRunnerNodes(d)
        elseif d.Name == "DuckBoard" then table.insert(DuckBoards, d) end
    end
    for _, d in ipairs(r:GetDescendants()) do check(d) end
    Connect(r.DescendantAdded, function(d) task.defer(check, d) end)
end)

function NearestTurnNode()
    local root = HRP()
    if not root then return nil end
    local turnDist = tonumber(S.MinecartTurn) or 30
    local best, bestD
    for i = #TurnNodes, 1, -1 do
        local node = TurnNodes[i]
        if not node.Parent then
            table.remove(TurnNodes, i)
        else
            local d = (node.Position - root.Position).Magnitude
            if d < turnDist and (not bestD or d < bestD) then best, bestD = node, d end
        end
    end
    return best
end
function DuckBoardNear()
    local root = HRP()
    if not root then return false end
    local duckDist = tonumber(S.MinecartDuck) or 30
    for i = #DuckBoards, 1, -1 do
        local b = DuckBoards[i]
        if not b.Parent then
            table.remove(DuckBoards, i)
        else
            local p = PartPos(b)
            if p and (p - root.Position).Magnitude < duckDist then return true end
        end
    end
    return false
end

-- steering goes through the player's move vector, so the game's own minecart
-- controls turn the cart; crouching uses the game's camera module
MinecartControls, MinecartOriginalMove, MinecartDucked = nil, nil, false
function HookMinecartControls()
    if MinecartControls or not require then return end
    pcall(function()
        local pm = LocalPlayer:WaitForChild("PlayerScripts", 5):WaitForChild("PlayerModule", 5)
        local controls = require(pm):GetControls()
        MinecartOriginalMove = controls.GetMoveVector
        controls.GetMoveVector = function(...)
            if HubAlive and S.AutoMinecart and InMinecart() then
                local node = NearestTurnNode()
                if node then
                    local turn = node:GetAttribute("Sm1lerTurn")
                    if turn == "Left" then return Vector3.new(-1, 0, 0) end
                    if turn == "Right" then return Vector3.new(1, 0, 0) end
                    return Vector3.zero
                end
            end
            return MinecartOriginalMove(...)
        end
        MinecartControls = controls
    end)
end
Loop(0.1, function()
    if not S.AutoMinecart then return end
    HookMinecartControls()
    local mg = GetMainGame()
    if not mg or not mg.crouch then return end
    local want = InMinecart() and DuckBoardNear()
    if want and not MinecartDucked then
        pcall(mg.crouch, true)
        MinecartDucked = true
    elseif not want and MinecartDucked then
        pcall(mg.crouch, false)
        MinecartDucked = false
    end
end)
function UnhookMinecart()
    if MinecartControls and MinecartOriginalMove then
        MinecartControls.GetMoveVector = MinecartOriginalMove
    end
    MinecartControls = nil
end

-- Seek path: the game puts "SeekGuidingLight" parts in a "PathLights" folder
-- one after another along the correct route; each new light is linked to the
-- previous one, so the line follows the route in order
SeekFolders = setmetatable({}, { __mode = "k" })
function TrackPathLights(folder)
    if SeekFolders[folder] then return end
    local state = { Last = nil, Seen = {} }
    SeekFolders[folder] = state
    local function link(light)
        if light.Name ~= "SeekGuidingLight" or not light:IsA("BasePart") or state.Seen[light] then return end
        state.Seen[light] = true
        if state.Last then AddPathBeam("Seek", state.Last, light.Position) end
        state.Last = light.Position
        UpdatePathBeams()
    end
    for _, light in ipairs(folder:GetChildren()) do link(light) end
    Connect(folder.ChildAdded, function(light)
        task.wait()
        link(light)
    end)
end
task.spawn(function()
    local r = Workspace:WaitForChild("CurrentRooms", 60)
    if not r or not HubAlive then return end
    for _, d in ipairs(r:GetDescendants()) do
        if d.Name == "PathLights" then TrackPathLights(d) end
    end
    Connect(r.DescendantAdded, function(d)
        if d.Name == "PathLights" then TrackPathLights(d) end
    end)
end)

-- Eyestalk path: when an Eyestalk room loads, a path from you to its exit
-- is computed and drawn (retried until one is found)
EyestalkDone = setmetatable({}, { __mode = "k" })
function TraceEyestalk(room)
    if EyestalkDone[room] then return end
    EyestalkDone[room] = true
    task.spawn(function()
        local exit = room:WaitForChild("RoomExit", 30)
        while HubAlive and exit and room.Parent do
            if S.ShowEyestalkPath then
                local root = HRP()
                if root then
                    local path = PathfindingService:CreatePath({
                        AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 2, AgentRadius = 1, AgentHeight = 1,
                    })
                    local ok = pcall(function() path:ComputeAsync(root.Position, exit.Position) end)
                    if ok and path.Status == Enum.PathStatus.Success then
                        local points = path:GetWaypoints()
                        for k = 1, #points - 1 do
                            AddPathBeam("Eyestalk", points[k].Position, points[k + 1].Position)
                        end
                        UpdatePathBeams()
                        return
                    end
                end
            end
            task.wait(0.25)
        end
    end)
end
task.spawn(function()
    local r = Workspace:WaitForChild("CurrentRooms", 60)
    if not r or not HubAlive then return end
    local function check(room)
        local raw = room:GetAttribute("RawName")
        if raw and string.find(raw, "Eyestalk", 1, true) then TraceEyestalk(room) end
    end
    for _, room in ipairs(r:GetChildren()) do check(room) end
    Connect(r.ChildAdded, function(room)
        task.wait(0.5)
        check(room)
    end)
end)

-- Auto complete Dam Seek (Mines, room 200): teleport to each water pump,
-- top one first, and turn its valve until it is done
PumpBusy = false
function CompleteDamPumps()
    if PumpBusy then return end
    local _, n = CurrentRoom()
    if CurrentFloor() ~= "Mines" or n < 100 then
        Notify(HUB_NAME, T("You must be in the Mines near room 200 to do this."), 5)
        return
    end
    PumpBusy = true
    task.spawn(function()
        local inCutscene = false
        local rf = RemoteFolder()
        local cutRemote = rf and rf:FindFirstChild("Cutscene")
        local conn
        if cutRemote then
            conn = cutRemote.OnClientEvent:Connect(function()
                inCutscene = true
                task.delay(7, function() inCutscene = false end)
            end)
        end
        Notify(HUB_NAME, T("Completing the water pumps, please wait."), 5)
        local done = {}
        local t0 = tick()
        while HubAlive and tick() - t0 < 180 do
            local best, bestY = nil, -math.huge
            local r = Rooms()
            if r then
                for _, d in ipairs(r:GetDescendants()) do
                    if d.Name == "WaterPump" and d:IsA("Model") and not done[d] and d.PrimaryPart then
                        WatchObjective(d)
                        local prompt = d:FindFirstChild("ValvePrompt", true)
                        if d:GetAttribute("Sm1lerUsed") then
                            done[d] = true
                        elseif prompt and prompt.Enabled and d.PrimaryPart.Position.Y > bestY then
                            best, bestY = d, d.PrimaryPart.Position.Y
                        elseif not prompt or not prompt.Enabled then
                            done[d] = true
                        end
                    end
                end
            end
            if not best then break end
            local p0 = tick()
            while HubAlive and tick() - p0 < 20 do
                if not inCutscene then
                    local c = Char()
                    if c then pcall(function() c:PivotTo(best:GetPivot()) end) end
                    local prompt = best:FindFirstChild("ValvePrompt", true)
                    if best:GetAttribute("Sm1lerUsed") or not prompt or not prompt.Enabled then break end
                    FirePrompt(prompt)
                end
                task.wait(0.1)
            end
            done[best] = true
        end
        if conn then conn:Disconnect() end
        Notify(HUB_NAME, T("Water pumps completed."), 5)
        PumpBusy = false
    end)
end

-- Auto complete Cringle: teleport straight onto the quest exit
function CompleteCringle()
    local r = Rooms()
    local exit = r and r:FindFirstChild("RippleExitDoor", true)
    local c = Char()
    if exit and c then
        pcall(function() c:PivotTo(exit:GetPivot()) end)
    else
        Notify(HUB_NAME, T("The Cringle exit was not found."), 4)
    end
end

-- Remove basement gate / paintings door / skeleton door: moved far away
-- while on and put back where they were when off
MOVE_AWAY = { ThingToOpen = "RemoveBasementGate", MovingDoor = "RemovePaintingsDoor", Wax_Door = "RemoveSkeletonDoor" }
MovedAway = setmetatable({}, { __mode = "k" }) -- model -> original pivot
Loop(1, function()
    local r = Rooms()
    if r then
        local _, n = CurrentRoom()
        for i = n - 1, n + 2 do
            local room = r:FindFirstChild(tostring(i))
            if room then
                for _, d in ipairs(room:GetDescendants()) do
                    local key = MOVE_AWAY[d.Name]
                    if key and d:IsA("Model") and S[key] and not MovedAway[d] then
                        MovedAway[d] = d:GetPivot()
                        pcall(function() d:PivotTo(CFrame.new(-10000, -10000, -10000)) end)
                    end
                end
            end
        end
    end
    for model, pivot in pairs(MovedAway) do
        local key = MOVE_AWAY[model.Name]
        if not model.Parent then
            MovedAway[model] = nil
        elseif key and not S[key] then
            pcall(function() model:PivotTo(pivot) end)
            MovedAway[model] = nil
        end
    end
end)

-- Knob farm: dies and revives over and over to earn knobs from gold.
-- Collect gold in room 0 first, then press "Start knob farm".
KnobStarted, KnobBusy = false, false
function StartKnobFarm()
    local _, n = CurrentRoom()
    if n ~= 0 then
        Notify(HUB_NAME, T("You must be in room 0 to use this."), 4)
        return
    end
    local ok, gold = pcall(function()
        return LocalPlayer.PlayerGui.TopbarUI.Topbar.StatsTopbarHandler.StatModules.Gold.GoldVal.Value
    end)
    if ok and tonumber(gold) and gold <= 0 then
        Notify(HUB_NAME, T("You need some gold to do this."), 4)
        return
    end
    KnobStarted = true
    Notify(HUB_NAME, T("Knob farm started."), 4)
end
Loop(0.2, function()
    if not S.KnobFarm then KnobStarted = false return end
    if not KnobStarted or KnobBusy then return end
    KnobBusy = true
    task.spawn(function()
        pcall(function()
            if replicatesignal then
                pcall(replicatesignal, LocalPlayer.Kill)
            else
                local h = Hum()
                if h then h.Health = 0 end
            end
            local t0 = tick()
            repeat task.wait(0.1) until LocalPlayer:GetAttribute("Alive") or not S.KnobFarm or tick() - t0 > 60
            local rf = RemoteFolder()
            local stats = rf and rf:FindFirstChild("Statistics")
            if stats then stats:FireServer() end
            task.wait(0.25)
        end)
        KnobBusy = false
    end)
end)

--=========================================================--
--  HUD OVERLAY
--=========================================================--

DestroyHUD = nil
do
    local HudGui, HudLabels = nil, {}
    DestroyHUD = function()
        if HudGui then pcall(function() HudGui:Destroy() end) end
        HudGui, HudLabels = nil, {}
    end
    local function BuildHUD()
        DestroyHUD()
        local gui = Instance.new("ScreenGui")
        gui.Name = "Sm1lerHub_HUD"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 9999
        local holder = Instance.new("Frame")
        holder.AnchorPoint = Vector2.new(0.5, 0)
        holder.Position = UDim2.new(0.5, 0, 0, IsTouch and 6 or 12)
        holder.Size = UDim2.new(0, IsTouch and 250 or 330, 0, 0)
        holder.AutomaticSize = Enum.AutomaticSize.Y
        holder.BackgroundTransparency = 1
        holder.Parent = gui
        local list = Instance.new("UIListLayout")
        list.HorizontalAlignment = Enum.HorizontalAlignment.Center
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Padding = UDim.new(0, 2)
        list.Parent = holder
        local function Row(order, color)
            local tl = Instance.new("TextLabel")
            tl.BackgroundTransparency = 1
            tl.Size = UDim2.new(1, 0, 0, IsTouch and 16 or 18)
            tl.Font = Enum.Font.GothamBold
            tl.TextSize = IsTouch and 13 or 14
            tl.TextStrokeTransparency = 0.35
            tl.TextColor3 = color
            tl.Text = ""
            tl.LayoutOrder = order
            tl.Parent = holder
            return tl
        end
        HudLabels.Title  = Row(1, Color3.fromRGB(196, 181, 253))
        HudLabels.Door   = Row(2, Color3.fromRGB(226, 232, 240))
        HudLabels.Status = Row(3, Color3.fromRGB(148, 163, 184))
        HudLabels.Danger = Row(4, Color3.fromRGB(255, 90, 90))
        HudLabels.Title.Text = HUB_NAME .. " " .. HUB_AUTHOR
        gui.Parent = GuiParent()
        HudGui = gui
    end
    Loop(0.4, function()
        if not S.HUD then
            if HudGui then DestroyHUD() end
            return
        end
        if not HudGui or not HudGui.Parent then BuildHUD() end
        local _, n = CurrentRoom()
        if HudLabels.Door then
            HudLabels.Door.Text = string.format(T("Door %d / %d"), n, FINAL_DOOR) .. "  |  " .. CurrentFloor()
        end
        if HudLabels.Status then
            local godTxt = (S.GodMode or S.PositionSpoof) and "ON" or "OFF"
            local farmTxt = Farm.Running and "ON" or "OFF"
            HudLabels.Status.Text = "God Mode: " .. godTxt .. "  |  " .. T("Auto Farm") .. ": " .. farmTxt
        end
        if HudLabels.Danger then
            local d = DangerNow()
            HudLabels.Danger.Text = d and ("⚠ " .. (ENTITY_ALIAS[d.Name] or d.Name)) or ""
        end
    end)
end

--=========================================================--
--  OWNER EXTRAS
--=========================================================--

AuraHL, RainbowConn = nil
function ApplyAura()
    if S.Aura or S.Rainbow then
        if not AuraHL or not AuraHL.Parent then
            AuraHL = Instance.new("Highlight")
            AuraHL.FillColor = Color3.fromRGB(255, 200, 40)
            AuraHL.OutlineColor = Color3.fromRGB(255, 255, 200)
            AuraHL.FillTransparency = 0.35
            AuraHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            AuraHL.Parent = GuiParent()
        end
        AuraHL.Adornee = Char()
    elseif AuraHL then
        pcall(function() AuraHL:Destroy() end)
        AuraHL = nil
    end
    if S.Rainbow and not RainbowConn then
        local t = 0
        RainbowConn = RunService.Heartbeat:Connect(function(dt)
            t = (t + dt * 0.35) % 1
            if AuraHL then AuraHL.FillColor = Color3.fromHSV(t, 1, 1) end
        end)
    elseif not S.Rainbow and RainbowConn then
        RainbowConn:Disconnect()
        RainbowConn = nil
        if AuraHL then AuraHL.FillColor = Color3.fromRGB(255, 200, 40) end
    end
end

Connect(LocalPlayer.CharacterAdded, function(c)
    task.spawn(BindCharacter, c)
    task.wait(0.8)
    if S.Fly then StartFly() end
    ApplyAura()
end)

--=========================================================--
--  CONFIGS
--=========================================================--

function ListConfigs()
    local out = {}
    if CanFS and listfiles then
        EnsureFolders()
        pcall(function()
            for _, f in ipairs(listfiles(CFG_DIR)) do
                local name = string.match(f, "([^/\\]+)%.json$")
                if name then table.insert(out, name) end
            end
        end)
    end
    if #out == 0 then out = { "default" } end
    return out
end

function ApplyFeatureState()
    if S.Fly then StartFly() else StopFly() end
    if S.GodMode then S.PositionSpoof = true end
    if S.GodMode then pcall(ApplyGodMode) else pcall(ApplyPositionSpoof) end
    pcall(ApplyFakeRemotes)
    pcall(SyncExtra)
    pcall(ApplySilentSteps)
    pcall(ApplyAntiNoise)
    pcall(ApplyIdleKick)
    ApplyAura()
end

--=========================================================--
--  INTERFACE
--=========================================================--

BuildInterface = nil
Reloading = false

function DestroyInterface()
    if UI and UI.Destroy then pcall(UI.Destroy, UI) end
    UI = nil
    StatusLabel, ProgressLabel, TimeLabel, FarmToggleRef = nil, nil, nil, nil
end

function ReloadInterface(message)
    if Reloading then return end
    Reloading = true
    task.spawn(function()
        DestroyInterface()
        task.wait(0.7)
        BuildInterface()
        Reloading = false
        if message then Notify(HUB_NAME, message, 4) end
    end)
end

-- small builder helpers
function Tog(g, text, key, desc, after)
    local ref = g:Toggle({
        Text = T(text), Desc = desc and T(desc) or nil, Default = S[key],
        Callback = function(v)
            if S[key] == v then return end
            S[key] = v
            Persist()
            if after then after(v) end
        end,
    })
    TogRefs[key] = ref
    return ref
end

function Multi(g, text, key, values, desc)
    g:MultiDropdown({
        Text = T(text), Desc = desc and T(desc) or nil, Values = values, Default = S[key],
        Callback = function(set)
            S[key] = set
            Persist()
        end,
    })
end

function Sld(g, text, key, min, max, step, desc)
    g:Slider({
        Text = T(text), Desc = desc and T(desc) or nil, Min = min, Max = max, Step = step or 1, Default = S[key],
        Callback = function(v)
            v = tonumber(v) or S[key]
            S[key] = v
            Persist()
        end,
    })
end

function BuildInterface()
    local libName = LIBS[Config.UILibrary] and Config.UILibrary or "WindUI"
    local lib = LoadLib(libName)
    if not lib and libName ~= "WindUI" then
        SystemNotify("Could not load " .. libName .. " - falling back to Wind UI.")
        libName = "WindUI"
        Config.UILibrary = "WindUI"
        SaveConfig()
        lib = LoadLib("WindUI")
    end
    if not lib then
        SystemNotify("Could not load any UI library. Check your executor HTTP support.")
        return
    end

    local ok, adapter = pcall(Adapters[libName], lib)
    if not ok or not adapter then
        SystemNotify("Failed to build " .. libName .. ": " .. tostring(adapter))
        return
    end
    UI = adapter

    ------------------------------------------------------------ AUTO FARM
    local farmTab = UI:Tab(T("Auto Farm"), "footprints")
    if farmTab then
