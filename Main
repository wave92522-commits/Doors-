-- Adonis: destroy the admin loader so it cannot kick / ban us
Loop(2, function()
    if not Extra.AdonisBypass then return end
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local core = game:GetService("CoreGui")
        for _, name in ipairs({ "Adonis_Loader", "AntiInject", "AdonisAdmin" }) do
            local g = core:FindFirstChild(name, true) or (pg and pg:FindFirstChild(name, true))
            if g then pcall(function() g:Destroy() end) end
        end
    end)
end)




-- Silent footsteps: the game reports footsteps through a remote; while this is
-- on, the real remote is parked under another name and a local decoy takes its
-- place, so Figure cannot hear you. Turning it off puts the real one back.
STEP_REMOTE = "FootstepRemoteThatWeNeed"
ParkedStepRemote, StepDecoy = nil
function ApplySilentSteps()
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    if not rf then return end
    if S.SilentSteps then
        if ParkedStepRemote then return end
        local real = rf:FindFirstChild(STEP_REMOTE)
        if not real then return end
        ParkedStepRemote = real
        real.Name = STEP_REMOTE .. "_Sm1ler"
        StepDecoy = Instance.new("RemoteEvent")
        StepDecoy.Name = STEP_REMOTE
        StepDecoy.Parent = rf
    elseif ParkedStepRemote then
        if StepDecoy then pcall(function() StepDecoy:Destroy() end) end
        pcall(function() ParkedStepRemote.Name = STEP_REMOTE end)
        ParkedStepRemote, StepDecoy = nil, nil
    end
end

