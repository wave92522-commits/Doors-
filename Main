}
CLOSET_SET = {}
for name in pairs(HIDING_LABEL) do CLOSET_SET[name] = true end

function DangerNow()
    local hrp = HRP()
    for name in pairs(DANGER) do
        local e = Workspace:FindFirstChild(name)
        if e then
            local p = PartPos(e)
            if not hrp or not p or (p - hrp.Position).Magnitude < 1200 then return e end
        end
    end
    return nil
end

-- closets that can be used right now: they have a working HidePrompt and
-- nobody is inside (HiddenPlayer is empty), nearest first
function FreeClosets(skip)
    local hrp = HRP()
    local r = Rooms()
    if not hrp or not r then return {} end
    local list = {}
    local _, n = CurrentRoom()
    for i = n - 2, n + 2 do
        local room = r:FindFirstChild(tostring(i))
        if room then
            for _, d in ipairs(room:GetDescendants()) do
                if d:IsA("Model") and CLOSET_SET[d.Name] and not (skip and skip[d]) then
                    local prompt = d:FindFirstChild("HidePrompt", true)
                    local occupant = d:FindFirstChild("HiddenPlayer", true)
                    local p = PartPos(d)
                    if prompt and prompt.Enabled and p and p.Y > -10
                        and not (occupant and occupant:IsA("ObjectValue") and occupant.Value) then
                        table.insert(list, { Model = d, Prompt = prompt, Dist = (p - hrp.Position).Magnitude })
                    end
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.Dist < b.Dist end)
    return list
end

function NearestCloset()
    local list = FreeClosets()
    return list[1] and list[1].Model or nil
end

function IsHiding()
    local c = Char()
    return c ~= nil and c:GetAttribute("Hiding") == true
end

HidingIn = nil
HidingNow = false -- true while the hub is moving you into a closet
-- tries up to 3 closets and only reports success once the game really says
-- you are hiding (the Hiding attribute), instead of hoping the prompt worked
function HideInCloset()
    if IsHiding() then return true end
    local tried = {}
    HidingNow = true
    for _ = 1, 3 do
        local entry = FreeClosets(tried)[1]
        if not entry then break end
        tried[entry.Model] = true
        RawTP(PartPos(entry.Model) + Vector3.new(0, -1, 0))
        for _ = 1, 8 do
            FirePrompt(entry.Prompt)
            task.wait(0.15)
            if IsHiding() then
                HidingIn = entry.Model
                HidingNow = false
                return true
            end
        end
    end
    HidingNow = false
    return false
end

function ExitHiding()
    -- the game leaves a closet through its CamLock remote
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    local camLock = rf and rf:FindFirstChild("CamLock")
    if camLock then pcall(function() camLock:FireServer() end) end
    local h = Hum()
    if h then h.Jump = true end
    if HidingIn then
        local prompt = HidingIn:FindFirstChild("HidePrompt", true)
        if prompt and prompt.Enabled then FirePrompt(prompt) end
    end
    HidingIn = nil
end

-- next unopened door (lowest room number >= LatestRoom whose Door is not Open)
function NextClosedDoor()
    local r = Rooms()
    if not r then return nil end
    local _, start = CurrentRoom()
    local best, bestN = nil, math.huge
    for _, room in ipairs(r:GetChildren()) do
        local n = tonumber(room.Name)
        if n and n >= start and n < bestN then
            local door = room:FindFirstChild("Door")
            if door and door:GetAttribute("Open") ~= true then
                best, bestN = door, n
            end
        end
    end
    return best
end

function TpNextDoor()
    local door, c = NextClosedDoor(), Char()
    if door and c then
        pcall(function() c:PivotTo(door:GetPivot()) end)
        return true
    end
    return false
end

function InSeekChase()
    return Workspace:FindFirstChild("SeekMoving") ~= nil
end

function ClearSeekObstacles(room)
    if not room then return end
    for _, d in ipairs(room:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = string.lower(d.Name)
            if string.find(n, "seek_arm", 1, true) or string.find(n, "seekarm", 1, true)
                or string.find(n, "chandelierobstruction", 1, true) or string.find(n, "seek_fire", 1, true)
                or string.find(n, "obstruct", 1, true) then
                d.CanTouch = false
                d.CanCollide = false
            end
        end
    end
end

-- notifications + auto hide
Seen = setmetatable({}, { __mode = "k" })
function OnEntity(obj)
    if not ENTITY_SET[obj.Name] or Seen[obj] then return end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    Seen[obj] = true
    local alias = ENTITY_ALIAS[obj.Name] or obj.Name
    -- far-away entities (another part of the map) are not announced
    local hrp, p = HRP(), PartPos(obj)
    if hrp and p and (p - hrp.Position).Magnitude >= 10000 then return end
    if S.EntityNotify and not S.EntityNotifyIgnore[alias] then
        local hint = ENTITY_HINT[obj.Name] or T("Entity has spawned - be careful!")
        local icon, shown = ENTITY_ICON[obj.Name], alias
        -- Rush variants: the main part is named after the variant and its
        -- particle texture is the variant's face
        if obj.Name == "RushMoving" and obj:IsA("Model") then
            local main = obj.PrimaryPart
            if main and main.Name ~= "RushNew" and main.Name ~= "RushMoving" then
                shown = main.Name
                local att = main:FindFirstChild("Attachment")
                local pe = att and att:FindFirstChildWhichIsA("ParticleEmitter")
                if pe and pe.Texture ~= "" then icon = pe.Texture end
            end
        end
        alias = shown
        Notify("⚠ " .. alias, hint, 6, icon, true)
        if S.ChatAlerts then
            local msg = (type(S.ChatMessage) == "string" and S.ChatMessage ~= "") and S.ChatMessage or "spawned!"
            SendChat(alias .. " " .. msg)
        end
    end
end

-- Auto closet: hide only when a dangerous entity actually gets close.
-- Trigger distances per entity (studs), tuned to how fast each one moves.
HIDE_DISTANCE = {
    RushMoving = 85, Scribbles = 100, BashMoving = 150, DronesStampede = 100,
    AmbushMoving = 150, A60 = 125, A120 = 85, GlitchRush = 90, GlitchAmbush = 175,
    BackdoorRush = 85, CustomEntity = 85,
}
HIDE_LIST = { "Rush", "Ambush", "Blitz", "Bash", "Drones Stampede", "Scribbles",
                    "A-60", "A-120", "AR0xMBUSH", "RNIUSHCG==" }

function NearestDanger()
    local hrp = HRP()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for name, limit in pairs(HIDE_DISTANCE) do
        local ignored = S.HideIgnore[ENTITY_ALIAS[name] or name]
        local e = not ignored and Workspace:FindFirstChild(name)
        if e then
            local p = PartPos(e)
            local d = p and (p - hrp.Position).Magnitude
            if d and d < limit and d < bestDist then best, bestDist = e, d end
        end
    end
    return best
end

-- spectate the entity while hidden
SpectateConn = nil
function StopSpectate()
    if SpectateConn then SpectateConn:Disconnect(); SpectateConn = nil end
    local cam, hum = Workspace.CurrentCamera, Hum()
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        if hum then cam.CameraSubject = hum end
    end
end
function StartSpectate(entity)
    if not S.SpectateEntity or not entity then return end
    StopSpectate()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    if S.SpectateMode == "Entity to Player" then
        local part = entity:IsA("BasePart") and entity or entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart", true)
        if part then cam.CameraSubject = part end
        SpectateConn = RunService.RenderStepped:Connect(function()
            if not entity.Parent then StopSpectate() end
        end)
    else
        cam.CameraType = Enum.CameraType.Scriptable
        SpectateConn = RunService.RenderStepped:Connect(function()
            local head = Char() and Char():FindFirstChild("Head")
            local p = PartPos(entity)
            if not entity.Parent or not head or not p then StopSpectate() return end
            cam.CFrame = CFrame.lookAt(head.Position + Vector3.new(0, 1.5, 0), p)
        end)
    end
end

AutoHiding = false
Loop(0.2, function()
    if not S.AutoHide or S.AutoFarm or AutoHiding then return end
    local danger = NearestDanger()
    if not danger then return end
    AutoHiding = true
    task.spawn(function()
        if HideInCloset() then
            StartSpectate(danger)
            local t0 = tick()
            while HubAlive and tick() - t0 < 60 do
                if not DangerNow() then
                    task.wait(1.5)
                    if not DangerNow() then break end
                end
                task.wait(0.25)
            end
            StopSpectate()
            ExitHiding()
        end
        AutoHiding = false
    end)
end)
Connect(Workspace.ChildAdded, OnEntity)
task.spawn(function()
    local r = Workspace:WaitForChild("CurrentRooms", 60)
    if r and HubAlive then Connect(r.DescendantAdded, OnEntity) end
end)
cam0 = Workspace.CurrentCamera
if cam0 then Connect(cam0.ChildAdded, OnEntity) end

-- cached dangerous objects for per-frame protection
Cache = { Eyes = nil, Screech = nil, Halt = nil }
Loop(0.25, function()
    local room = CurrentRoom()
    local cam = Workspace.CurrentCamera
    Cache.Eyes = S.AntiEyes and (Workspace:FindFirstChild("Eyes")
        or Workspace:FindFirstChild("Lookman")
        or Workspace:FindFirstChild("BackdoorLookman")
        or (room and (room:FindFirstChild("Eyes", true) or room:FindFirstChild("Lookman", true)))) or nil
    Cache.Screech = S.AntiScreech and ((cam and cam:FindFirstChild("Screech")) or Workspace:FindFirstChild("Screech")) or nil
    Cache.Halt = S.AntiHalt and (room and room:FindFirstChild("Halt", true)) or nil
    if S.SeekHelper and InSeekChase() then
        local r = Rooms()
        local _, n = CurrentRoom()
        if r then
            for i = n, n + 2 do ClearSeekObstacles(r:FindFirstChild(tostring(i))) end
        end
    end
    -- Snare: cannot trap you, and it is made visible (its dark pit is shown,
    -- the roots / base disguise is hidden) - the same as the original does
    if S.AntiSnare and room then
        for _, d in ipairs(room:GetDescendants()) do
            if d.Name == "Snare" and d:IsA("Model") and d.Parent and d.Parent.Name ~= "Snare" then
                for _, p in ipairs(d:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanTouch = false end
                end
                local inner = d:FindFirstChild("Snare")
                if inner then
                    local roots, base = inner:FindFirstChild("Roots"), inner:FindFirstChild("SnareBase")
                    if roots and roots:IsA("BasePart") then roots.Transparency = 1 end
                    if base and base:IsA("BasePart") then base.Transparency = 1 end
                end
                local pit = d:FindFirstChild("Void")
                if pit and pit:IsA("BasePart") then
                    pit.Transparency = 0
                    pit.Color = Color3.fromRGB(76, 67, 55)
                end
            end
        end
    end
end)

-- Halt warning: rooms that will spawn Halt are marked (RawName contains
-- "Halt" or the Shade attribute); you get told one room early
HaltWarned = setmetatable({}, { __mode = "k" })
task.spawn(function()
    local r = Workspace:WaitForChild("CurrentRooms", 60)
    if not r or not HubAlive then return end
    local function check(room)
        if HaltWarned[room] then return end
        local raw = room:GetAttribute("RawName")
        if (raw and string.find(tostring(raw), "Halt", 1, true)) or room:GetAttribute("Shade") == true then
            HaltWarned[room] = true
            if S.EntityNotify and not S.EntityNotifyIgnore["Halt"] then
                Notify("⚠ Halt", T("Halt will spawn in the next room."), 6, ENTITY_ICON.Halt, true)
                if S.ChatAlerts then SendChat("Halt next room!") end
            end
        end
    end
    for _, room in ipairs(r:GetChildren()) do check(room) end
    Connect(r.ChildAdded, function(room)
        task.wait(0.5)
        check(room)
    end)
end)

-- Delete Figure (needs isnetworkowner): Figure's parts that your game controls
-- are thrown far away. Mines: straight away. Fools / OldHotel: after the next
-- room loads, over and over while you still control them. Does not always work.
FigureRemoved = setmetatable({}, { __mode = "k" })
function RemoveFigure(fig)
    if FigureRemoved[fig] or not isnetworkowner then return end
    local floor = CurrentFloor()
    if floor ~= "Mines" and floor ~= "Fools" and floor ~= "OldHotel" then return end
    FigureRemoved[fig] = true
    task.spawn(function()
        if floor ~= "Mines" then
            local r = Rooms()
            if r then r.ChildAdded:Wait() end
        end
        for _, part in ipairs(fig:GetDescendants()) do
            if part:IsA("BasePart") then
                task.spawn(function()
                    if floor == "Mines" then
                        local ok, owner = pcall(isnetworkowner, part)
                        if ok and owner then part.Position = Vector3.new(-49999, -49999, -49999) end
                    else
                        part.CanCollide = false
                        while HubAlive and S.RemoveFigure and part.Parent do
                            local ok, owner = pcall(isnetworkowner, part)
                            if not ok or not owner then break end
                            part.Position = Vector3.new(math.random(-29999, 29999), math.random(-29999, 29999), math.random(-29999, 29999))
                            task.wait()
                        end
                    end
                end)
            end
        end
    end)
end
Loop(1, function()
    if not S.RemoveFigure then return end
    local r = Rooms()
    if not r then return end
    local _, n = CurrentRoom()
    for i = n - 1, n + 1 do
        local room = r:FindFirstChild(tostring(i))
        if room then
            for _, name in ipairs({ "Figure", "FigureRig", "FigureRagdoll" }) do
                local fig = room:FindFirstChild(name, true)
                if fig and fig:IsA("Model") then RemoveFigure(fig) end
            end
        end
    end
end)

-- Anti Eyes / Lookman, done the way Abysall does it.
-- WHY THE OLD ONE WAS BAD: it physically rotated YOUR camera away from Eyes,
-- which also turned your character around and made the game unplayable. The
-- original never touches the camera: it tells the SERVER you are looking down
-- (MotorReplication), so Eyes deals no damage while your view stays exactly
-- where you left it.
--  * normal floors  -> MotorReplication:FireServer(-650)
--  * Fools / OldHotel (old-style remote) -> FireServer(0, ±65, 0, false)
--  * Lookman is included: it is the Backdoor version of the same entity
function EyesActive()
    return Cache.Eyes ~= nil and Cache.Eyes.Parent ~= nil
end
LastMotorSend = 0
Connect(RunService.Heartbeat, function()
    if not S.AntiEyes or not EyesActive() then return end
    if tick() - LastMotorSend < 0.2 then return end
    LastMotorSend = tick()
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    local motor = rf and rf:FindFirstChild("MotorReplication")
    if not motor or not motor:IsA("RemoteEvent") then return end
    local floor = CurrentFloor()
    pcall(function()
        if floor == "Fools" or floor == "OldHotel" then
            motor:FireServer(0, (SpoofHigh and 65 or -65), 0, false)
        else
            motor:FireServer(-650)
        end
    end)
end)

-- Anti Screech: DOORS' Screech asks you to LOOK at it to survive, so here the
-- camera genuinely has to turn - but only for a moment and only when it is
-- actually spawned, instead of constantly fighting the player's mouse.
Connect(RunService.RenderStepped, function()
    local cam = Workspace.CurrentCamera
    local hrp = HRP()
    if not cam or not hrp then return end
    if Cache.Screech and Cache.Screech.Parent and S.AntiScreech then
        local p = PartPos(Cache.Screech)
        if p then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p) end
    end
    if Cache.Halt and Cache.Halt.Parent and S.AntiHalt then
        local p = PartPos(Cache.Halt)
        if p and (p - hrp.Position).Magnitude < 20 then
            local dir = (hrp.Position - p) * Vector3.new(1, 0, 1)
            if dir.Magnitude > 0 then hrp.CFrame = hrp.CFrame + dir.Unit * 4 end
        end
    end
end)

