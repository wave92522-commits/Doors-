function T(text)
    local tbl = L[Config.Language]
    return (tbl and tbl[text]) or text
end

--=========================================================--
--  DEVICE PROFILE
--=========================================================--

Camera = Workspace.CurrentCamera
Viewport = (Camera and Camera.ViewportSize) or Vector2.new(1280, 720)
IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
Small = Viewport.X <= 750 or Viewport.Y <= 500

Device = nil
if IsTouch and Small then
    Device = { Name = "Phone",  Size = UDim2.fromOffset(460, 390), Min = Vector2.new(380, 310), Max = Vector2.new(620, 560) }
elseif IsTouch then
    Device = { Name = "Tablet", Size = UDim2.fromOffset(570, 470), Min = Vector2.new(470, 390), Max = Vector2.new(760, 640) }
else
    Device = { Name = "PC",     Size = UDim2.fromOffset(700, 540), Min = Vector2.new(580, 430), Max = Vector2.new(950, 720) }
end

