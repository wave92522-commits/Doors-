-- things you need to finish a room
OBJECTIVE_LABEL = {
    ShoppingCart = "Package Deposit", StairwellFireAlarm = "Fire Alarm", SalvageChute = "Package Deposit",
    ArchivesPackageDeposit = "Box Deposit", Cellar = "Cellar", ArchivesFihTank = "Fih Tank",
