    FakeDoor = "Dupe", DoorFake = "Dupe", GloombatEgg = "Gloombat Eggs", GloomPile = "Gloombat Eggs",
}
ESP_ENTITY_LIST = { "Rush", "Bash", "Scribbles", "Teller", "Drones Stampede", "Creak", "Noise", "Balls",
    "Ambush", "Eyes", "Dupe", "Figure", "Blitz", "Lookman", "Snare", "Giggle", "Gloombat Eggs", "Grumble",
    "A-60", "A-120", "Sally", "Jeff the Killer", "Groundskeeper", "Mandrake Hole", "Monument", "Bramble",
    "AR0xMBUSH", "RNIUSHCG==" }
MAX_HIGHLIGHTS = 30

function GuiParent()
    if gethui then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

ESPFolder = nil
Tracked = {}

function Untrack(obj)
    local t = Tracked[obj]
    if not t then return end
    if t.HL then pcall(function() t.HL:Destroy() end) end
    if t.BB then pcall(function() t.BB:Destroy() end) end
    Tracked[obj] = nil
end

function ClearESP()
    for obj in pairs(Tracked) do Untrack(obj) end
end

function ESPCollect()
    local list = {}
    local function add(obj, kind, label)
        if obj and obj.Parent then table.insert(list, { Obj = obj, Kind = kind, Label = label }) end
    end
    local room, n = CurrentRoom()
    local function entityAllowed(label)
        return label and not S.EntityESPIgnore[label]
    end
    if S.EntityESP then
        for _, c in ipairs(Workspace:GetChildren()) do
            local label = ENTITY_ALIAS[c.Name]
            if ENTITY_SET[c.Name] and entityAllowed(label) then add(c, "Entity", label) end
        end
    end
    if S.PlayerESP then
        for _, p in ipairs(Players:GetPlayers()) do
            -- only living players (the game marks dead ones with Alive = false)
            if p ~= LocalPlayer and p.Character and p:GetAttribute("Alive") ~= false then
                add(p.Character, "Player", p.DisplayName)
            end
        end
    end
    -- dropped items lie in Workspace.Drops, outside the rooms
    if S.ItemESP then
        local drops = Workspace:FindFirstChild("Drops")
        if drops then
            for _, d in ipairs(drops:GetChildren()) do
                local label = ITEM_LABEL[d.Name] or (d.Name == "Green_Herb" and "Green Herb")
                if label then add(d, "Item", label) end
            end
        end
    end
    if S.DoorESP and room then
        local d = FindDoor(room)
        if d then add(d, "Door", "Door " .. tostring(n + 1)) end
    end
    local r = Rooms()
    if r then
        for i = n - 1, n + 1 do
            local rm = r:FindFirstChild(tostring(i))
            if rm then
                for _, d in ipairs(rm:GetDescendants()) do
                    if d:IsA("Model") then
                        local nm = d.Name
                        local espLabel = ENTITY_ALIAS[nm] or ESP_ENTITY_LABEL[nm]
                            or (string.find(nm, "GloombatEgg", 1, true) and "Gloombat Eggs")
                        if S.EntityESP and nm == "MandrakeLive" and entityAllowed("Mandrake Hole") then
                            add(d:FindFirstChild("Hole") or d, "Entity", "Mandrake Hole")
                        elseif S.EntityESP and espLabel and entityAllowed(espLabel) then add(d, "Entity", espLabel)
                        elseif S.ObjectiveESP and OBJECTIVE_LABEL[nm] then
                            local objLabel = ObjectiveLabel(d)
                            if objLabel then add(ObjectiveTarget(d), "Objective", objLabel) end
                        elseif S.ItemESP and nm == "KeyObtain" then add(d, "Key", "Key")
                        elseif S.ItemESP and nm == "LeverForGate" then add(d, "Lever", "Lever")
                        elseif S.ItemESP and ITEM_SET[nm] then add(d, "Item", ITEM_LABEL[nm] or nm)
                        elseif S.ItemESP and nm == "Green_Herb" then add(d, "Item", "Green Herb")
                        elseif S.GoldESP and nm == "GoldPile" then
                            local value = d:GetAttribute("GoldValue")
                            add(d, "Gold", value and ("Gold Pile [" .. tostring(value) .. "]") or "Gold Pile")
                        elseif S.GoldESP and nm == "StardustPickup" then add(d, "Gold", "Stardust Pile")
                        elseif S.ClosetESP and CLOSET_SET[nm] then add(d, "Closet", HIDING_LABEL[nm])
                        elseif S.ChestESP and (nm == "ChestBox" or nm == "ChestBoxLocked") then
                            add(d, "Chest", d:GetAttribute("Locked") and "Locked Chest" or "Chest")
                        elseif S.ChestESP and (nm == "Toolbox" or nm == "Toolbox_Locked") then
                            add(d, "Chest", d:GetAttribute("Locked") and "Locked Toolbox" or "Toolbox")
                        elseif S.ChestESP and CHEST_LABEL[nm] then add(d, "Chest", CHEST_LABEL[nm])
                        elseif S.ChestESP and MatchAny(nm, CHEST_KEYS) then add(d, "Chest", "Chest")
                        elseif S.LadderESP and MatchAny(nm, LADDER_KEYS) then add(d, "Ladder", "Ladder")
                        elseif S.ObstructESP and MatchAny(nm, OBSTRUCT_KEYS) then add(d, "Obstruction", nil)
                        elseif S.TriggerESP and MatchAny(nm, TRIGGER_KEYS) then add(d, "Trigger", nil)
                        elseif S.LightESP and string.find(string.lower(nm), "guidinglight", 1, true) then
                            add(d, "Light", "Guiding Light")
                        end
                    end
                end
            end
        end
    end
    return list
end

Loop(0.5, function()
    local any = S.EntityESP or S.DoorESP or S.ItemESP or S.GoldESP or S.ClosetESP or S.LightESP
        or S.ObjectiveESP or S.PlayerESP
        or S.ChestESP or S.LadderESP or S.ObstructESP or S.TriggerESP
    if not any then
        if next(Tracked) then ClearESP() end
        return
    end
    if not ESPFolder or not ESPFolder.Parent then
        ESPFolder = Instance.new("Folder")
        ESPFolder.Name = "Sm1lerHub_ESP"
        ESPFolder.Parent = GuiParent()
    end

    local list = ESPCollect()
    local hrp = HRP()
    for _, e in ipairs(list) do
        local p = PartPos(e.Obj)
        e.Dist = (hrp and p) and (p - hrp.Position).Magnitude or 1e9
    end
    table.sort(list, function(a, b)
        local pa, pb = ESP_PRIORITY[a.Kind], ESP_PRIORITY[b.Kind]
        if pa ~= pb then return pa < pb end
        return a.Dist < b.Dist
    end)

    -- ESP settings (sliders are 0-100 %)
    local fill = math.clamp((tonumber(S.ESPFill) or 75) / 100, 0, 1)
    local outline = math.clamp((tonumber(S.ESPOutline) or 0) / 100, 0, 1)
    local textT = math.clamp((tonumber(S.ESPTextAlpha) or 0) / 100, 0, 1)
    local strokeT = math.clamp((tonumber(S.ESPTextStroke) or 0) / 100, 0, 1)
    local fade = math.clamp((tonumber(S.ESPFade) or 25) / 100, 0, 1)
    local limit = tonumber(S.ESPRenderLimit) or 240
    local textSize = math.clamp(tonumber(S.ESPTextSize) or 20, 8, 40)
    local okFont, font = pcall(function() return Enum.Font[S.ESPFont] end)
    if not okFont or not font then font = Enum.Font.Highway end
    local TweenService = game:GetService("TweenService")

    local seen, slots = {}, 0
    for _, e in ipairs(list) do
        local obj = e.Obj
        -- render limit: objects further away are not drawn (unknown distance = always drawn)
        if not seen[obj] and (e.Dist >= 1e8 or e.Dist <= limit) then
            seen[obj] = true
            slots += 1
            local t = Tracked[obj]
            if not t then t = { Kind = e.Kind, Obj = obj }; Tracked[obj] = t end
            t.Obj, t.Kind = obj, e.Kind
            local color = ESP_COLORS[e.Kind]
            t.Color = color

            if slots <= MAX_HIGHLIGHTS then
                if not t.HL or not t.HL.Parent then
                    local hl = Instance.new("Highlight")
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = obj
                    hl.FillTransparency = fade > 0 and 1 or fill
                    hl.OutlineTransparency = fade > 0 and 1 or outline
                    hl.Parent = ESPFolder
                    t.HL = hl
                    if fade > 0 then
                        TweenService:Create(hl, TweenInfo.new(fade), { FillTransparency = fill, OutlineTransparency = outline }):Play()
                    end
                    t.Faded = tick() + fade
                elseif tick() > (t.Faded or 0) then
                    t.HL.FillTransparency = fill
                    t.HL.OutlineTransparency = outline
                end
                if not S.ESPRainbow then t.HL.FillColor = color end
            elseif t.HL then
                pcall(function() t.HL:Destroy() end)
                t.HL = nil
            end

            if S.ESPLabels and e.Label then
                if not t.BB or not t.BB.Parent then
                    local part = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        local bb = Instance.new("BillboardGui")
                        bb.Adornee = part
                        bb.AlwaysOnTop = true
                        bb.StudsOffset = Vector3.new(0, 2.6, 0)
                        bb.Parent = ESPFolder
                        local tl = Instance.new("TextLabel")
                        tl.Size = UDim2.fromScale(1, 1)
                        tl.BackgroundTransparency = 1
                        tl.TextScaled = false
                        tl.Parent = bb
                        t.BB, t.TL = bb, tl
                    end
                end
                if t.TL then
                    t.BB.Size = UDim2.fromOffset(320, textSize + 8)
                    t.TL.TextSize = textSize
                    t.TL.Font = font
                    t.TL.TextTransparency = textT
                    t.TL.TextStrokeTransparency = strokeT
                    if not S.ESPRainbow then t.TL.TextColor3 = color end
                    if S.ESPShowDistance and e.Dist < 1e8 then
                        t.TL.Text = string.format("%s [%dm]", e.Label, math.floor(e.Dist))
                    else
                        t.TL.Text = e.Label
                    end
                end
            elseif t.BB then
                pcall(function() t.BB:Destroy() end)
                t.BB, t.TL = nil, nil
            end
        end
    end
    for obj in pairs(Tracked) do
        if not seen[obj] or not obj.Parent then Untrack(obj) end
    end
end)

-- per-frame ESP overlay: rainbow colours, tracers and off-screen arrows
OverlayGui, TracerPool, ArrowPool = nil, {}, {}
function OverlayItem(pool, index, make)
    local item = pool[index]
    if not item or not item.Parent then
        item = make()
        pool[index] = item
    end
    item.Visible = true
    return item
end
function HidePool(pool, from)
    for i = from, #pool do
        if pool[i] then pool[i].Visible = false end
    end
end

Connect(RunService.RenderStepped, function()
    local cam = Workspace.CurrentCamera
    local wantOverlay = (S.ESPTracers or S.ESPArrows) and next(Tracked) ~= nil
    if S.ESPRainbow and next(Tracked) then
        local rainbow = Color3.fromHSV((tick() * 0.25) % 1, 1, 1)
        for _, t in pairs(Tracked) do
            if t.HL then t.HL.FillColor = rainbow end
            if t.TL then t.TL.TextColor3 = rainbow end
        end
    end
    if not wantOverlay or not cam then
        HidePool(TracerPool, 1)
        HidePool(ArrowPool, 1)
        return
    end
    if not OverlayGui or not OverlayGui.Parent then
        OverlayGui = Instance.new("ScreenGui")
        OverlayGui.Name = "Sm1lerHub_ESPOverlay"
        OverlayGui.IgnoreGuiInset = true
        OverlayGui.ResetOnSpawn = false
        OverlayGui.Parent = GuiParent()
    end

    local vp = cam.ViewportSize
    local origin
    if S.ESPTracerOrigin == "Center" then origin = vp / 2
    elseif S.ESPTracerOrigin == "Top" then origin = Vector2.new(vp.X / 2, 0)
    elseif S.ESPTracerOrigin == "Mouse" then
        origin = IsTouch and vp / 2 or UserInputService:GetMouseLocation()
    else origin = Vector2.new(vp.X / 2, vp.Y) end
    local thickness = math.clamp((tonumber(S.ESPTracerThickness) or 75) / 100, 0.5, 2)
    local radius = tonumber(S.ESPArrowRadius) or 250
    local rainbow = Color3.fromHSV((tick() * 0.25) % 1, 1, 1)

    local ti, ai = 0, 0
    for obj, t in pairs(Tracked) do
        local pos = PartPos(obj)
        if pos then
            local color = S.ESPRainbow and rainbow or (t.Color or Color3.new(1, 1, 1))
            local sp, onScreen = cam:WorldToViewportPoint(pos)
            local point = Vector2.new(sp.X, sp.Y)
            if S.ESPTracers and onScreen and sp.Z > 0 then
                ti += 1
                local line = OverlayItem(TracerPool, ti, function()
                    local f = Instance.new("Frame")
                    f.BorderSizePixel = 0
                    f.AnchorPoint = Vector2.new(0.5, 0.5)
                    f.Parent = OverlayGui
                    return f
                end)
                local delta = point - origin
                line.BackgroundColor3 = color
                line.Size = UDim2.fromOffset(delta.Magnitude, thickness)
                line.Position = UDim2.fromOffset((origin.X + point.X) / 2, (origin.Y + point.Y) / 2)
                line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            end
            if S.ESPArrows and (not onScreen or sp.Z <= 0) then
                ai += 1
                local arrow = OverlayItem(ArrowPool, ai, function()
                    local a = Instance.new("TextLabel")
                    a.Size = UDim2.fromOffset(26, 26)
                    a.AnchorPoint = Vector2.new(0.5, 0.5)
                    a.BackgroundTransparency = 1
                    a.Text = "▲"
                    a.TextScaled = true
                    a.Font = Enum.Font.GothamBold
                    a.TextStrokeTransparency = 0.3
                    a.Parent = OverlayGui
                    return a
                end)
                local center = vp / 2
                local dir = point - center
                if sp.Z <= 0 then dir = -dir end
                if dir.Magnitude < 0.001 then dir = Vector2.new(0, -1) end
                dir = dir.Unit
                local at = center + dir * math.min(radius, math.min(vp.X, vp.Y) / 2 - 20)
                arrow.Position = UDim2.fromOffset(at.X, at.Y)
                arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
                arrow.TextColor3 = color
            end
        end
    end
    HidePool(TracerPool, ti + 1)
    HidePool(ArrowPool, ai + 1)
end)

--=========================================================--
--  EXTRA DOORS SYSTEMS  (mirrors S, synced from the toggles)
--=========================================================--

SetCursor = nil -- defined below (forward declaration)

function SyncExtra()
    Extra.AntiScribbles = S.AntiScribbles
    Extra.AntiDrones = S.AntiDrones
    Extra.Honcho = S.Honcho
    Extra.ForgetMeNot = S.ForgetMeNot
    Extra.InfCrucifix = S.InfCrucifix
    if Extra.CustomCursor ~= S.CustomCursor then
        Extra.CustomCursor = S.CustomCursor
        SetCursor(S.CustomCursor)
    end
    Extra.AdonisBypass = S.AdonisBypass
    Extra.PositionSpoof = S.PositionSpoof
    Extra.AntiAlma = S.AntiAlma
    Extra.SkipTimers = S.SkipTimers
    Extra.BypassDrones = S.BypassDrones
end
-- SetCursor is defined below; sync once it exists (see after SetCursor)

-- Anti Scribbles: Scribbles carries a child named "IfYoureExploitingDeleteThis";
-- without it Scribbles cannot attack
Loop(0.5, function()
    if Extra.AntiScribbles then
        local sc = Workspace:FindFirstChild("Scribbles")
        local flag = sc and sc:FindFirstChild("IfYoureExploitingDeleteThis")
        if flag then pcall(function() flag:Destroy() end) end
    end
    if Extra.AntiDrones then
        local d = Workspace:FindFirstChild("DronesStampede")
        if d then
            for _, p in ipairs(d:GetDescendants()) do
                if p:IsA("BasePart") then p.CanTouch = false end
            end
        end
    end
end)

-- Honcho (Archives) --------------------------------------------------------
-- The correct box is the ArchivesStorageBox whose "Tool_BoxID" matches the
-- "BoxID" of one of the room's ArchivesPackageDeposit objects.
HonchoMarks = setmetatable({}, { __mode = "k" }) -- box -> { hl, bb }

function UnmarkHoncho(box)
    local m = HonchoMarks[box]
    if not m then return end
    pcall(function() m.HL:Destroy() end)
    pcall(function() m.BB:Destroy() end)
    HonchoMarks[box] = nil
end

function MarkHoncho(box)
    if HonchoMarks[box] then return end
    local color = Color3.fromRGB(80, 255, 120)
    local hl = Instance.new("Highlight")
    hl.Name = "Sm1lerHub_Honcho"
    hl.Adornee = box
    hl.FillColor = color
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.45
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = GuiParent()
    local bb = Instance.new("BillboardGui")
    bb.Adornee = box:IsA("BasePart") and box or box:FindFirstChildWhichIsA("BasePart", true)
    bb.Size = UDim2.fromOffset(140, 22)
    bb.AlwaysOnTop = true
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.Parent = GuiParent()
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.Text = "Correct Box"
    tl.TextColor3 = color
    tl.TextStrokeTransparency = 0.3
    tl.TextScaled = true
    tl.Font = Enum.Font.GothamBold
    tl.Parent = bb
    HonchoMarks[box] = { HL = hl, BB = bb }
end

Loop(1.5, function()
    if not S.Honcho then
        for box in pairs(HonchoMarks) do UnmarkHoncho(box) end
        return
    end
    for box in pairs(HonchoMarks) do
        if not box.Parent then UnmarkHoncho(box) end
    end
    local r = Rooms()
    if not r then return end
    for _, room in ipairs(r:GetChildren()) do
        local honcho = tonumber(room.Name) and room:FindFirstChild("ArchivesHonchoRoom", true)
        if honcho then
            local ids = {}
            for _, d in ipairs(room:GetDescendants()) do
                if d.Name == "ArchivesPackageDeposit" then
                    local id = d:GetAttribute("BoxID")
                    if id ~= nil then ids[id] = true end
                end
            end
            if next(ids) then
                for _, box in ipairs(honcho:GetDescendants()) do
                    if box.Name == "ArchivesStorageBox" then
                        local id = box:GetAttribute("Tool_BoxID")
                        if id ~= nil and ids[id] then MarkHoncho(box) end
                    end
                end
            end
        end
    end
end)

-- Forget Me Not skipper (Archives) -----------------------------------------
-- 1. confirm every numbered vine door the game wants you to look at
-- 2. once you are inside, stand on the next room's hidden door and open it
FMNBusy = {}
function SkipForgetMeNot(room)
    if FMNBusy[room] then return end
    FMNBusy[room] = true
    task.spawn(function()
        task.wait(2)
        pcall(function()
            if not S.ForgetMeNot or not room.Parent then return end
            if not room:FindFirstChild("ForgetMeNotVineDoors", true) then return end

            for i = 1, 6 do
                local obj = room:FindFirstChild(tostring(i))
                local look = obj and obj:FindFirstChild("LookAt")
                if look and look:IsA("RemoteEvent") then pcall(function() look:FireServer() end) end
            end

            local n = tonumber(room.Name) or 0
            local nextRoom
            local t0 = tick()
            while HubAlive and S.ForgetMeNot and not nextRoom and tick() - t0 < 30 do
                local r = Rooms()
                for k = n + 1, n + 5 do
                    nextRoom = r and r:FindFirstChild(tostring(k))
                    if nextRoom then break end
                end
                if not nextRoom then task.wait(0.2) end
            end
            local door = nextRoom and nextRoom:FindFirstChild("Door")
            if not door or door:GetAttribute("Opened") == true then return end

            if not room:FindFirstChild(LocalPlayer.Name, true) then
                Notify(HUB_NAME, T("Enter the first Forget Me Not door."), 5)
                repeat task.wait(0.2)
                until room:FindFirstChild(LocalPlayer.Name, true) or not S.ForgetMeNot or not room.Parent or not HubAlive
                if not S.ForgetMeNot or not room.Parent then return end
            end

            local hidden = door:WaitForChild("Hidden", 10)
            if not hidden then return end
            task.wait(3)

            local t1 = tick()
            while HubAlive and S.ForgetMeNot and nextRoom.Parent and door:GetAttribute("Opened") ~= true and tick() - t1 < 20 do
                local c = Char()
                if c then
                    pcall(function() c:PivotTo(hidden:IsA("BasePart") and hidden.CFrame or hidden:GetPivot()) end)
                end
                local co = door:FindFirstChild("ClientOpen")
                if co then
                    if co:IsA("RemoteEvent") then pcall(function() co:FireServer() end)
                    elseif co:IsA("BindableEvent") then pcall(function() co:Fire() end) end
                end
                task.wait()
            end
            if door:GetAttribute("Opened") == true then
                Notify(HUB_NAME, T("Forget Me Not skipped. If you are stuck, use Void in Debug."), 6)
            end
        end)
        FMNBusy[room] = nil
    end)
end

Loop(1, function()
    if not S.ForgetMeNot then return end
    local r = Rooms()
    if not r then return end
    local _, n = CurrentRoom()
    for i = math.max(0, n - 4), n do
        local room = r:FindFirstChild(tostring(i))
        if room and room:FindFirstChild("ForgetMeNotVineDoors", true) then SkipForgetMeNot(room) end
    end
end)


function IsCrouching()
    local c = Char()
    if not c then return false end
    local floor = CurrentFloor()
    if floor == "Fools" or floor == "OldHotel" then return c:GetAttribute("Crouching") == true end
    local col = c:FindFirstChild("CollisionPart")
    return col ~= nil and col.CollisionGroup == "PlayerCrouching"
end

function FireCrouch(state)
    local rf = RemoteFolder()
    local crouch = rf and rf:FindFirstChild("Crouch")
    if crouch then pcall(function() crouch:FireServer(state, true) end) end
end

-- Infinite crucifix ---------------------------------------------------------
-- When a Rush-like entity is in range and in sight while you hold the crucifix,
-- it is dropped just before it would be used up and picked straight back up.
-- Risky: needs stable FPS and low ping.
CRUCIFIX_RANGE = { RushMoving = 54, AmbushMoving = 67, A60 = 70, A120 = 75, GlitchRush = 120, GlitchAmbush = 155 }
CrucifixBusy = false
CrucifixRay = RaycastParams.new()
CrucifixRay.FilterType = Enum.RaycastFilterType.Exclude
Loop(0.1, function()
    if not S.InfCrucifix or CrucifixBusy then return end
    local c = Char()
    local tool = c and c:FindFirstChildOfClass("Tool")
    if not tool or tool.Name ~= "Crucifix" then return end
    local origin = c:FindFirstChild("CollisionPart") or HRP()
    if not origin then return end
    CrucifixRay.FilterDescendantsInstances = { c }
    for name, range in pairs(CRUCIFIX_RANGE) do
        local e = Workspace:FindFirstChild(name)
        local pp = e and e.PrimaryPart
        if pp and (pp.Position - origin.Position).Magnitude < range then
            -- the entity must be hittable by the ray, otherwise it passes through it
            pcall(function() pp.CanQuery = true end)
            local hit = Workspace:Raycast(origin.Position, pp.Position - origin.Position, CrucifixRay)
            if not hit or hit.Instance:IsDescendantOf(e) then
                CrucifixBusy = true
                task.spawn(function()
                    local rf = RemoteFolder()
                    local drop = rf and rf:FindFirstChild("DropItem")
                    if drop then pcall(function() drop:FireServer(tool) end) end
                    task.wait(0.54)
                    local drops = Workspace:FindFirstChild("Drops")
                    local dropped = drops and drops:FindFirstChild("Crucifix")
                    local prompt = dropped and dropped:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then FirePrompt(prompt) end
                    task.wait(0.6)
                    CrucifixBusy = false
                end)
                return
            end
        end
    end
end)

--=========================================================--
--  GOD MODE = POSITION SPOOF (Exact Abysall implementation)
--=========================================================--
-- In DOORS, God Mode is NOT health modification - it is Position Spoof:
--  1. Clones Character.Collision -> CollisionClone (Massless) and
--     CollisionPart -> CollisionPartClone so your client walks & collides
--     with the floor/walls normally while the real Collision is non-collidable.
--  2. Sinks RootPart.CFrame by -2.346 studs and sets Humanoid.HipHeight = 0.05
--     + fires Crouch:FireServer(true, true), so the server sees you underground
--     and Rush / Ambush / A-60 / A-120 / Blitz miss you.
--  3. Shifts LowerTorso.Root.C1 by -2.346 so your visible body stays at normal
--     height on screen, and holds Collision/CollisionPart at +2.328 and
--     CollisionClone at +1.75 every RenderStepped.
--  4. Runs skidzopostionspooffix ground raycast ahead so stairs never launch
--     or float you.
Farm = { Running = false, Start = 0 } -- reset (declared earlier)
VelocityHeld = false
SpoofHigh = false
ApplyPositionSpoof, RestoreSpoofVisual, ApplyCrouchSpoof = nil
do
    local SPOFF, SPOFF_COL, SPOFF_CLONE = 2.346, 2.328, 1.75
    local SpoofSunkChar = nil
    local SpoofVisualOn = false
    local SpoofC1, SpoofC1Motor = nil, nil
    local ColClone, ColPartClone = nil, nil
    local LastCrouchSent = 0
    local FIGURE_NAMES = { FigureRig = true, FigureRagdoll = true, Figure = true }

    local GroundRayParams = RaycastParams.new()
    GroundRayParams.FilterType = Enum.RaycastFilterType.Exclude
    GroundRayParams.RespectCanCollide = true
    GroundRayParams.IgnoreWater = true

    local function SpoofExcludedFloor()
        local f = CurrentFloor()
        return f == "Fools" or f == "OldHotel"
    end

    local function EnsureClones(c)
        if not c then return nil, nil end
        local col = c:FindFirstChild("Collision")
        local colPart = c:FindFirstChild("CollisionPart") or col
        if not col then return nil, nil end
        if not ColClone or not ColClone.Parent or ColClone.Parent ~= c then
            local existing = c:FindFirstChild("CollisionClone")
            if existing then pcall(function() existing:Destroy() end) end
            pcall(function()
                ColClone = col:Clone()
                ColClone.Name = "CollisionClone"
                ColClone.Massless = true
                ColClone.Parent = c
            end)
        end
        if colPart and (not ColPartClone or not ColPartClone.Parent or ColPartClone.Parent ~= c) then
            local existing = c:FindFirstChild("CollisionPartClone")
            if existing then pcall(function() existing:Destroy() end) end
            pcall(function()
                ColPartClone = colPart:Clone()
                ColPartClone.Name = "CollisionPartClone"
                ColPartClone.CanCollide = false
                ColPartClone.Massless = true
                local cc = ColPartClone:FindFirstChild("CollisionCrouch")
                if cc then cc:Destroy() end
                ColPartClone.Parent = c
            end)
        end
        return ColClone, ColPartClone
    end

    local function FigureNear()
        local hrp, r = HRP(), Rooms()
        if not hrp or not r then return false end
        local _, n = CurrentRoom()
        for i = n - 1, n + 1 do
            local room = r:FindFirstChild(tostring(i))
            if room then
                for name in pairs(FIGURE_NAMES) do
                    local fig = room:FindFirstChild(name, true)
                    local p = fig and PartPos(fig)
                    if p and (p - hrp.Position).Magnitude < 50 then return true end
                end
            end
        end
        return false
    end

    Loop(0.2, function()
        local floor = CurrentFloor()
        if floor ~= "Fools" and floor ~= "OldHotel" then SpoofHigh = false return end
        local active = S.PositionSpoof or S.GodMode
        SpoofHigh = (active and NearestDanger() ~= nil) or (S.FigureGodmode and FigureNear()) or false
    end)

    ApplyPositionSpoof = function()
        local c, h, root = Char(), Hum(), HRP()
        if not c or not h or not root then return end
        local want = S.PositionSpoof or S.GodMode
        if SpoofExcludedFloor() then return end
        if want then
            EnsureClones(c)
            if SpoofSunkChar ~= c then
                SpoofSunkChar = c
                pcall(function()
                    root.CFrame = root.CFrame * CFrame.new(0, -SPOFF, 0)
                    h.HipHeight = 0.05
                end)
                FireCrouch(true)
            else
                pcall(function() h.HipHeight = 0.05 end)
            end
        elseif SpoofSunkChar == c then
            SpoofSunkChar = nil
            pcall(function()
                root.CFrame = root.CFrame * CFrame.new(0, SPOFF, 0)
                h.HipHeight = 2.396
            end)
            FireCrouch(S.CrouchSpoof or IsCrouching())
        end
    end

    RestoreSpoofVisual = function()
        local c, h, root = Char(), Hum(), HRP()
        if c and root then
            if SpoofSunkChar == c then
                SpoofSunkChar = nil
                pcall(function()
                    root.CFrame = root.CFrame * CFrame.new(0, SPOFF, 0)
                    if h then h.HipHeight = 2.396 end
                end)
            end
            local col = c:FindFirstChild("Collision")
            local colPart = c:FindFirstChild("CollisionPart")
            pcall(function()
                if col then
                    col.Position = root.Position + Vector3.new(0, 0.18, 0)
                    col.CanCollide = true
                    local cc = col:FindFirstChild("CollisionCrouch")
                    if cc then cc.Position = root.Position + Vector3.new(0, -0.982, 0) end
                end
                if colPart and colPart ~= col then
                    colPart.Position = root.Position + Vector3.new(0, 0.18, 0)
                end
                if SpoofC1Motor and SpoofC1Motor.Parent and SpoofC1 then
                    SpoofC1Motor.C1 = SpoofC1
                end
            end)
        end
        if ColClone then pcall(function() ColClone:Destroy() end); ColClone = nil end
        if ColPartClone then pcall(function() ColPartClone:Destroy() end); ColPartClone = nil end
        SpoofVisualOn = false
    end

    Connect(RunService.RenderStepped, function()
        local c, h, root = Char(), Hum(), HRP()
        if not c or not h or not root or h.Health <= 0 then return end
        local want = S.PositionSpoof or S.GodMode

        if (want or S.CrouchSpoof) and tick() - LastCrouchSent > 0.12 then
            LastCrouchSent = tick()
            FireCrouch(true)
        end

        local floor = CurrentFloor()
        local col = c:FindFirstChild("Collision")
        local colPart = c:FindFirstChild("CollisionPart") or col

        if floor == "Fools" or floor == "OldHotel" then
            if want or S.FigureGodmode then
                if col then
                    col.Position = root.Position + Vector3.new(0, SpoofHigh and 200 or 0, 0)
                    col.CanCollide = false
                end
                SpoofVisualOn = true
            elseif SpoofVisualOn then
                RestoreSpoofVisual()
            end
            return
        end

        if want then
            if SpoofSunkChar ~= c then ApplyPositionSpoof() end
            local colClone = EnsureClones(c)
            if math.abs(h.HipHeight - 0.05) > 0.01 then h.HipHeight = 0.05 end

            local cam = Workspace.CurrentCamera
            if not (cam and cam:FindFirstChild("MinecartRig")) then
                root.CanCollide = false
            end

            if col then
                col.CanCollide = false
                local cc = col:FindFirstChild("CollisionCrouch")
                if cc then
                    cc.CanCollide = false
                    cc.Position = root.Position + Vector3.new(0, 1.328, 0)
                end
                col.Position = root.Position + Vector3.new(0, SPOFF_COL, 0)
            end
            if colPart and colPart ~= col then
                colPart.Position = root.Position + Vector3.new(0, SPOFF_COL, 0)
            end

            if colClone then
                local noCol = S.Noclip or (Farm and Farm.Running and S.FarmNoclip) or S.VelocityManip or VelocityHeld
                local isCrouch = IsCrouching()
                local ccClone = colClone:FindFirstChild("CollisionCrouch")
                if col then colClone.CollisionGroup = col.CollisionGroup end
                if ccClone then
                    if col and col:FindFirstChild("CollisionCrouch") then
                        ccClone.CollisionGroup = col.CollisionCrouch.CollisionGroup
                    end
                    colClone.CanCollide = not (noCol or isCrouch)
                    ccClone.CanCollide = not (noCol or not isCrouch)
                    ccClone.Position = root.Position + Vector3.new(0, 0.75, 0)
                else
                    colClone.CanCollide = not noCol
                end
                colClone.Position = root.Position + Vector3.new(0, SPOFF_CLONE, 0)
            end
            if ColPartClone and ColPartClone.Parent then
                if colPart then ColPartClone.CollisionGroup = colPart.CollisionGroup end
                ColPartClone.CanCollide = false
                ColPartClone.Position = root.Position + Vector3.new(0, SPOFF_CLONE, 0)
            end

            local lower = c:FindFirstChild("LowerTorso")
            local motor = lower and lower:FindFirstChild("Root")
            if motor and motor ~= SpoofC1Motor then SpoofC1Motor, SpoofC1 = motor, motor.C1 end
            if motor and SpoofC1 then motor.C1 = SpoofC1 * CFrame.new(0, -SPOFF, 0) end

            -- skidzopostionspooffix: prevents floating or launching on stairs
            if S.StairFix and not S.Fly then
                local st = h:GetState()
                if st ~= Enum.HumanoidStateType.Jumping and st ~= Enum.HumanoidStateType.Climbing
                    and st ~= Enum.HumanoidStateType.Swimming and st ~= Enum.HumanoidStateType.Seated then
                    local vel = root.AssemblyLinearVelocity
                    local horiz = Vector3.new(vel.X, 0, vel.Z)
                    local spd = horiz.Magnitude
                    if spd >= 0.1 then
                        local filter = { c }
                        if cam and cam:FindFirstChild("MinecartRig") then
                            table.insert(filter, cam.MinecartRig)
                        end
                        GroundRayParams.FilterDescendantsInstances = filter
                        local lookAhead = math.clamp(spd * 0.1, 1.25, 3)
                        local curG = Workspace:Raycast(root.Position + Vector3.new(0, 3, 0), Vector3.new(0, -10, 0), GroundRayParams)
                        local fwdG = Workspace:Raycast(root.Position + horiz.Unit * lookAhead + Vector3.new(0, 3, 0), Vector3.new(0, -10, 0), GroundRayParams)
                        if curG and fwdG then
                            local diff = fwdG.Position.Y - curG.Position.Y
                            if diff < -0.08 then
                                if vel.Y > 0 then
                                    root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                                elseif vel.Y > -12 then
                                    root.AssemblyLinearVelocity = Vector3.new(vel.X, -8, vel.Z)
                                end
                            elseif diff > 0.08 and vel.Y > 3 then
                                root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                            end
                        end
                    end
                end
            end

            SpoofVisualOn = true
        elseif SpoofVisualOn then
            RestoreSpoofVisual()
        end
    end)

    ApplyCrouchSpoof = function()
        FireCrouch(S.CrouchSpoof or S.PositionSpoof or S.GodMode or IsCrouching())
    end
    Loop(1.5, function()
        if S.CrouchSpoof then FireCrouch(true) end
    end)
end

--=========================================================--
--  GAME HOOKS  (only on executors with hookmetamethod)
--  * Crouch        -> always "crouching" while Crouch / Position spoof is on
--  * ClutchHeartbeat / HideMonster -> blocked (Figure minigame never fails)
--  * MotorReplication -> "looking down" while Eyes / Lookman are around
--  * Humanoid.MoveDirection -> looks like normal walking during Auto Rooms
--  Every hook passes straight through once the hub is unloaded.
--=========================================================--

HooksReady = false
HookedHumanoid = nil
RoomsBusy = false -- shared with Auto Rooms (declared here so the hook can see it)
if hookmetamethod and getnamecallmethod and newcclosure then
    local okHook = pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if HubAlive and typeof(self) == "Instance" then
                local method = getnamecallmethod()
                if method == "FireServer" then
                    local name = self.Name
                    if name == "Crouch" and (S.CrouchSpoof or S.PositionSpoof) then
                        local args = { ... }
                        args[1], args[2] = true, true
                        return oldNamecall(self, table.unpack(args))
                    elseif (name == "ClutchHeartbeat" or name == "HideMonster") and S.AutoHeartbeat then
                        return nil
                    elseif name == "MotorReplication" and S.BypassEyes
                        and (Workspace:FindFirstChild("Eyes") or Workspace:FindFirstChild("BackdoorLookman")) then
                        local args = { ... }
                        local floor = CurrentFloor()
                        if floor == "Fools" or floor == "OldHotel" then
                            args[1], args[2], args[3], args[4] = 0, SpoofHigh and 65 or -65, 0, false
                        else
                            args[1] = -650
                        end
                        return oldNamecall(self, table.unpack(args))
                    end
                end
            end
            return oldNamecall(self, ...)
        end))

        local oldIndex
        oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
            if HubAlive and key == "MoveDirection" and S.RoomsSpoofSteps and S.AutoRooms
                and self == HookedHumanoid and RoomsBusy then
                local c = Char()
                local root = c and c:FindFirstChild("HumanoidRootPart")
                if root and not c:GetAttribute("Hiding") then return root.CFrame.LookVector end
            end
            return oldIndex(self, key)
        end))
    end)
    HooksReady = okHook
end
Loop(1, function() HookedHumanoid = Hum() end)

-- Velocity manipulation: slowly pushes you forward so the game's anti-noclip
-- does not pull you back. Hold V on PC or use the toggle.
--  * Velocity: a BodyVelocity pushes you forward at 2.25 studs/s (like the original)
--  * Pivot:    small steps forward (the original's Pivot mode calls a method the
--              camera does not have, so this is a safe replacement)
VelBody = nil
Connect(RunService.Heartbeat, function()
    local root = HRP()
    local active = (S.VelocityManip or VelocityHeld) and not S.Fly and root ~= nil
    if not active then
        if VelBody then VelBody.Parent = nil end
        return
    end
    if S.VelocityMode == "Pivot" then
        if VelBody then VelBody.Parent = nil end
        local floor = CurrentFloor()
        if floor == "Fools" or floor == "OldHotel" then return end
        local c = Char()
        local look = root.CFrame.LookVector
        local dir = Vector3.new(look.X, 0, look.Z)
        if c and dir.Magnitude > 0.01 then
            pcall(function() c:PivotTo(c:GetPivot() + dir.Unit * 0.06) end)
        end
    else
        if not VelBody then
            VelBody = Instance.new("BodyVelocity")
            VelBody.Name = "Sm1lerHub_Velocity"
            VelBody.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        end
        VelBody.Parent = root
        VelBody.Velocity = root.CFrame.LookVector * 2.25
    end
end)

-- Remove closet exit delay: lets you walk out of a closet right after the
-- hiding animation instead of waiting (moving while stuck = leave the closet)
Connect(RunService.RenderStepped, function()
    if not S.NoClosetDelay then return end
    local c, h, root = Char(), Hum(), HRP()
    if not c or not h or not root then return end
    if c:GetAttribute("Hiding") ~= true or c:GetAttribute("AnimatingClient") == true then return end
    if h.MoveDirection.Magnitude < 0.01 then return end
    local colPart = c:FindFirstChild("CollisionPart")
    if root.Anchored or (colPart and colPart.Anchored) then
        local rf = RemoteFolder()
        local camLock = rf and rf:FindFirstChild("CamLock")
        if camLock then pcall(function() camLock:FireServer() end) end
    end
end)

-- While dead, load the rooms of the living player you are watching
Loop(0.5, function()
    if not S.SpectateRooms or LocalPlayer:GetAttribute("Alive") ~= false then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local best, bestD
    for _, p in ipairs(Players:GetPlayers()) do
        local r = p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if r then
            local d = (cam.CFrame.Position - r.Position).Magnitude
            if not bestD or d < bestD then best, bestD = p, d end
        end
    end
    local room = best and best:GetAttribute("CurrentRoom")
    if room ~= nil and LocalPlayer:GetAttribute("CurrentRoom") ~= room then
        LocalPlayer:SetAttribute("CurrentRoom", room)
    end
end)

-- No damage: while on, the real entity remote is taken out of the remotes
-- folder and a harmless stand-in with the same name takes its place
FAKE_REMOTES = { NoScreechDamage = "Screech", NoHaltDamage = "ShadeResult", NoA90Damage = "A90", NoSurgeDamage = "SurgeRemote" }
SwappedRemotes = {}
function ApplyFakeRemotes()
    local rf = RemoteFolder()
    if not rf then return end
    for key, name in pairs(FAKE_REMOTES) do
        local sw = SwappedRemotes[key]
        if S[key] and not sw then
            local real = rf:FindFirstChild(name)
            if real then
                local fake = Instance.new("RemoteEvent")
                fake.Name = name
                real.Parent = nil
                fake.Parent = rf
                SwappedRemotes[key] = { Real = real, Fake = fake, Folder = rf }
            end
        elseif not S[key] and sw then
            pcall(function() sw.Fake:Destroy() end)
            pcall(function() sw.Real.Parent = sw.Folder end)
            SwappedRemotes[key] = nil
        end
    end
end
Loop(1, ApplyFakeRemotes)

-- Infinite items (needs fireproximityprompt) ---------------------------------
-- Locks that use up an item get a harmless copy of their prompt; the real one
-- is parked out of reach. When you use the copy, the selected item is dropped
-- for a moment: as soon as it lands you pick it back up and the real lock
-- prompt fires - so the lock opens but the item keeps all its uses.
INF_ITEM_NAMES = { Lockpicks = "Lockpick", ["Skeleton Key"] = "SkeletonKey", Shears = "Shears", Multitool = "Multitool" }
PromptPark = Instance.new("Folder")
PromptPark.Name = "Sm1lerHub_PromptPark"
PromptPark.Parent = ReplicatedStorage
InfFakes = setmetatable({}, { __mode = "k" }) -- fake -> { Real, Parent }

function FireRealLock(info)
    if not info.Real or not info.Parent or not info.Parent.Parent then return end
    pcall(function() info.Real.Parent = info.Parent end)
    task.wait()
    if fireproximityprompt then pcall(fireproximityprompt, info.Real) end
    task.wait(0.1)
    if InfFakes[info.Fake] then pcall(function() info.Real.Parent = PromptPark end) end
end

function RestoreInfFakes()
    for fake, info in pairs(InfFakes) do
        if info.Real and info.Parent and info.Parent.Parent then
            pcall(function() info.Real.Parent = info.Parent end)
        end
        pcall(function() fake:Destroy() end)
        InfFakes[fake] = nil
    end
end

Loop(0.5, function()
    if not S.InfiniteItems or not fireproximityprompt then
        if next(InfFakes) then RestoreInfFakes() end
        return
    end
    local floor = CurrentFloor()
    if floor == "Fools" or floor == "OldHotel" then return end
    local r = Rooms()
    if not r then return end
    local _, n = CurrentRoom()
    for i = n - 1, n + 1 do
        local room = r:FindFirstChild(tostring(i))
        if room then
            for _, p in ipairs(room:GetDescendants()) do
                if p:IsA("ProximityPrompt") and not p:GetAttribute("Sm1lerFake") and p.Parent ~= PromptPark and IsLockPrompt(p) then
                    local fake = p:Clone()
                    fake:SetAttribute("Sm1lerFake", true)
                    local info = { Real = p, Parent = p.Parent, Fake = fake }
                    InfFakes[fake] = info
                    fake.Parent = p.Parent
                    p.Parent = PromptPark
                    -- the lock was changed by the game (e.g. it opened): put the real one back
                    p:GetPropertyChangedSignal("ActionText"):Once(function()
                        if InfFakes[fake] then
                            pcall(function() p.Parent = info.Parent end)
                            pcall(function() fake:Destroy() end)
                            InfFakes[fake] = nil
                        end
                    end)
                    p:GetPropertyChangedSignal("Enabled"):Connect(function()
                        if fake.Parent then fake.Enabled = p.Enabled end
                    end)
                end
            end
        end
    end
end)

Connect(ProximityPromptService.PromptTriggered, function(prompt)
    local info = InfFakes[prompt]
    if not info then return end
    local c = Char()
    local tool = c and c:FindFirstChildOfClass("Tool")
    local wanted = false
    if tool then
        for label, name in pairs(INF_ITEM_NAMES) do
            if tool.Name == name and S.InfiniteItemList[label] then wanted = true break end
        end
    end
    if not (S.InfiniteItems and wanted) then
        -- not an infinite item: just use the real lock normally
        task.spawn(FireRealLock, info)
        return
    end
    local drops = Workspace:FindFirstChild("Drops")
    local rf = RemoteFolder()
    local dropRemote = rf and rf:FindFirstChild("DropItem")
    if not drops or not dropRemote then task.spawn(FireRealLock, info) return end
    local conn
    conn = drops.ChildAdded:Connect(function(dropped)
        conn:Disconnect()
        local pick = dropped:WaitForChild("ModulePrompt", 2) or dropped:FindFirstChildWhichIsA("ProximityPrompt", true)
        if pick then FirePrompt(pick) end
        task.spawn(FireRealLock, info)
    end)
    task.delay(3, function() if conn.Connected then conn:Disconnect() end end)
    pcall(function() dropRemote:FireServer(tool) end)
end)

-- Remove Halt / A-90 / Dread / Surge: the client module or vignette that runs
-- the entity is renamed, so the game cannot find it; renamed back when off
REMOVE_MODULES = { RemoveHalt = "Shade", RemoveA90 = "A90", RemoveDread = "Dread" }
ModuleCache = {}
function FindClientModule(name)
    local cached = ModuleCache[name]
    if cached and cached.Parent then return cached end
    local main = MainUI()
    local init = main and main:FindFirstChild("Initiator")
    if not init then return nil end
    for _, d in ipairs(init:GetDescendants()) do
        if d:IsA("ModuleScript") and (d.Name == name or d.Name == name .. "_Disabled") then
            ModuleCache[name] = d
            return d
        end
    end
    return nil
end
function ApplyRemovals()
    for key, name in pairs(REMOVE_MODULES) do
        local mod = FindClientModule(name)
        if mod then
            local want = S[key] and (name .. "_Disabled") or name
            if mod.Name ~= want then mod.Name = want end
        end
    end
    local main = MainUI()
    local surge = main and (main:FindFirstChild("SurgeVignette", true) or main:FindFirstChild("SurgeVignette_Disabled", true))
    if surge then
        local want = S.RemoveSurge and "SurgeVignette_Disabled" or "SurgeVignette"
        if surge.Name ~= want then surge.Name = want end
    end
end
Loop(1, ApplyRemovals)

Connect(RunService.RenderStepped, function()
    if not S.RemoveScreech then return end
    local cam = Workspace.CurrentCamera
    local screech = cam and cam:FindFirstChild("Screech")
    if screech then pcall(function() screech:Destroy() end) end
end)

-- Audio: Jammin music and prompt / caption sounds (volumes are remembered)
MutedSounds = {}
function Mute(tag, sound, on)
    if not sound then return end
    local id = tag .. sound:GetFullName()
    if on then
        if MutedSounds[id] == nil then MutedSounds[id] = { Sound = sound, Volume = sound.Volume } end
        sound.Volume = 0
    elseif MutedSounds[id] then
        pcall(function() sound.Volume = MutedSounds[id].Volume end)
        MutedSounds[id] = nil
    end
end
JamEQBackup = nil
function ApplyAudio()
    local main = MainUI()
    local game_ = main and main:FindFirstChild("Initiator") and main.Initiator:FindFirstChild("Main_Game")
    if game_ then
        local health = game_:FindFirstChild("Health")
        Mute("jam", health and health:FindFirstChild("Jam"), S.MuteJammin)
        local ps = game_:FindFirstChild("PromptService")
        if ps then
            for _, n in ipairs({ "Triggered", "Holding", "Notification" }) do
                Mute("prompt", ps:FindFirstChild(n), S.MutePrompts)
            end
        end
        local rem = game_:FindFirstChild("Reminder")
        Mute("prompt", rem and rem:FindFirstChild("Caption"), S.MutePrompts)
    end
    local sm = game:GetService("SoundService"):FindFirstChild("Main")
    local eq = sm and sm:FindFirstChild("Jamming")
    if eq then
        if S.MuteJammin then
            if JamEQBackup == nil then JamEQBackup = eq.Enabled end
            eq.Enabled = false
        elseif JamEQBackup ~= nil then
            eq.Enabled = JamEQBackup
            JamEQBackup = nil
        end
    end
end
Loop(1, ApplyAudio)

-- Remove footstep sounds: the game creates each step as a Sound named "Sound"
-- directly inside your character; those are muted as soon as they appear
StepMuted = setmetatable({}, { __mode = "k" })
function MuteStep(s)
    if S.MuteFootsteps and s:IsA("Sound") and s.Name == "Sound" then
        if StepMuted[s] == nil then StepMuted[s] = s.Volume end
        s.Volume = 0
    end
end
StepConn = nil
Loop(0.5, function()
    local c = Char()
    if S.MuteFootsteps and c then
        if not StepConn or StepConn.Char ~= c then
            if StepConn then StepConn.Conn:Disconnect() end
            StepConn = { Char = c, Conn = c.ChildAdded:Connect(MuteStep) }
        end
        for _, s in ipairs(c:GetChildren()) do MuteStep(s) end
    elseif next(StepMuted) or StepConn then
        if StepConn then StepConn.Conn:Disconnect(); StepConn = nil end
        for s, vol in pairs(StepMuted) do
            if s.Parent then pcall(function() s.Volume = vol end) end
            StepMuted[s] = nil
        end
    end
end)

-- Custom cursor -----------------------------------------------------------
CursorGui, CursorIcon = nil
SetCursor = function(on)
    if on and not CursorGui then
        if not gethui then return end
        local ok, h = pcall(gethui)
        if not ok or not h then return end
        CursorGui = Instance.new("ScreenGui")
        CursorGui.Name = "Sm1lerHub_Cursor"
        CursorGui.ResetOnSpawn = false
        CursorGui.IgnoreGuiInset = true
        CursorGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        CursorGui.Parent = h
        CursorIcon = Instance.new("ImageLabel")
        CursorIcon.Size = UDim2.fromOffset(28, 28)
        CursorIcon.BackgroundTransparency = 1
        CursorIcon.Image = "rbxassetid://6031280890"
        CursorIcon.Parent = CursorGui
        UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.ForceHide
        table.insert(Conns, RunService.RenderStepped:Connect(function()
            local m = UserInputService:GetMouseLocation()
            if CursorIcon then CursorIcon.Position = UDim2.fromOffset(m.X, m.Y) end
        end))
        table.insert(Conns, UserInputService.InputBegan:Connect(function() end))
    elseif not on and CursorGui then
        pcall(function() CursorGui:Destroy() end)
        CursorGui, CursorIcon = nil, nil
        pcall(function() UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.Default end)
    end
end

