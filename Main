-- running the script again first unloads the old copy (instead of doing nothing)
if getgenv().Sm1lerHubUnload then
    pcall(getgenv().Sm1lerHubUnload)
end
getgenv().Sm1lerHubLoaded = nil

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Sm1ler Hub", Text = "Loading... by Sm1ler", Duration = 5,
    })
end)

-- everything below runs protected: if anything breaks you get a notification
-- with the error instead of the script silently doing nothing
Sm1lerOk, Sm1lerErr = xpcall(function()

getgenv().Sm1lerHubLoaded = true

HUB_NAME = "Sm1ler Hub"
HUB_AUTHOR = "by Sm1ler"
HUB_VERSION = "3.0.0"
OWNER_NAME = "Araen684999"

-- Optional: raw URL of THIS file (your GitHub / Pastebin) for "Queue on teleport"
SCRIPT_URL = ""

-- Official, unmodified Abysall Hub Continued by TheRealCookieMonsterOf1966
ABYSALL_OFFICIAL_URL = "https://raw.githubusercontent.com/therealcookiemonsterof1966/AbysallContinued/main/Games/Doors/Main.luau"

--=========================================================--
--  SERVICES & LIFECYCLE
--=========================================================--

CloneRef = cloneref or clonereference or function(o) return o end
function Svc(name)
    local ok, s = pcall(game.GetService, game, name)
    if not ok or not s then return nil end
    local ok2, c = pcall(CloneRef, s)
    return (ok2 and c) or s
end

if not game:IsLoaded() then game.Loaded:Wait() end

Players = Svc("Players")
ReplicatedStorage = Svc("ReplicatedStorage")
RunService = Svc("RunService")
UserInputService = Svc("UserInputService")
Lighting = Svc("Lighting")
StarterGui = Svc("StarterGui")
HttpService = Svc("HttpService")
TeleportService = Svc("TeleportService")
VirtualUser = Svc("VirtualUser")
ProximityPromptService = Svc("ProximityPromptService")
Workspace = game:GetService("Workspace")

LocalPlayer = Players.LocalPlayer
while not LocalPlayer do
    task.wait(0.2)
    LocalPlayer = Players.LocalPlayer
end

IsOwner = (LocalPlayer.Name == OWNER_NAME)

HubAlive = true
Conns = {}

function Connect(signal, fn)
    local c = signal:Connect(function(...)
        if not HubAlive then return end
        local ok, err = pcall(fn, ...)
        if not ok then warn("[Sm1ler Hub] " .. tostring(err)) end
    end)
    table.insert(Conns, c)
    return c
end

function Loop(interval, fn)
    task.spawn(function()
        while HubAlive do
            local ok, err = pcall(fn)
            if not ok then warn("[Sm1ler Hub] " .. tostring(err)) end
            task.wait(interval)
        end
    end)
end

function KeyFromName(name)
    local ok, key = pcall(function() return Enum.KeyCode[name] end)
    return ok and key or Enum.KeyCode.RightShift
end

--=========================================================--
--  CONFIG
--=========================================================--

CFG_FOLDER = "Sm1lerHub"
CFG_FILE = CFG_FOLDER .. "/config.json"
CFG_DIR = CFG_FOLDER .. "/configs"
CanFS = (writefile and readfile and isfile) and true or false

Config = {
    UILibrary  = "WindUI",
    Language   = "en",
    Theme      = "Dark",
    UIScale    = 100,
    ToggleKey  = "RightShift",
    AutoSave   = true,
    Executions = 0,
    Features   = {},
}

function EnsureFolders()
    if not CanFS or not makefolder then return end
    pcall(function()
        if not isfolder or not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
        if not isfolder or not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
    end)
end

function SaveConfig()
    if not CanFS then return end
    EnsureFolders()
    pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(Config)) end)
end

pcall(function()
    if CanFS and isfile(CFG_FILE) then
        local data = HttpService:JSONDecode(readfile(CFG_FILE))
        if type(data) == "table" then
            for k in pairs(Config) do
                if data[k] ~= nil then Config[k] = data[k] end
            end
        end
    end
end)
Config.Executions = (tonumber(Config.Executions) or 0) + 1
SaveConfig()

