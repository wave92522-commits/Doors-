Dirty = false
function Persist() Dirty = true end

function FeatureSnapshot()
    local copy = {}
    for k, v in pairs(S) do
        if not NOT_SAVED[k] then copy[k] = v end
    end
    return copy
end

Loop(2, function()
    if Dirty and Config.AutoSave then
        Dirty = false
        Config.Features = FeatureSnapshot()
        SaveConfig()
    end
end)

--=========================================================--
--  UI LIBRARIES  (a fresh instance per build)
--=========================================================--

LIBS = {
    WindUI     = "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
    Orion      = "https://raw.githubusercontent.com/shlexware/Orion/main/source",
    MacLibrary = "https://github.com/GoHamza/AppleLibrary/blob/main/main.lua?raw=true",
    Obsidian   = "https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua",
    Rayfield   = "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    Fluent     = "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua",
}
LIB_ORDER = { "WindUI", "Orion", "MacLibrary", "Obsidian", "Rayfield", "Fluent" }

LibSource = {}
function LoadLib(name)
    local url = LIBS[name]
    if not url then return nil end
    if not LibSource[name] then
        local ok, src = pcall(function() return game:HttpGet(url) end)
        if not ok or type(src) ~= "string" or #src < 200 then
            warn("[Sm1ler Hub] Could not download " .. name)
            return nil
        end
        LibSource[name] = src
    end
    local fn, err = loadstring(LibSource[name])
    if not fn then
        warn("[Sm1ler Hub] Compile error in " .. name .. ": " .. tostring(err))
        LibSource[name] = nil
        return nil
    end
    local ok, lib = pcall(fn)
    if ok and lib then return lib end
    warn("[Sm1ler Hub] Failed to start " .. name .. ": " .. tostring(lib))
    return nil
end

function SystemNotify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", { Title = HUB_NAME, Text = text, Duration = 7 })
    end)
end

UI = nil
ApplySilentSteps, HasteGui = nil -- defined further down
LibraryCodeRef = nil -- library padlock code reader (defined with the padlock code)

-- a different sound for every notification style
NOTIFY_SOUNDS = {
    ["Sm1ler Hub"] = "rbxassetid://4590662766",
    ["Doors"]      = "rbxassetid://10469938989",
    ["Caption"]    = "rbxassetid://4590657391",
}
function PlayNotifySound()
    if not S.NotifySound then return end
    pcall(function()
        local snd = Instance.new("Sound")
        snd.SoundId = NOTIFY_SOUNDS[S.NotifyStyle] or NOTIFY_SOUNDS["Sm1ler Hub"]
        snd.Volume = math.clamp(tonumber(S.NotifyVolume) or 2, 0, 10)
        snd.Parent = Workspace
        snd.PlayOnRemove = true
        snd:Destroy()
    end)
end

function MainUI()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    return pg and pg:FindFirstChild("MainUI")
end

-- DOORS-style popup built on the game's own achievement template
function GameStyleNotify(title, content, dur, icon, warning)
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local ui = pg and (pg:FindFirstChild("GlobalUI") or pg:FindFirstChild("MainUI"))
    local holder = ui and ui:FindFirstChild("AchievementsHolder")
    local template = holder and holder:FindFirstChild("Achievement")
    if not template then return false end
    return pcall(function()
        local TweenService = game:GetService("TweenService")
        local color = warning and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(190, 160, 255)
        local card = template:Clone()
        card.Name = "Sm1lerHubNotify"
        card.Visible = true
        card.Size = UDim2.new(1, 0, 0, 0)
        local frame = card:FindFirstChild("Frame")
        if frame then
            frame.Position = UDim2.new(1.1, 0, 0, 0)
            local tag = frame:FindFirstChild("TextLabel")
            if tag then
                tag.Text = warning and "WARNING" or "SM1LER HUB"
                tag.TextColor3 = color
            end
            local stroke = frame:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = color end
            local glow = frame:FindFirstChild("Glow")
            if glow and glow:IsA("ImageLabel") then glow.ImageColor3 = color end
            local details = frame:FindFirstChild("Details")
            if details then
                local t, d, r = details:FindFirstChild("Title"), details:FindFirstChild("Desc"), details:FindFirstChild("Reason")
                if t then t.Text = tostring(title) end
                if d then d.Text = tostring(content) end
                if r then r.Text = "Sm1ler Hub • by Sm1ler" end
            end
            local img = frame:FindFirstChild("ImageLabel")
            if img then img.Image = icon or "rbxassetid://6023426923" end
        end
        card.Parent = holder
        task.spawn(function()
            TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.new(1, 0, 0.2, 0) }):Play()
            task.wait(0.5)
            if frame then
                TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = UDim2.new(0, 0, 0, 0) }):Play()
            end
            task.wait(dur or 5)
            if frame then
                TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Position = UDim2.new(1.1, 0, 0, 0) }):Play()
            end
            task.wait(0.4)
            pcall(function() card:Destroy() end)
        end)
    end)
end

-- subtitle-style popup built on the game's own caption label
function CaptionNotify(title, content, dur)
    local main = MainUI()
    local mainFrame = main and main:FindFirstChild("MainFrame")
    local template = mainFrame and mainFrame:FindFirstChild("Caption")
    if not template then return false end
    return pcall(function()
        local TweenService = game:GetService("TweenService")
        for _, c in ipairs(main:GetChildren()) do
            if c.Name == "Sm1lerHubCaption" then c:Destroy() end
        end
        local cap = template:Clone()
        cap.Name = "Sm1lerHubCaption"
        cap.Text = tostring(title) .. (content and content ~= "" and (" — " .. tostring(content)) or "")
        cap.Visible = true
        cap.TextTransparency = 0
        cap.Parent = main
        task.delay(math.max((dur or 5) - 2, 1), function()
            if cap.Parent then
                TweenService:Create(cap, TweenInfo.new(2, Enum.EasingStyle.Linear), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
                task.wait(2.1)
                pcall(function() cap:Destroy() end)
            end
        end)
    end)
end

-- optional: forward entity alerts to the chat
function SendChat(text)
    pcall(function()
        local tcs = game:GetService("TextChatService")
        local channels = tcs:FindFirstChild("TextChannels")
        local general = channels and channels:FindFirstChild("RBXGeneral")
        if general then general:SendAsync(text) return end
        local legacy = ReplicatedStorage:FindFirstChild("DefaultChatSystemEvents")
        local say = legacy and legacy:FindFirstChild("SayMessageRequest")
        if say then say:FireServer(text, "All") end
    end)
end

function Notify(title, content, dur, icon, warning)
    PlayNotifySound()
    if S.NotifyStyle == "Doors" and GameStyleNotify(title, content, dur, icon, warning) then
        return
    end
    if S.NotifyStyle == "Caption" and CaptionNotify(title, content, dur) then
        return
    end
    if UI and UI.Notify then
        pcall(UI.Notify, UI, tostring(title), tostring(content), dur or 5, icon)
    else
        SystemNotify(tostring(title) .. " - " .. tostring(content))
    end
end

--=========================================================--
--  UI ADAPTERS
--  A:Tab(title, icon) -> tab ; tab:Section(title) -> container
--  container: Toggle / Button / Slider / Dropdown / Input / Label
--=========================================================--

Adapters = {}

-- multi-select helpers: every library returns its selection in a different
-- shape, so everything is normalised to a set { ["Name"] = true }
function ToSet(v)
    local set = {}
    if type(v) == "table" then
        for k, val in pairs(v) do
            if type(k) == "number" then set[tostring(val)] = true
            elseif val then set[tostring(k)] = true end
        end
    elseif type(v) == "string" then
        set[v] = true
    end
    return set
end

function SetToList(set)
    local out = {}
    for k, on in pairs(set or {}) do if on then table.insert(out, k) end end
    table.sort(out)
    return out
end

-- libraries without multi-select get one checkbox per value instead
function MultiAsToggles(C, o)
    local set = {}
    for k, on in pairs(o.Default or {}) do set[k] = on end
    for _, value in ipairs(o.Values) do
        C:Toggle({
            Text = o.Text .. ": " .. value, Default = set[value] == true,
            Callback = function(on)
                set[value] = on or nil
                if o.Callback then
                    local copy = {}
                    for k in pairs(set) do copy[k] = true end
                    o.Callback(copy)
                end
            end,
        })
    end
end

function Adapters.WindUI(lib)
    local Window = lib:CreateWindow({
        Title = HUB_NAME, Author = HUB_AUTHOR, Icon = "sparkles",
        Theme = Config.Theme, Folder = "Sm1lerHub",
        Size = Device.Size, MinSize = Device.Min, MaxSize = Device.Max,
        ToggleKey = KeyFromName(Config.ToggleKey),
        Resizable = true, AutoScale = true, Transparent = true,
        OpenButton = { Title = HUB_NAME, Enabled = true, Draggable = true },
        User = { Enabled = true, Anonymous = false },
    })
    if not Window then return nil end
    pcall(function() if IsTouch then lib:SetNotificationLower(true) end end)

    local A = { HasOwnKey = true }
    function A:Notify(title, content, dur, icon)
        pcall(function() lib:Notify({ Title = title, Content = content, Duration = dur or 5, Icon = icon or "bell" }) end)
    end
    function A:Tag(text) pcall(function() Window:Tag({ Title = text, Icon = "crown", Border = true }) end) end
    function A:SetTheme(t) pcall(function() lib:SetTheme(t) end) end
    function A:Themes()
        local ok, t = pcall(function() return lib:GetThemes() end)
        if not ok or type(t) ~= "table" then return { "Dark" } end
        local out = {}
        for n in pairs(t) do table.insert(out, n) end
        table.sort(out)
        return out
    end
    function A:SetScale(s) pcall(function() Window:SetUIScale(s) end) end
    function A:SetKey(k) pcall(function() Window:SetToggleKey(k) end) end
    function A:Toggle() pcall(function() Window:Toggle() end) end
    function A:Finish()
        if Config.UIScale ~= 100 then self:SetScale(Config.UIScale / 100) end
    end
    function A:Destroy() pcall(function() Window:Destroy() end) end

    local function Container(tab)
        local C = {}
        function C:Toggle(o)
            local e = tab:Toggle({ Title = o.Text, Desc = o.Desc, Value = o.Default or false, Callback = o.Callback })
            return { Set = function(_, v) pcall(function() e:Set(v) end) end }
        end
        function C:Button(o)
            tab:Button({ Title = o.Text, Desc = o.Desc, Callback = o.Callback or function() end })
        end
        function C:Slider(o)
            tab:Slider({
                Title = o.Text, Desc = o.Desc, Step = o.Step or 1,
                Value = { Min = o.Min, Max = o.Max, Default = o.Default },
                Callback = o.Callback,
            })
        end
        function C:Dropdown(o)
            local e = tab:Dropdown({ Title = o.Text, Desc = o.Desc, Values = o.Values, Value = o.Default, Callback = o.Callback })
            return { Refresh = function(_, vals) pcall(function() e:Refresh(vals) end) end }
        end
        function C:Input(o)
            tab:Input({ Title = o.Text, Desc = o.Desc, Value = o.Default or "", Placeholder = o.Placeholder or "", Callback = o.Callback })
        end
        function C:MultiDropdown(o)
            tab:Dropdown({
                Title = o.Text, Desc = o.Desc, Values = o.Values, Value = SetToList(o.Default),
                Multi = true, AllowNone = true,
                Callback = function(v) if o.Callback then o.Callback(ToSet(v)) end end,
            })
        end
        function C:Label(text)
            local ok, p = pcall(function() return tab:Paragraph({ Title = text, Desc = "" }) end)
            if ok and p then
                return { Set = function(_, v)
                    pcall(function()
                        if p.SetTitle then p:SetTitle(tostring(v)) else p:SetDesc(tostring(v)) end
                    end)
                end }
            end
            return { Set = function() end }
        end
        return C
    end

    function A:Tab(title, icon)
        local t = Window:Tab({ Title = title, Icon = icon })
        if not t then return nil end
        local C = Container(t)
        return { Section = function(_, name)
            pcall(function() t:Section({ Title = name }) end)
            return C
        end }
    end
    return A
end

function Adapters.Orion(lib)
    local Window = lib:MakeWindow({
        Name = HUB_NAME .. " | " .. HUB_AUTHOR,
        HidePremium = true, SaveConfig = false, IntroEnabled = false,
        ConfigFolder = "Sm1lerHub",
    })
    local A = { HasOwnKey = true }
    function A:Notify(title, content, dur, icon)
        pcall(function()
            lib:MakeNotification({ Name = title, Content = content, Image = icon or "rbxassetid://4483345998", Time = dur or 5 })
        end)
    end
    function A:Tag() end
    function A:SetTheme() end
    function A:Themes() return { "Default" } end
    function A:SetScale() end
    function A:SetKey() end
    function A:Toggle() end
    function A:Finish() pcall(function() lib:Init() end) end
    function A:Destroy() pcall(function() lib:Destroy() end) end

    local function Container(obj)
        local C = {}
        function C:Toggle(o)
            local e = obj:AddToggle({ Name = o.Text, Default = o.Default or false, Callback = o.Callback })
            return { Set = function(_, v) pcall(function() e:Set(v) end) end }
        end
        function C:Button(o) obj:AddButton({ Name = o.Text, Callback = o.Callback or function() end }) end
        function C:Slider(o)
            obj:AddSlider({
                Name = o.Text, Min = o.Min, Max = o.Max, Default = o.Default,
                Increment = o.Step or 1, ValueName = "", Color = Color3.fromRGB(139, 92, 246),
                Callback = o.Callback,
            })
        end
        function C:Dropdown(o)
            local e = obj:AddDropdown({ Name = o.Text, Default = o.Default, Options = o.Values, Callback = o.Callback })
            return { Refresh = function(_, vals) pcall(function() e:Refresh(vals, true) end) end }
        end
        function C:Input(o)
            obj:AddTextbox({ Name = o.Text, Default = o.Default or "", TextDisappear = false, Callback = o.Callback })
        end
        function C:MultiDropdown(o) MultiAsToggles(C, o) end
        function C:Label(text)
            local e = obj:AddLabel(text)
            return { Set = function(_, v) pcall(function() e:Set(tostring(v)) end) end }
        end
        return C
    end

    function A:Tab(title)
        local t = Window:MakeTab({ Name = title, Icon = "rbxassetid://4483345998", PremiumOnly = false })
        if not t then return nil end
        return { Section = function(_, name)
            local ok, sec = pcall(function() return t:AddSection({ Name = name }) end)
            return Container((ok and sec) or t)
        end }
    end
    return A
end

function Adapters.MacLibrary(lib)
    local Window = lib:init(HUB_NAME .. " - " .. HUB_AUTHOR, false, KeyFromName(Config.ToggleKey), true)
    local visible = true
    local A = { HasOwnKey = true }
    function A:Notify(title, content) pcall(function() Window:TempNotify(title, content, "") end) end
    function A:Tag() end
    function A:SetTheme() end
    function A:Themes() return { "Default" } end
    function A:SetScale() end
    function A:SetKey() end
    function A:Toggle() pcall(function() Window:ToggleVisible() end); visible = not visible end
    function A:Finish() end
    function A:Destroy()
        if visible then pcall(function() Window:ToggleVisible() end) end
        visible = false
    end

    local function Container(sec)
        local C = {}
        function C:Toggle(o)
            pcall(function() sec:Switch(o.Text, o.Callback or function() end) end)
            return { Set = function() end }
        end
        function C:Button(o) pcall(function() sec:Button(o.Text, o.Callback or function() end) end) end
        function C:Slider(o)
            pcall(function()
                sec:TextField(o.Text .. " (" .. o.Min .. "-" .. o.Max .. ")", tostring(o.Default), function(txt)
                    local n = tonumber(txt)
                    if n and o.Callback then o.Callback(math.clamp(n, o.Min, o.Max)) end
                end)
            end)
        end
        function C:Dropdown(o)
            local i = 1
            for k, val in ipairs(o.Values) do if val == o.Default then i = k break end end
            pcall(function()
                sec:Button(o.Text .. ": " .. tostring(o.Values[i]), function()
                    i = i + 1
                    if i > #o.Values then i = 1 end
                    if o.Callback then o.Callback(o.Values[i]) end
                    Notify(o.Text, tostring(o.Values[i]), 2)
                end)
            end)
            return { Refresh = function() end }
        end
        function C:Input(o)
            pcall(function() sec:TextField(o.Text, o.Placeholder or "", o.Callback or function() end) end)
        end
        function C:MultiDropdown(o) MultiAsToggles(C, o) end
        function C:Label(text)
            pcall(function() sec:Label(text) end)
            return { Set = function() end }
        end
        return C
    end

    function A:Tab(title)
        local ok, sec = pcall(function() return Window:Section(title) end)
        if not ok or not sec then return nil end
        local C = Container(sec)
        return { Section = function(_, name)
            pcall(function() sec:Divider(name) end)
            return C
        end }
    end
    return A
end

function Adapters.Obsidian(lib)
    local Window = lib:CreateWindow({
        Title = HUB_NAME, Footer = HUB_AUTHOR .. " | v" .. HUB_VERSION,
        Center = true, AutoShow = true, Resizable = true, NotifySide = "Right",
        Size = Device.Size,
    })
    local A = { HasOwnKey = false }
    local uid = 0
    function A:Notify(title, content, dur)
        pcall(function() lib:Notify({ Title = title, Description = content, Time = dur or 5 }) end)
    end
    function A:Tag() end
    function A:SetTheme() end
    function A:Themes() return { "Default" } end
    function A:SetScale(s) pcall(function() lib:SetDPIScale(s * 100) end) end
    function A:SetKey() end
    function A:Toggle() pcall(function() lib:Toggle() end) end
    function A:Finish()
        if Config.UIScale ~= 100 then self:SetScale(Config.UIScale / 100) end
    end
    function A:Destroy() pcall(function() lib:Unload() end) end

    local function Container(box)
        local C = {}
        function C:Toggle(o)
            uid += 1
            local e = box:AddToggle("sm" .. uid, { Text = o.Text, Tooltip = o.Desc, Default = o.Default or false, Callback = o.Callback })
            return { Set = function(_, v) pcall(function() e:SetValue(v) end) end }
        end
        function C:Button(o)
            box:AddButton({ Text = o.Text, Tooltip = o.Desc, Func = o.Callback or function() end })
        end
        function C:Slider(o)
            uid += 1
            box:AddSlider("sm" .. uid, { Text = o.Text, Default = o.Default, Min = o.Min, Max = o.Max, Rounding = (o.Step or 1) < 1 and 1 or 0, Callback = o.Callback })
        end
        function C:Dropdown(o)
            uid += 1
            local def = 1
            for k, v in ipairs(o.Values) do if v == o.Default then def = k break end end
            local e = box:AddDropdown("sm" .. uid, { Values = o.Values, Default = def, Text = o.Text, Callback = o.Callback })
            return { Refresh = function(_, vals) pcall(function() e:SetValues(vals) end) end }
        end
        function C:Input(o)
            uid += 1
            box:AddInput("sm" .. uid, { Text = o.Text, Default = o.Default or "", Placeholder = o.Placeholder or "", Finished = true, Callback = o.Callback })
        end
        function C:MultiDropdown(o)
            uid += 1
            box:AddDropdown("sm" .. uid, {
                Text = o.Text, Values = o.Values, Default = SetToList(o.Default),
                Multi = true, AllowNull = true,
                Callback = function(v) if o.Callback then o.Callback(ToSet(v)) end end,
            })
        end
        function C:Label(text)
            local e = box:AddLabel(text, true)
            return { Set = function(_, v) pcall(function() e:SetText(tostring(v)) end) end }
        end
        return C
    end

    function A:Tab(title, icon)
        local t = Window:AddTab(title, icon or "square")
        if not t then return nil end
        local left = true
        return { Section = function(_, name)
            local box = left and t:AddLeftGroupbox(name) or t:AddRightGroupbox(name)
            left = not left
            return Container(box)
        end }
    end
    return A
end

function Adapters.Rayfield(lib)
    local Window = lib:CreateWindow({
        Name = HUB_NAME .. " " .. HUB_AUTHOR,
        LoadingTitle = HUB_NAME, LoadingSubtitle = HUB_AUTHOR,
        ConfigurationSaving = { Enabled = false },
        Discord = { Enabled = false }, KeySystem = false,
    })
    local A = { HasOwnKey = false }
    function A:Notify(title, content, dur)
        pcall(function() lib:Notify({ Title = title, Content = content, Duration = dur or 5 }) end)
    end
    function A:Tag() end
    function A:SetTheme() end
    function A:Themes() return { "Default" } end
    function A:SetScale() end
    function A:SetKey() end
    function A:Toggle()
        pcall(function() lib:SetVisibility(not lib:IsVisible()) end)
    end
    function A:Finish() end
    function A:Destroy() pcall(function() lib:Destroy() end) end

    local function Container(tab)
        local C = {}
        function C:Toggle(o)
            local e = tab:CreateToggle({ Name = o.Text, CurrentValue = o.Default or false, Callback = o.Callback })
            return { Set = function(_, v) pcall(function() e:Set(v) end) end }
        end
        function C:Button(o) tab:CreateButton({ Name = o.Text, Callback = o.Callback or function() end }) end
        function C:Slider(o)
            tab:CreateSlider({ Name = o.Text, Range = { o.Min, o.Max }, Increment = o.Step or 1, CurrentValue = o.Default, Suffix = "", Callback = o.Callback })
        end
        function C:Dropdown(o)
            local e = tab:CreateDropdown({
                Name = o.Text, Options = o.Values, CurrentOption = { o.Default }, MultipleOptions = false,
                Callback = function(v)
                    if type(v) == "table" then v = v[1] end
                    if o.Callback then o.Callback(v) end
                end,
            })
            return { Refresh = function(_, vals) pcall(function() e:Refresh(vals) end) end }
        end
        function C:Input(o)
            tab:CreateInput({ Name = o.Text, PlaceholderText = o.Placeholder or "", RemoveTextAfterFocusLost = false, Callback = o.Callback })
        end
        function C:MultiDropdown(o)
            tab:CreateDropdown({
                Name = o.Text, Options = o.Values, CurrentOption = SetToList(o.Default), MultipleOptions = true,
                Callback = function(v) if o.Callback then o.Callback(ToSet(v)) end end,
            })
        end
        function C:Label(text)
            local ok, e = pcall(function() return tab:CreateLabel(text) end)
            if ok and e then return { Set = function(_, v) pcall(function() e:Set(tostring(v)) end) end } end
            return { Set = function() end }
        end
        return C
    end

    function A:Tab(title)
        local t = Window:CreateTab(title, 4483362458)
        if not t then return nil end
        local C = Container(t)
        return { Section = function(_, name)
            pcall(function() t:CreateSection(name) end)
            return C
        end }
    end
    return A
end

function Adapters.Fluent(lib)
    local Window = lib:CreateWindow({
        Title = HUB_NAME, SubTitle = HUB_AUTHOR, TabWidth = 150,
        Size = Device.Size, Acrylic = not IsTouch, Theme = "Dark",
        MinimizeKey = KeyFromName(Config.ToggleKey),
    })
    local A = { HasOwnKey = true }
    local uid = 0
    function A:Notify(title, content, dur)
        pcall(function() lib:Notify({ Title = title, Content = content, Duration = dur or 5 }) end)
    end
    function A:Tag() end
    function A:SetTheme() end
    function A:Themes() return { "Dark" } end
    function A:SetScale() end
    function A:SetKey() end
    function A:Toggle() pcall(function() Window:Minimize() end) end
    function A:Finish() pcall(function() Window:SelectTab(1) end) end
    function A:Destroy() pcall(function() lib:Destroy() end) end

    local function Container(obj)
        local C = {}
        function C:Toggle(o)
            uid += 1
            local e = obj:AddToggle("sm" .. uid, { Title = o.Text, Description = o.Desc, Default = o.Default or false, Callback = o.Callback })
            return { Set = function(_, v) pcall(function() e:SetValue(v) end) end }
        end
        function C:Button(o)
            obj:AddButton({ Title = o.Text, Description = o.Desc, Callback = o.Callback or function() end })
        end
        function C:Slider(o)
            uid += 1
            obj:AddSlider("sm" .. uid, { Title = o.Text, Default = o.Default, Min = o.Min, Max = o.Max, Rounding = (o.Step or 1) < 1 and 1 or 0, Callback = o.Callback })
        end
        function C:Dropdown(o)
            uid += 1
            local e = obj:AddDropdown("sm" .. uid, { Title = o.Text, Values = o.Values, Default = o.Default, Multi = false, Callback = o.Callback })
            return { Refresh = function(_, vals) pcall(function() e:SetValues(vals) end) end }
        end
        function C:Input(o)
            uid += 1
            obj:AddInput("sm" .. uid, { Title = o.Text, Default = o.Default or "", Placeholder = o.Placeholder or "", Finished = true, Callback = o.Callback })
        end
        function C:MultiDropdown(o)
            uid += 1
            obj:AddDropdown("sm" .. uid, {
                Title = o.Text, Values = o.Values, Default = SetToList(o.Default), Multi = true,
                Callback = function(v) if o.Callback then o.Callback(ToSet(v)) end end,
            })
        end
        function C:Label(text)
            local ok, p = pcall(function() return obj:AddParagraph({ Title = text, Content = "" }) end)
            if ok and p then
                return { Set = function(_, v)
                    pcall(function()
                        if p.SetTitle then p:SetTitle(tostring(v)) else p:SetDesc(tostring(v)) end
                    end)
                end }
            end
            return { Set = function() end }
        end
        return C
    end

    function A:Tab(title, icon)
        local t = Window:AddTab({ Title = title, Icon = icon })
        if not t then return nil end
        return { Section = function(_, name)
            local ok, sec = pcall(function() return t:AddSection(name) end)
            return Container((ok and sec) or t)
        end }
    end
    return A
end

--=========================================================--
--  DOORS CORE
--=========================================================--

DOORS_HOTEL = 6839171747
FINAL_DOOR = 100

function Char() return LocalPlayer.Character end
function HRP()
    local c = Char()
    return c and c:FindFirstChild("HumanoidRootPart")
end
function Hum()
    local c = Char()
    return c and c:FindFirstChildOfClass("Humanoid")
end
function Alive()
    local h = Hum()
    return h ~= nil and h.Health > 0
end

-- Glitch / Void can temporarily remove or replace the character while the
-- player is still alive. A missing Humanoid is therefore not a death.
function FarmPlayerDead()
    if LocalPlayer:GetAttribute("Alive") == false then return true end
    local c = Char()
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health <= 0
end

function CharacterReady()
    local c, h, root = Char(), Hum(), HRP()
    return c ~= nil and c.Parent ~= nil and h ~= nil and h.Health > 0 and root ~= nil
end

function Rooms() return Workspace:FindFirstChild("CurrentRooms") end

-- Current floor (Hotel / Mines / Backdoor / Rooms / ...) -----------------
function CurrentFloor()
    local gd = ReplicatedStorage:FindFirstChild("GameData")
    local f = gd and gd:FindFirstChild("Floor")
    return (f and tostring(f.Value)) or "Unknown"
end

function RemoteFolder()
    return ReplicatedStorage:FindFirstChild("RemotesFolder")
        or ReplicatedStorage:FindFirstChild("EntityInfo")
        or ReplicatedStorage:FindFirstChild("Bricks")
end

function MaxRoom()
    local r = Rooms()
    if not r then return nil, 0 end
    local best, num = nil, -1
    for _, room in ipairs(r:GetChildren()) do
        local n = tonumber(room.Name)
        if n and n > num then best, num = room, n end
    end
    return best, math.max(num, 0)
end

-- the room the player is in right now (its Door is the next door)
function CurrentRoom()
    local gd = ReplicatedStorage:FindFirstChild("GameData")
    local lr = gd and gd:FindFirstChild("LatestRoom")
    local r = Rooms()
    if lr and r then
        local n = tonumber(lr.Value) or 0
        local room = r:FindFirstChild(tostring(n))
        if room then return room, n end
        return nil, n
    end
    return MaxRoom()
end

function PartPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart.Position end
        local ok, cf = pcall(function() return inst:GetBoundingBox() end)
        if ok and cf then return cf.Position end
        local p = inst:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.Position end
    end
    if inst:IsA("ProximityPrompt") then return PartPos(inst.Parent) end
    return nil
end

-- A prompt is "unsafe" when using it would hide you, take you through a rift
-- or touch the library padlock. This used to match pieces of words anywhere
-- in the full path ("bed", "locker", "hide" ...), which also blocked normal
-- loot (item lockers, drawers in bedrooms ...) - so auto loot did nothing.
-- Now only the prompt's own name and the actual hiding-spot models count.
UNSAFE_PROMPT_NAMES = { HidePrompt = true, HidingPrompt = true, RiftPrompt = true, StarRiftPrompt = true }
UNSAFE_ANCESTORS = {
    Wardrobe = true, Backdoor_Wardrobe = true, Toolshed = true, RetroWardrobe = true, ["Wardrobe-FOOLS26"] = true,
    Locker_Large = true, Rooms_Locker = true, Rooms_Locker_Fridge = true, Bed = true, Double_Bed = true,
    CircularVent = true, Dumpster = true, Padlock = true,
}
function IsSafePrompt(prompt)
    if UNSAFE_PROMPT_NAMES[prompt.Name] then return false end
    local node = prompt.Parent
    local depth = 0
    while node and node ~= Workspace and depth < 8 do
        if UNSAFE_ANCESTORS[node.Name] then return false end
        local lower = string.lower(node.Name)
        if string.find(lower, "hidingspot", 1, true) or string.find(lower, "hiding_spot", 1, true) then return false end
        node = node.Parent
        depth += 1
    end
    return true
end

-- Fallback for executors without fireproximityprompt: the prompt is moved onto
-- a tiny invisible part right in front of the camera (so it is shown), then
-- held and released until the game reports it was triggered. Everything
-- (parent, distance, hold time, line of sight) is put back afterwards.
PromptQueue, PromptBusy = {}, setmetatable({}, { __mode = "k" })
function QueuePrompt(prompt)
    if PromptBusy[prompt] then return end
    for _, p in ipairs(PromptQueue) do if p == prompt then return end end
    table.insert(PromptQueue, prompt)
end
task.spawn(function()
    while HubAlive do
        local prompt = table.remove(PromptQueue, 1)
        local cam = Workspace.CurrentCamera
        if prompt and prompt.Parent and cam then
            PromptBusy[prompt] = true
            local old = {
                Parent = prompt.Parent, Dist = prompt.MaxActivationDistance, Enabled = prompt.Enabled,
                Hold = prompt.HoldDuration, LOS = prompt.RequiresLineOfSight,
            }
            local holder = Instance.new("Part")
            holder.Name = "Sm1lerHub_Prompt"
            holder.Anchored, holder.CanCollide, holder.CanQuery, holder.CanTouch = true, false, false, false
            holder.Transparency = 1
            holder.Size = Vector3.new(0.001, 0.001, 0.001)
            holder.CFrame = cam.CFrame * CFrame.new(0, 0, -0.1)
            holder.Parent = Workspace
            local shown, fired = false, false
            local c1 = ProximityPromptService.PromptShown:Connect(function(p) if p == prompt then shown = true end end)
            local c2 = prompt.Triggered:Connect(function() fired = true end)
            pcall(function()
                prompt.MaxActivationDistance = 99999
                prompt.Enabled = true
                prompt.HoldDuration = 0
                prompt.RequiresLineOfSight = false
                prompt.Parent = holder
            end)
            for _ = 1, 5 do if shown then break end task.wait() end
            for _ = 1, 5 do
                if fired then break end
                pcall(function() prompt:InputHoldBegin(); prompt:InputHoldEnd() end)
                task.wait()
            end
            pcall(function()
                prompt.MaxActivationDistance = old.Dist
                prompt.Enabled = old.Enabled
                prompt.HoldDuration = old.Hold
                prompt.RequiresLineOfSight = old.LOS
                prompt.Parent = old.Parent
            end)
            c1:Disconnect()
            c2:Disconnect()
            holder:Destroy()
            task.wait()
            PromptBusy[prompt] = nil
        else
            task.wait()
        end
    end
end)

function FirePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    if not fireproximityprompt then
        QueuePrompt(prompt)
        return true
    end
    -- force-enable: gold piles / many DOORS prompts are not Enabled the moment
    -- we fire them (the game enables them on proximity server-side), so a strict
    -- Enabled check made auto-loot silently do nothing
    local oldHold, oldDist, oldLOS, oldEn = prompt.HoldDuration, prompt.MaxActivationDistance, prompt.RequiresLineOfSight, prompt.Enabled
    pcall(function()
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = math.max(oldDist, 20)
        prompt.RequiresLineOfSight = false
        if not prompt.Enabled then prompt.Enabled = true end
    end)
    local fired = pcall(fireproximityprompt, prompt)
    if not fired then
        QueuePrompt(prompt)
    end
    task.delay(0.25, function()
        pcall(function()
            if prompt.Parent then
                prompt.HoldDuration = oldHold
                prompt.MaxActivationDistance = oldDist
                prompt.RequiresLineOfSight = oldLOS
                if not oldEn then prompt.Enabled = false end
            end
        end)
    end)
    return true
end

-- movement ----------------------------------------------------------------
function RawTP(pos)
    local hrp = HRP()
    if not hrp or not pos then return false end
    local sunk = (S.PositionSpoof or S.GodMode) and -2.346 or 0
    pcall(function()
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3 + sunk, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

-- Farm state is declared EARLY because MoveTo (below) checks Farm.Running while
-- walking. Declaring it later made MoveTo index a nil global and the walk loop
-- crashed on every call (character froze / snapped back).
Farm = { Running = false, Start = 0 }
SteppedAbort = nil -- set by the auto farm (declared here, assigned later)
FarmPathMove, ClearFarmPath = nil -- assigned in the Auto Farm section
function SteppedTP(pos)
    local hrp = HRP()
    if not hrp or not pos then return false end
    local sunk = (S.PositionSpoof or S.GodMode) and -2.346 or 0
    local target = pos + Vector3.new(0, 3 + sunk, 0)
    if (target - hrp.Position).Magnitude < 6 then return true end
    local speed = math.clamp(S.TPSpeed or 90, 20, 400)
    local dt = 0.05
    local stepLen = speed * dt
    local guard = 0
    while HubAlive and Alive() do
        local h = HRP()
        if not h then return false end
        -- a Rush-like entity appeared while travelling: stop, so the auto farm
        -- can hide straight away instead of finishing a long trip first
        if SteppedAbort and SteppedAbort() then return false end
        local delta = target - h.Position
        local dist = delta.Magnitude
        if dist <= stepLen then break end
        pcall(function()
            h.CFrame = CFrame.new(h.Position + delta.Unit * stepLen)
            h.AssemblyLinearVelocity = Vector3.zero
        end)
        guard += 1
        if guard > 600 then break end
        task.wait(dt)
    end
    return RawTP(pos)
end

function WalkTo(pos)
    local hum, hrp = Hum(), HRP()
    if not hum or not hrp or not pos then return false end
    local flat = Vector3.new(1, 0, 1)
    local limit = math.max(3, ((pos - hrp.Position) * flat).Magnitude / 12)
    local t0 = tick()
    while HubAlive and Alive() do
        hum:MoveTo(pos)
        local h = HRP()
        if not h then return false end
        if ((pos - h.Position) * flat).Magnitude < 4 then return true end
        if tick() - t0 > limit then break end
        task.wait(0.1)
    end
    return SteppedTP(pos) -- stuck: finish with a stepped teleport
end

function MoveTo(pos)
    if not pos then return false end
    if S.MoveMode == "Teleport" then return RawTP(pos) end
    if S.MoveMode == "Walk" then
        if Farm.Running and FarmPathMove then return FarmPathMove(pos) end
        return WalkTo(pos)
    end
    return SteppedTP(pos)
end

-- object finders ----------------------------------------------------------
function FindDoor(room)
    return room and room:FindFirstChild("Door") or nil
end

function DoorPosition(room)
    local door = FindDoor(room)
    if not door then return nil end
    local inner = door:FindFirstChild("Door")
    if inner and inner:IsA("BasePart") then return inner.Position end
    local lock = door:FindFirstChild("Lock")
    local lp = PartPos(lock)
    if lp then return lp end
    return PartPos(door)
end

function DoorIsLocked(room)
    local door = FindDoor(room)
    if not door then return false end
    local lock = door:FindFirstChild("Lock")
    if not lock then return false end
    local prompt = lock:FindFirstChildWhichIsA("ProximityPrompt", true) or door:FindFirstChild("UnlockPrompt", true)
    return prompt == nil or prompt.Enabled
end

function OpenDoor(room)
    local door = FindDoor(room)
    if not door then return end
    local unlock = door:FindFirstChild("UnlockPrompt", true)
    if unlock and unlock.Enabled then FirePrompt(unlock) end
    local co = door:FindFirstChild("ClientOpen")
    if co and co:IsA("RemoteEvent") then pcall(function() co:FireServer() end) end
end

function FindKey(room)
    return room and room:FindFirstChild("KeyObtain", true) or nil
end

function HasKey()
    local c = Char()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    return (c and c:FindFirstChild("Key")) or (bp and bp:FindFirstChild("Key"))
end

-- do you hold (or carry) this item?
function HasItem(name, held)
    local c = Char()
    if c and c:FindFirstChild(name) then return true end
    if held then return false end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    return bp ~= nil and bp:FindFirstChild(name) ~= nil
end

-- is this a lock / vine / skull prompt that needs a tool?
LOCK_PROMPTS = { UnlockPrompt = true, SkullPrompt = true, LockPrompt = true, ThingToEnable = true, FusesPrompt = true }
function IsLockPrompt(p)
    return LOCK_PROMPTS[p.Name]
        or (p.Parent and p.Parent:GetAttribute("Locked") == true)
        or (p.Name == "ActivateEventPrompt" and p.Parent and p.Parent.Parent and p.Parent.Parent.Name == "Locker_Small_Locked")
end
-- auto interact only uses a lock / vine / skull prompt when you have the item for it
function CanUsePrompt(p)
    local parent = p.Parent and p.Parent.Name or ""
    local shears = HasItem("Shears", true) or HasItem("Multitool", true)
    if parent == "CuttableVines" or parent == "Chest_Vine" or parent == "Cellar" then return shears end
    if parent == "SkullLock" then return HasItem("SkeletonKey", true) end
    if parent == "Lock1" or parent == "Lock2" then return HasItem("Lockpick", true) or HasItem("Multitool", true) end
    if IsLockPrompt(p) then
        if HasItem("Shears", true) then return false end
        for _, k in ipairs({ "Key", "GeneratorFuse", "KeyBackdoor", "KeyElectrical", "KeyIron", "Lockpick", "SkeletonKey", "Multitool" }) do
            if HasItem(k, true) then return true end
        end
        for _, k in ipairs({ "Key", "GeneratorFuse", "KeyElectrical", "KeyIron" }) do
            if HasItem(k) then return true end
        end
        return false
    end
    return true
end

function FindLever(room)
    if not room then return nil end
    return room:FindFirstChild("LeverForGate", true) or room:FindFirstChild("Lever", true)
end

function SendCaption(text)
    local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
    if not rf then return end
    pcall(function()
        local cap = rf:FindFirstChild("Caption")
        if firesignal and cap then
            firesignal(cap.OnClientEvent, "[" .. HUB_NAME .. "] " .. text)
        elseif rf:FindFirstChild("CaptionClient") then
            rf.CaptionClient:Fire("[" .. HUB_NAME .. "] " .. text)
        end
    end)
end

function SkipIntro()
    local skip = Workspace:FindFirstChild("SkipPrompt", true)
    if skip then FirePrompt(skip) end
    pcall(function()
        local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local main = gui and gui:FindFirstChild("MainUI")
        local shop = main and main:FindFirstChild("ItemShop")
        if shop and shop.Visible then
            shop.Visible = false
            local rf = ReplicatedStorage:FindFirstChild("RemotesFolder")
            if rf and rf:FindFirstChild("PreRunShop") then rf.PreRunShop:FireServer({}, true) end
        end
    end)
end

