-- mirror the extra systems into the Extra table used by the loops
Extra = {
    AntiScribbles = S.AntiScribbles, AntiDrones = S.AntiDrones, Honcho = S.Honcho,
    ForgetMeNot = S.ForgetMeNot, InfCrucifix = S.InfCrucifix, CustomCursor = S.CustomCursor,
