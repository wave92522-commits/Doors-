end)

-- Remove cutscenes / jumpscares: the game plays them from ModuleScripts
-- (MainUI.Initiator.Main_Game.RemoteListener and ReplicatedStorage.FloorReplicated).
-- A disabled module is renamed "<Name>_Disabled" so the game cannot find it,
-- and gets its real name back when the option is turned off.
CUTSCENES = {
    Figure = true, FigureEnd = true, FigureHotelEnd = true, FigureHotelFire = true,
    SeekIntroFools = true, SeekIntroHotel = true, SeekIntroMines = true, SeekIntroMines2 = true,
    SerewSeekDrain = true, SewerSeekLower = true, GrumbleNestEnd = true, EyestalkIntro = true,
}
JUMPSCARE_MODULES = { NoGlitchScare = "Glitch", NoTimothyScare = "SpiderJumpscare", NoVoidScare = "Void" }

function RealName(mod)
    local orig = mod:GetAttribute("Sm1lerOriginalName")
    if orig then return orig end
    return (string.gsub(mod.Name, "_Disabled$", ""))
end

function SetModuleDisabled(mod, disabled)
    local orig = RealName(mod)
    if mod:GetAttribute("Sm1lerOriginalName") == nil then mod:SetAttribute("Sm1lerOriginalName", orig) end
    local want = disabled and (orig .. "_Disabled") or orig
    if mod.Name ~= want then mod.Name = want end
end

function RemoteListener()
    local main = MainUI()
    local init = main and main:FindFirstChild("Initiator")
    local game_ = init and init:FindFirstChild("Main_Game")
    return game_ and game_:FindFirstChild("RemoteListener")
end

function ApplyModuleToggles()
    local listener = RemoteListener()
    local containers = {}
    if listener then
        table.insert(containers, listener:FindFirstChild("Cutscenes"))
        table.insert(containers, listener)
    end
    table.insert(containers, ReplicatedStorage:FindFirstChild("FloorReplicated"))
    for _, folder in ipairs(containers) do
        if folder then
            for _, mod in ipairs(folder:GetChildren()) do
                if mod:IsA("ModuleScript") then
                    local name = RealName(mod)
                    if CUTSCENES[name] then SetModuleDisabled(mod, S.SkipCutscenes) end
                    for key, modName in pairs(JUMPSCARE_MODULES) do
                        if name == modName then SetModuleDisabled(mod, S[key]) end
                    end
                end
            end
        end
    end
    -- the floor's own modules: Glitch Screech (Remove Screech) and the entity
    -- jumpscares (except Eyestalk / Groundskeeper / Monument, which are needed)
    local floorRep = ReplicatedStorage:FindFirstChild("FloorReplicated")
    if floorRep then
        for _, mod in ipairs(floorRep:GetDescendants()) do
            if mod:IsA("ModuleScript") then
                local name = RealName(mod)
                if name == "GlitchScreech" then
                    SetModuleDisabled(mod, S.RemoveScreech)
                elseif string.find(name, "Jumpscare", 1, true) and not string.find(name, "Eyestalk", 1, true)
                    and not string.find(name, "Groundskeeper", 1, true) and not string.find(name, "Monument", 1, true) then
                    SetModuleDisabled(mod, S.NoEntityScares)
                end
            end
        end
    end
    -- Rush / Ambush style entity jumpscares live in RemoteListener.Jumpscares
    if listener then
        local scares = listener:FindFirstChild("Jumpscares") or listener:FindFirstChild("Jumpscares_Disabled")
        if scares then
            local want = S.NoEntityScares and "Jumpscares_Disabled" or "Jumpscares"
            if scares.Name ~= want then scares.Name = want end
        end
    end
end
Loop(1, ApplyModuleToggles)

-- Hide vignette: the dark overlay while you are hiding
VignetteImage = nil
Loop(0.5, function()
    local main = MainUI()
    if not main then return end
    local vig = main:FindFirstChild("HideVignette") or (main:FindFirstChild("MainFrame") and main.MainFrame:FindFirstChild("HideVignette"))
    if not vig or not vig:IsA("ImageLabel") then return end
    if S.NoHideVignette then
        if VignetteImage == nil and vig.Image ~= "" then VignetteImage = vig.Image end
        vig.Image = ""
    elseif VignetteImage then
        vig.Image = VignetteImage
        VignetteImage = nil
    end
end)

-- Firedamp: the gas screen effect in the Mines
Loop(1, function()
    if not S.NoFiredamp then return end
    local r = Rooms()
    if r then
        for _, room in ipairs(r:GetChildren()) do
            if room:GetAttribute("Firedamp") == true then
                if room:GetAttribute("Sm1lerFiredamp") == nil then room:SetAttribute("Sm1lerFiredamp", true) end
                room:SetAttribute("Firedamp", false)
            end
        end
    end
    local cam = Workspace.CurrentCamera
    if cam then
        for _, fx in ipairs(cam:GetChildren()) do
            if fx.Name == "LiveFiredamp" then pcall(function() fx:Destroy() end) end
        end
    end
end)
function RestoreFiredamp()
    local r = Rooms()
    if not r then return end
    for _, room in ipairs(r:GetChildren()) do
        if room:GetAttribute("Sm1lerFiredamp") then
            room:SetAttribute("Firedamp", true)
            room:SetAttribute("Sm1lerFiredamp", nil)
        end
    end
end

-- Transparent hiding spots: the closet / bed you are hiding in turns see-through
HideTransparency = setmetatable({}, { __mode = "k" })
Loop(0.25, function()
    local c = Char()
    local inside = nil
    if S.SeeThroughHiding and c then
        local r = Rooms()
        local _, n = CurrentRoom()
        for i = n - 1, n + 1 do
            local room = r and r:FindFirstChild(tostring(i))
            if room then
                for _, d in ipairs(room:GetDescendants()) do
                    if d.Name == "HiddenPlayer" and d:IsA("ObjectValue") and d.Value == c then
                        inside = d:FindFirstAncestorWhichIsA("Model")
                        break
                    end
                end
            end
            if inside then break end
        end
    end
    for part, old in pairs(HideTransparency) do
        if not inside or not part:IsDescendantOf(inside) then
            if part.Parent then pcall(function() part.Transparency = old end) end
            HideTransparency[part] = nil
        end
    end
    if inside then
        local want = math.clamp((tonumber(S.HideTransparency) or 50) / 100, 0, 1)
        for _, p in ipairs(inside:GetDescendants()) do
            if p:IsA("BasePart") then
                if HideTransparency[p] == nil then HideTransparency[p] = p.Transparency end
                p.Transparency = math.max(HideTransparency[p], want)
            end
        end
    end
end)

-- Third person: the camera moves by the X / Y / Z offset; with Wall check a
-- small sphere is cast so the camera stops in front of walls. Your head and
-- accessories (hidden in first person) are shown while it is on.
ThirdRay = RaycastParams.new()
ThirdRay.FilterType = Enum.RaycastFilterType.Exclude
ThirdShown = setmetatable({}, { __mode = "k" }) -- part -> { T, L }
function RestoreThirdParts()
    for p, old in pairs(ThirdShown) do
        if p.Parent then
            pcall(function()
                p.Transparency = old.T
                p.LocalTransparencyModifier = old.L
            end)
        end
        ThirdShown[p] = nil
    end
end
Connect(RunService.RenderStepped, function()
    if not S.ThirdPerson then
        if next(ThirdShown) then RestoreThirdParts() end
        return
    end
    local cam, c = Workspace.CurrentCamera, Char()
    if not cam or not c then return end
    local offset = CFrame.new(tonumber(S.TPX) or 1.5, tonumber(S.TPY) or 1, tonumber(S.TPZ) or 5)
    local dir = (cam.CFrame * offset).Position - cam.CFrame.Position
    local hit
    if S.TPWallCheck and dir.Magnitude > 0.01 then
        ThirdRay.FilterDescendantsInstances = { c }
        hit = Workspace:Spherecast(cam.CFrame.Position, 0.2, dir, ThirdRay)
    end
    if hit and hit.Instance.CanCollide then
        local pos = cam.CFrame.Position + dir.Unit * hit.Distance
        cam.CFrame = CFrame.new(pos, pos + cam.CFrame.LookVector)
    else
        cam.CFrame = cam.CFrame * offset
    end
    local parts = {}
    local head = c:FindFirstChild("Head")
    if head then table.insert(parts, head) end
    for _, acc in ipairs(c:GetChildren()) do
        local handle = acc:IsA("Accessory") and acc:FindFirstChild("Handle")
        if handle then table.insert(parts, handle) end
    end
    for _, p in ipairs(parts) do
        if not ThirdShown[p] then ThirdShown[p] = { T = p.Transparency, L = p.LocalTransparencyModifier } end
        p.Transparency = 0
        p.LocalTransparencyModifier = 0
    end
end)

-- Camera shake / bobbing / viewmodel offset: these need the game's own
-- camera module (require), so they only work on executors that support it
MainGameModule = nil
function GetMainGame()
    if MainGameModule then return MainGameModule end
    if not require then return nil end
    local main = MainUI()
    local mod = main and main:FindFirstChild("Initiator") and main.Initiator:FindFirstChild("Main_Game")
    if mod and mod:IsA("ModuleScript") then
        local ok, res = pcall(require, mod)
        if ok and type(res) == "table" then MainGameModule = res end
    end
    return MainGameModule
end
BobBackup, ShakeBackup = nil
Loop(0.5, function()
    local mg = GetMainGame()
    if not mg then return end
    pcall(function()
        if mg.spring then
            if S.NoBobbing then
                if BobBackup == nil then BobBackup = mg.spring.Speed end
                mg.spring.Speed = 9e9
            elseif BobBackup ~= nil then
                mg.spring.Speed = BobBackup
                BobBackup = nil
            end
        end
    end)
end)

-- camera shake + viewmodel offset run every frame through the game's camera
-- module: csgo = shake offset, tooloffset = where the held item sits
ToolOffsetSet = false
Connect(RunService.RenderStepped, function()
    local mg = MainGameModule
    -- Custom FOV: the game eases the camera toward its own "fovtarget", so that
    -- is what gets changed (plain FieldOfView only without require)
    if S.CustomFOV and S.FOV then
        if mg and mg.fovtarget ~= nil then
            pcall(function() mg.fovtarget = S.FOV end)
        else
            local cam = Workspace.CurrentCamera
            if cam then cam.FieldOfView = S.FOV end
        end
    end
    if not mg then return end
    if S.NoShake then pcall(function() mg.csgo = CFrame.new() end) end
    if S.ViewmodelOffset then
        pcall(function()
            mg.tooloffset = Vector3.new(tonumber(S.VMX) or 0, tonumber(S.VMY) or 0, tonumber(S.VMZ) or 0)
        end)
        ToolOffsetSet = true
    elseif ToolOffsetSet then
        pcall(function() mg.tooloffset = Vector3.zero end)
        ToolOffsetSet = false
    end
end)
-- the camera module is loaded once the hub starts (and again after respawns)
Loop(2, function() if S.NoShake or S.ViewmodelOffset or S.NoBobbing or S.CustomFOV then GetMainGame() end end)

